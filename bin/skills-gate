#!/usr/bin/env python3
"""skills-gate: one global skill in front of every skill on the machine.

Agents see a single always-on skill, `skills-gate`. It carries a short registry (one lane per category, the skill
names in each). Everything else lives in the bank and is pulled in only when a task needs it:

  skills-gate suggest "<task>"       the banked skills that fit a task, ranked (also runs as a prompt hook)
  skills-gate use <skill>            print a skill's playbook into the session (on demand, recorded)
  skills-gate on <skill> [--global]  link it into this project (or every harness) until it goes stale
  skills-gate tidy                   the daily pass: usage from every harness, stale skills off, cold storage,
                                     references held, registry rebuilt, leaks re-gated, context cost

Python 3.9+, standard library only. Home: ~/.skills-gate (override with SKILLS_GATE_HOME).
Run `skills-gate --help` or `skills-gate <command> --help`.
"""
from __future__ import annotations

import argparse
