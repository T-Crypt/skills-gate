# Lane guesses for skills added without one. Order matters: first match wins.
LANE_RULES = [
    ("security", r"\b(security|exploits?|bounty|hackerone|reverse.engineer\w*|pentest\w*|ctf|malware|vulnerab\w*)\b"),
    ("media", r"(video|motion|caption|film|animation|comfy|image|audio|reel|brand|banner|slideshow|explainer|"
              r"typography|lower.third|infographic|figma)"),
    ("web", r"(\bui\b|\bux\b|frontend|react|next\.?js|css|tailwind|design.system|web.?app|typescript|component)"),
    ("docs", r"(docx|pptx|xlsx|pdf|slides|writing|document|research|report|prose|slop|notes)"),
    ("principles", r"^principle-"),
    ("ops", r"(deploy|server|systemd|gpu|engine|model|infra|sync|backup|homelab|cluster|docker)"),
    ("core", r"(review|debug|bug|test|tdd|spec|ticket|refactor|implement|architect|codebase|verify|plan)"),
]


# ---------------------------------------------------------------------------------------------------- basics

def now() -> int:
    return int(time.time())


def say(*a):
    print(*a, flush=True)


def warn(msg: str):
    print(f"skills-gate: {msg}", file=sys.stderr, flush=True)


def die(msg: str, code: int = 1):
    print(f"skills-gate: {msg}", file=sys.stderr)
    raise SystemExit(code)


def short(text: str, n: int) -> str:
    text = re.sub(r"\s+", " ", text or "").strip()
    return text[: n - 3] + "..." if len(text) > n else text


def day(ts) -> str:
    return time.strftime("%Y-%m-%d", time.localtime(int(ts))) if ts else "never"


def config() -> dict:
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    if CONFIG.is_file():
        user = json.loads(CONFIG.read_text())
        for k, v in user.items():
            if isinstance(v, dict) and isinstance(cfg.get(k), dict):
                cfg[k].update(v)
            else:
                cfg[k] = v
    return cfg


def edit_config(fn):
    """Apply fn to the user's own config.json (not the merged defaults) and write it back."""
    user = json.loads(CONFIG.read_text()) if CONFIG.is_file() else {}
    fn(user)
    HOME.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps(user, indent=2) + "\n")


def harness_dirs(cfg: dict) -> dict[str, Path]:
    out = {}
    for name, p in cfg["harness_dirs"].items():
        if not p:
            continue
        path = Path(p).expanduser()
        if path.is_dir():
            out[name] = path
    return out


def always_on(cfg: dict) -> set[str]:
    return {GATE_NAME, *cfg.get("always_on", [])}


def confirm(question: str, yes: bool) -> bool:
    if yes:
        return True
    if not sys.stdin.isatty():
        die(f"{question} Needs the user's yes: run again with --yes once they agree.")
    return input(f"{question} [y/N] ").strip().lower() in ("y", "yes")


SKILL_COLS = {"keywords": "text not null default ''", "orig_hash": "text not null default ''",
              "ref": "text not null default ''", "risk": "text not null default ''",
              "up_tree": "text not null default ''",  # git tree id of the upstream folder the bank copy came from
              "token_estimate": "integer not null default 0"}


def db(timeout: float = 15) -> sqlite3.Connection:
    HOME.mkdir(parents=True, exist_ok=True)
    c = sqlite3.connect(DB, timeout=timeout)
    c.row_factory = sqlite3.Row
    c.executescript("""
    create table if not exists skills (
        name text primary key, lane text not null default 'general', description text not null default '',
        source text not null default '', link integer not null default 0, hash text not null default '',
        tokens integer not null default 0, pinned integer not null default 0,
        added_at integer not null, last_used integer, uses integer not null default 0);
    create table if not exists toggles (
        skill text not null, scope text not null, path text not null, on_at integer not null,
        primary key (skill, scope));
    create table if not exists events (at integer not null, skill text, kind text not null, detail text);
    create table if not exists meta (key text primary key, value text);
    create table if not exists harvested (ref text primary key, at integer not null);
    create table if not exists refs (skill text not null, path text not null, primary key (skill, path));
    create table if not exists presets (name text not null, skill text not null, primary key (name, skill));
    create table if not exists market_cache (key text primary key, at integer not null, body text not null);
    create table if not exists sync_state (name text primary key, hash text not null);
    create table if not exists net_allow (skill text not null, host text not null, at integer not null,
        by text not null default 'user', primary key (skill, host));
    create table if not exists reviews (name text primary key, hash text not null, at integer not null,
        level text not null default '', egress text not null default '{}', verdict text not null default '',
        notes text not null default '');
    create table if not exists distill (fp text primary key, name text not null, status text not null,
        at integer not null, shapes text not null default '[]');
    create table if not exists update_skip (skill text not null, hash text not null, at integer not null,
        primary key (skill, hash));
    create index if not exists events_skill on events (skill, at);
    """)
    have = {r[1] for r in c.execute("pragma table_info(skills)")}
    for col, decl in SKILL_COLS.items():
        if col not in have:
            c.execute(f"alter table skills add column {col} {decl}")
    migrate(c)
    if meta_get(c, "schema") != "2":
        migrate_v2(c)
    return c


def migrate_v2(c):
    """0.1 -> 0.2: hashes now skip vendored folders, so take a fresh baseline; index the playbook bodies."""
    for r in c.execute("select name from skills").fetchall():
        p = bank_path(r["name"])
        if (p / "SKILL.md").is_file():
            h = tree_hash(p)
            c.execute("update skills set hash=?, orig_hash=?, keywords=? where name=?",
                      (h, h, body_keywords(p / "SKILL.md"), r["name"]))
    meta_set(c, "schema", "2")
    c.commit()


def migrate(c):
    """Idempotent, additive migration: create the Phase 1/2 tables and add token_estimate if missing."""
    c.executescript("""
    create table if not exists tags (
        name text primary key,
        color text not null default '',
        created_at integer not null default 0);
    create table if not exists skill_tags (
        skill text not null,
        tag text not null,
        primary key (skill, tag),
        foreign key (skill) references skills(name) on delete cascade,
        foreign key (tag) references tags(name) on delete cascade);
    create index if not exists skill_tags_tag on skill_tags(tag);
    create table if not exists workspaces (
        id text primary key,
        name text not null default '',
        kind text not null default 'project',
        path text not null,
        agent text,
        created_at integer not null default 0);
    create unique index if not exists workspaces_path on workspaces(path);
    create table if not exists deployments (
        skill text not null,
        agent text not null,
        path text not null default '',
        mode text not null default 'symlink',
        state text not null default 'live',
        created_at integer not null default 0,
        updated_at integer,
        primary key (skill, agent));
    create table if not exists custom_agents (
        key text primary key,
        name text not null default '',
        skills_dir text not null default '',
        project_dir text,
        enabled integer not null default 1,
        created_at integer not null default 0);
    create table if not exists activity_log (
        id integer primary key autoincrement,
        at integer not null,
        kind text not null,
        skill text,
        agent text,
        workspace text,
        detail text not null default '',
        result text not null default '');
    create index if not exists activity_log_at on activity_log(at);
    create table if not exists context_usage (
        id integer primary key autoincrement,
        session_id text,
        harness text,
        skill text,
        tokens integer not null default 0,
        at integer not null);
    create index if not exists context_usage_at on context_usage(at);
    """)
    have = {r[1] for r in c.execute("pragma table_info(skills)")}
    if "token_estimate" not in have:
        c.execute("alter table skills add column token_estimate integer not null default 0")
    c.execute("update skills set token_estimate = tokens "
              "where coalesce(token_estimate, 0) = 0 and coalesce(tokens, 0) > 0")
    c.commit()


def event(c, skill, kind, detail="", at=None):
    c.execute("insert into events values (?,?,?,?)", (at or now(), skill, kind, detail))


def meta_get(c, key, default=None):
    r = c.execute("select value from meta where key=?", (key,)).fetchone()
    return r[0] if r else default


def meta_set(c, key, value):
    c.execute("insert or replace into meta values (?,?)", (key, str(value)))


# ---------------------------------------------------------------------------------------------------- skills

def frontmatter(md: Path) -> dict:
    """name/description from a SKILL.md front matter, without a YAML dependency (single-line or block values)."""
    try:
        text = md.read_text(encoding="utf-8", errors="replace").replace("\r\n", "\n")
    except OSError:
        return {}
    m = re.match(r"^﻿?---\s*\n(.*?)\n---", text, re.S)
    out = {}
    if m:
        lines = m.group(1).splitlines()
        i = 0
        while i < len(lines):
            line = lines[i]
            k, sep, v = line.partition(":")
            i += 1
            if not sep or line.startswith((" ", "\t")):
                continue
            v = v.strip()
            if v in (">", ">-", ">+", "|", "|-", "|+"):  # folded or literal block: gather the indented lines
                block = []
                while i < len(lines) and (lines[i].startswith((" ", "\t")) or not lines[i].strip()):
                    block.append(lines[i].strip())
                    i += 1
                v = (" " if v.startswith(">") else "\n").join(b for b in block if b)
            out[k.strip()] = v.strip('"').strip("'")
    return out


def body_keywords(md: Path) -> str:
    """Headings and the opening of a playbook: what `suggest` matches beyond the description."""
    try:
        text = md.read_text(encoding="utf-8", errors="replace").replace("\r\n", "\n")
    except OSError:
        return ""
    text = re.sub(r"^﻿?---\s*\n.*?\n---\s*\n", "", text, count=1, flags=re.S)
    text = re.sub(r"```.*?```", " ", text, flags=re.S)
    heads = [ln.lstrip("#").strip() for ln in text.splitlines() if ln.startswith("#")]
    opening = re.sub(r"\s+", " ", re.sub(r"^#.*$", "", text, flags=re.M))[:500]
    return short(" ".join(heads) + " " + opening, 1200)


def files_of(path: Path):
    for f in sorted(path.rglob("*")):
        rel = f.relative_to(path)
        if SKIP_PARTS & set(rel.parts) or not f.is_file():
            continue
        yield f, rel


def tree_hash(path: Path, skip=None) -> str:
    h = hashlib.sha256()
    for f, rel in files_of(path):
        if skip and skip(f, rel):
            continue
        h.update(str(rel).encode())
        try:
            h.update(f.read_bytes())
        except OSError:
            pass
    return h.hexdigest()[:16]


def est_tokens(md: Path) -> int:
    try:
        return max(1, len(md.read_text(encoding="utf-8", errors="replace")) // 4)
    except OSError:
        return 0


def guess_lane(name: str, desc: str) -> str:
    text = f"{name} {desc}".lower()
    for lane, rx in LANE_RULES:
        if re.search(rx, name.lower() if lane == "principles" else text):
            return lane
    return "general"


def find_skill_dirs(root: Path, depth: int = 4) -> list[Path]:
    """Directories holding a SKILL.md under root (root itself included), skipping hidden and vendored folders."""
    root = root.expanduser()
    if (root / "SKILL.md").is_file():
        return [root]
    found = []
    for dirpath, dirnames, filenames in os.walk(root, followlinks=True):
        rel = Path(dirpath).relative_to(root)
        dirnames[:] = [d for d in dirnames if not d.startswith(".") and d not in SKIP_PARTS]
        if len(rel.parts) >= depth:
            dirnames[:] = []
        if "SKILL.md" in filenames and Path(dirpath) != root:
            found.append(Path(dirpath))
            dirnames[:] = []
    return found


def bank_path(name: str) -> Path:
    return BANK / name


def in_bank(name: str) -> bool:
    p = bank_path(name)
    return p.exists() or p.is_symlink()


def keep_copy(name: str, tag: str, row=None) -> Path:
    """Copy a bank skill to cold/<name>.<tag>-<time> before it is replaced (unique even within one second). With the
    registry row, cold/<copy>.origin.json records where that copy came from, so `rollback` can restore it whole."""
    COLD.mkdir(parents=True, exist_ok=True)
    base = COLD / f"{name}.{tag}-{time.strftime('%Y%m%d-%H%M%S')}"
    dst, i = base, 1
    while dst.exists() or dst.is_symlink() or Path(f"{dst}.origin.json").exists():
        dst, i = Path(f"{base}-{i}"), i + 1
    shutil.copytree(bank_path(name), dst, symlinks=True)
    if row is not None:
        Path(f"{dst}.origin.json").write_text(json.dumps(
            {k: row[k] for k in ("source", "ref", "up_tree", "orig_hash", "lane")} | {"at": now()}, indent=1))
    return dst


def rm(p: Path):
    if p.is_dir() and not p.is_symlink():
        shutil.rmtree(p)
    elif p.exists() or p.is_symlink():
        p.unlink()


def register(c, src: Path, lane: str | None = None, link: bool = False, source: str = "", force: bool = False,
             name: str | None = None, ref: str = "", kind: str = "add", meta: dict | None = None,
             up_tree: str = "") -> str | None:
    """Put one skill dir into the bank (copy, or a symlink to its source with link=True) and the registry."""
    fm = frontmatter(src / "SKILL.md")
    name = name or fm.get("name") or src.name
    if not NAME_RX.match(name):
        say(f"[skip]  {src}: unusable skill name {name!r}")
        return None
    if name == GATE_NAME:
        return None
    dst = bank_path(name)
    if in_bank(name):
        if not force:
            say(f"[have]  {name} (already in the bank; --force replaces it)")
            return name
        rm(dst)
    BANK.mkdir(parents=True, exist_ok=True)
    if link:
        dst.symlink_to(src.resolve())
    else:
        shutil.copytree(src, dst, symlinks=False, ignore=IGNORE)
    desc = fm.get("description", "")
    row = c.execute("select lane, pinned, added_at, last_used, uses from skills where name=?", (name,)).fetchone()
    meta = meta or {}
    lane = lane or meta.get("lane") or (row["lane"] if row else None) or guess_lane(name, desc)
    pinned = meta.get("pinned", row["pinned"] if row else 0)
    h = tree_hash(dst)
    risk = scan_level(scan_tree(dst))
    c.execute("insert or replace into skills (name, lane, description, source, link, hash, tokens, pinned, added_at,"
              " last_used, uses, keywords, orig_hash, ref, risk, up_tree) values (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
              (name, lane, desc, source or str(src), int(link), h, est_tokens(dst / "SKILL.md"), int(pinned),
               row["added_at"] if row else now(), row["last_used"] if row else None, row["uses"] if row else 0,
               body_keywords(dst / "SKILL.md"), h, ref, risk, "" if link else up_tree or meta.get("up_tree", "")))
    event(c, name, kind, source or str(src))
    say(f"[{kind:<5}] {name}  lane={lane}{'  (linked)' if link else ''}{f'  risk={risk}' if risk else ''}")
    return name


def get(c, name: str) -> sqlite3.Row:
    r = c.execute("select * from skills where name=?", (name,)).fetchone()
    if not r:
        hint = c.execute("select name from skills where name like ? limit 5", (f"%{name}%",)).fetchall()
        die(f"no skill {name!r} in the bank" + (f" (close: {', '.join(x[0] for x in hint)})" if hint else
                                                  "; try `skills-gate suggest` or `skills-gate search`"))
    return r


def touch(c, name: str, kind: str = "use", at: int | None = None, detail: str = ""):
    c.execute("update skills set last_used=max(coalesce(last_used,0),?), uses=uses+1 where name=?",
              (at or now(), name))
    event(c, name, kind, detail, at)


# ---------------------------------------------------------------------------------------------------- ranking

WORD = re.compile(r"[a-z0-9][a-z0-9+#]*")
STOP = set("""when with that this from your their into what the for and use used uses using user users
only also about other than them then each will must should does more most such just like want
asks need needs make makes made help helps before after over under
you can are was has have not any all some our its it is be to of in on at by as or an if do so we me my
please could would there here which who why how get got new now one way thing things let lets yes no ok""".split())


def stem(w: str) -> str:
    for suf in ("ing", "ed", "es", "s"):
        if len(w) > len(suf) + 3 and w.endswith(suf):
            w = w[: -len(suf)]
            break
    return w[:-1] if len(w) > 4 and w.endswith("e") else w  # write / writes / writing -> writ


def toks(text: str) -> list[str]:
    return [stem(w) for w in WORD.findall((text or "").lower()) if len(w) > 1 and w not in STOP]


FIELDS = (("name", 3.0), ("description", 1.0), ("lane", 0.5), ("keywords", 0.4))


class Index:
    """BM25 over name, description, lane and playbook headings. CPU only, rebuilt per call (it takes milliseconds)."""

    def __init__(self, rows):
        self.docs, self.df, self.name_df = [], {}, {}
        for r in rows:
            tf: dict[str, float] = {}
            for field, w in FIELDS:
                text = r[field] or ""
                if field == "name":
                    text = re.sub(r"[-_.]", " ", text)
                for t in toks(text):
                    tf[t] = tf.get(t, 0) + w
            names = set(toks(re.sub(r"[-_.]", " ", r["name"])))
            self.docs.append((r, tf, sum(tf.values()) or 1.0, names))
            for t in tf:
                self.df[t] = self.df.get(t, 0) + 1
            for t in names:
                self.name_df[t] = self.name_df.get(t, 0) + 1
        self.n = len(self.docs)
        self.avg = sum(d[2] for d in self.docs) / max(1, self.n)

    def rank(self, query: str, limit: int = 10):
        q, ql, out = set(toks(query)), query.lower(), []
        for r, tf, length, names in self.docs:
            s = 0.0
            for t in q:
                f = tf.get(t)
                if f:
                    idf = math.log(1 + (self.n - self.df[t] + 0.5) / (self.df[t] + 0.5))
                    s += idf * f * 2.2 / (f + 1.2 * (0.25 + 0.75 * length / self.avg))
                if t in names:  # a word rare among skill names is a strong signal even when descriptions overuse it
                    s += 0.8 * math.log(1 + self.n / self.name_df[t])
            name = r["name"].lower()
            if len(name) > 2 and re.search(rf"(?<![a-z0-9-]){re.escape(name)}(?![a-z0-9-])", ql):
                s += 8.0
            if s > 0:
                out.append((round(s + 0.3 * math.log1p(r["uses"]), 2), r))
        out.sort(key=lambda x: (-x[0], x[1]["name"]))
        return out[:limit]


def min_score(cfg: dict, n_docs: int) -> float:
    """BM25 scores grow with the bank (idf ~ log N); min_score is set for ~150 skills and scaled for smaller banks."""
    return round(cfg["suggest"]["min_score"] * min(1.0, math.log1p(n_docs) / 5.0), 2)


def confident(hits, cfg: dict, exclude=(), n_docs: int = 150) -> list:
    s = cfg["suggest"]
    if not hits:
        return []
    top = hits[0][0]
    bar = min_score(cfg, n_docs)
    return [(sc, r) for sc, r in hits if sc >= bar and sc >= top * s["ratio"]
            and r["name"] not in exclude][: s["limit"]]


# ---------------------------------------------------------------------------------------------------- linking

def project_root(start: Path | None = None) -> Path:
    start = (start or Path.cwd()).resolve()
    try:
        out = subprocess.run(["git", "-C", str(start), "rev-parse", "--show-toplevel"], capture_output=True,
                             text=True, timeout=10, env=git_env())
        if out.returncode == 0 and out.stdout.strip():
            return Path(out.stdout.strip())
    except (OSError, subprocess.TimeoutExpired):
        pass
    return start


def bank_target(link: Path) -> str | None:
    """The bank skill a symlink points at (absolute or relative, normalized), or None."""
    try:
        t = os.readlink(link)
    except OSError:
        return None
    t = os.path.normpath(t if os.path.isabs(t) else os.path.join(str(link.parent), t))
    for root in {os.path.normpath(str(BANK)), os.path.normpath(os.path.realpath(BANK))}:
        if t.startswith(root + os.sep):
            return t[len(root) + 1:].split(os.sep)[0] or None
    return None


def links_to(link: Path, name: str) -> bool:
    return link.is_symlink() and bank_target(link) == name


def points_into_bank(link: Path) -> bool:
    return bank_target(link) is not None


def link_into(target_dir: Path, name: str) -> bool:
    target_dir.mkdir(parents=True, exist_ok=True)
    link = target_dir / name
    src = bank_path(name)
    if links_to(link, name):
        return False
    if link.exists() and not link.is_symlink():
        say(f"[keep]  {link} is a real folder, not replaced")
        return False
    if link.is_symlink():
        if link.exists() and not points_into_bank(link):
            say(f"[keep]  {link} links somewhere else ({os.readlink(link)}), not replaced")
            return False
        link.unlink()
    link.symlink_to(src)
    return True


def unlink_from(target_dir: Path, name: str) -> bool:
    link = target_dir / name
    if links_to(link, name):
        link.unlink()
        return True
    return False


def scope_dirs(cfg: dict, scope: str) -> list[Path]:
    if scope == "global":
        return list(harness_dirs(cfg).values())
    root = Path(scope)
    return [root / d for d in cfg["project_dirs"]]


def git_exclude(root: Path, rels: list[str]):
    """Keep project links out of git: they point into this machine's bank. Uses .git/info/exclude, never .gitignore."""
    info = root / ".git" / "info"
    if not (root / ".git").is_dir():
        return
    ex = info / "exclude"
    lines = ex.read_text().splitlines() if ex.exists() else []
    add = [f"/{r}" for r in rels if f"/{r}" not in lines]
    if add:
        info.mkdir(parents=True, exist_ok=True)
        if "# skills-gate links" not in lines:
            add.insert(0, "# skills-gate links")
        ex.write_text("\n".join(lines + add) + "\n")


# ---------------------------------------------------------------------------------------------------- manifests

def read_manifest(root: Path) -> dict:
    p = root / MANIFEST
    m = {"skills": [], "presets": [], "sources": {}}
    if p.is_file():
        try:
            m.update(json.loads(p.read_text()))
        except ValueError:
            warn(f"{p} is not valid JSON; ignored")
    return m


def write_manifest(root: Path, m: dict):
    m["skills"] = sorted(set(m.get("skills", [])))
    m["presets"] = sorted(set(m.get("presets", [])))
    m["sources"] = {k: v for k, v in sorted(m.get("sources", {}).items()) if k in m["skills"]}
    (root / MANIFEST).write_text(json.dumps(m, indent=2) + "\n")


def remember_project(c, root: Path):
    projects = set(json.loads(meta_get(c, "projects", "[]")))
    if str(root) not in projects:
        projects.add(str(root))
        meta_set(c, "projects", json.dumps(sorted(projects)))


def manifest_skills(c, root: Path) -> set[str]:
    m = read_manifest(root)
    names = set(m.get("skills", []))
    for p in m.get("presets", []):
        names |= set(preset_members(c, p, strict=False))
    return names


def preset_members(c, name: str, strict: bool = True) -> list[str]:
    rows = [r[0] for r in c.execute("select skill from presets where name=? order by skill", (name,))]
    if not rows and strict:
        have = [r[0] for r in c.execute("select distinct name from presets order by name")]
        die(f"no preset {name!r}" + (f"; presets: {', '.join(have)}" if have else "; make one with `preset save`"))
    return rows


def remote_source(row) -> str:
    return row["source"] if "://" in row["source"] or row["source"].startswith("git@") else ""


# ---------------------------------------------------------------------------------------------------- the gate skill

GATE_HEAD = """---
name: skills-gate
description: "The gate to every skill on this machine. Use when a task needs a capability you do not have loaded, when an instruction names a skill that is not available, or at the start of a project to see which skill lanes exist. One command pulls any skill's playbook in on demand: skills-gate use <name>."
---

# skills-gate

Only this skill (and a few always-on ones) is loaded. Every other skill waits in the bank, sorted into lanes below.
Pull in only what the task needs; the rest costs no context.

## Use

```bash
skills-gate suggest "<the task in a sentence>"   # the best-fitting skills, ranked; start here
skills-gate use <skill>          # print the skill's playbook here and follow it (recorded as used)
skills-gate lane <lane>          # the skills in one lane: name, when to use, size
skills-gate search "<words>"     # search the bank by name, purpose and lane
skills-gate on <skill> [--save]  # keep it loaded for this project (auto-off after {prune_days} idle days;
                                 # --save writes it to the project's .skills-gate.json)
skills-gate off <skill>          # unload it from this project
skills-gate search "<words>" --market    # find a new skill online; show the user, install only on their yes
skills-gate add <source> --yes   # install into the bank; scans it first. Pass --yes only after the user agreed
```

Rules: prefer `use` for a one-off task and `on` for a project that will keep needing it. Never install from the
market without the user's yes, and show them what the install scan reported. Do not copy bank skills into
global folders by hand: the daily `tidy` removes anything that bypasses the gate.

Local first: a skill never calls out. Do not run a skill's command or script that reaches an external host
unless the user approved that host (`skills-gate net` lists approvals; `use` prints a NETWORK NOT APPROVED
notice when a skill has none). Local and tailnet addresses are fine. Never pass --allow-net or --allow-risky
yourself, and never `quarantine release` a held skill or update; only the user decides those.

## Lanes
"""


def lane_summary(rows) -> str:
    words = {}
    for r in rows:
        for w in re.findall(r"[a-z][a-z-]{3,}", (r["name"] + " " + r["description"]).lower()):
            if w not in STOP:
                words[w] = words.get(w, 0) + 1
    top = sorted(words, key=lambda w: (-words[w], w))[:7]
    return ", ".join(top)


def write_registry(c, cfg: dict):
    """Regenerate the gate skill (lane index with names) and one file per lane with a line per skill."""
    rows = c.execute("select * from skills order by lane, name").fetchall()
    lanes: dict[str, list] = {}
    for r in rows:
        lanes.setdefault(r["lane"], []).append(r)
    LANES_DIR.mkdir(parents=True, exist_ok=True)
    for f in LANES_DIR.glob("*.md"):
        if f.stem not in lanes:
            f.unlink()
    for lane, rs in lanes.items():
        lines = [f"# lane: {lane} ({len(rs)} skills)", ""]
        for r in rs:
            flag = f", risk {r['risk']}" if r["risk"] in ("high", "medium") else ""
            lines.append(f"- {r['name']} (~{r['tokens']} tok, used {r['uses']}x{flag}): {short(r['description'], 160)}")
        (LANES_DIR / f"{lane}.md").write_text("\n".join(lines) + "\n")
    GATE_DIR.mkdir(parents=True, exist_ok=True)
    body = [GATE_HEAD.replace("{prune_days}", str(cfg["prune_days"]))]
    body.append("| lane | skills | about |\n|---|---|---|")
    for lane, rs in sorted(lanes.items()):
        body.append(f"| {lane} | {len(rs)} | {lane_summary(rs)} |")
    body.append("\n## Skills by lane\n")
    for lane, rs in sorted(lanes.items()):
        body.append(f"- **{lane}**: " + ", ".join(r["name"] for r in rs))
    hot = c.execute("select name from skills where uses>0 order by last_used desc limit 8").fetchall()
    if hot:
        body.append("\nRecently used: " + ", ".join(r[0] for r in hot) + ".")
    body.append(f"\n{len(rows)} skills in the bank. Registry rebuilt {time.strftime('%Y-%m-%d %H:%M')}.\n")
    (GATE_DIR / "SKILL.md").write_text("\n".join(body))


def install_gate(cfg: dict):
    for name, d in harness_dirs(cfg).items():
        link = d / GATE_NAME
        if link.is_symlink() and Path(os.readlink(link)) == GATE_DIR:
            continue
        if link.exists() and not link.is_symlink():
            say(f"[keep]  {link} is a real folder; remove it to let the gate in")
            continue
        if link.is_symlink():
            link.unlink()
        link.symlink_to(GATE_DIR)
        say(f"[gate]  {link}")


# ---------------------------------------------------------------------------------------------------- install scan

SCRIPT_EXT = {".sh", ".bash", ".zsh", ".py", ".js", ".mjs", ".cjs", ".ts", ".ps1", ".rb", ".pl", ".fish", ".bat"}
DOC_EXT = {".md", ".markdown", ".txt", ".mdx", ".rst", ""}
# (severity in scripts, severity in docs or None, rule, pattern)
SCAN_RULES = [
    ("high", "medium", "pipe-to-shell", r"(curl|wget|iwr|Invoke-WebRequest)\b[^\n|]*\|\s*(sudo\s+)?(ba|z|da|fi)?sh\b|"
                                        r"\|\s*(iex|Invoke-Expression)\b"),
    ("high", "high", "decode-and-run", r"base64\s+(-d|--decode)[^\n]*\|\s*(sudo\s+)?(ba|z)?sh|exec\s*\(\s*(base64|codecs|"
                                       r"zlib)\.|eval\s*\(\s*(atob|Buffer\.from)|FromBase64String"),
    ("high", "high", "reverse-shell", r"/dev/tcp/\d|\bnc(at)?\b[^\n]*\s-(e|c)\s|socat\b[^\n]*exec:|pty\.spawn"),
    ("high", "high", "credential-read", r"\.ssh/id_(rsa|ed25519|ecdsa)|\.aws/credentials|\.netrc\b|\.git-credentials|"
                                        r"\.config/gh/hosts\.yml|find-generic-password|\.docker/config\.json|"
                                        r"Login Data|\.password-store"),
    ("high", "high", "exfil-env", r"\b(env|printenv|set)\b\s*\|\s*(curl|wget|nc)\b|"
                                  r"(curl|wget)[^\n]*(-d|--data|--post-data)[^\n]*\$\{?\w*(TOKEN|KEY|SECRET|PASS)"),
    ("high", "high", "destructive", r"rm\s+-[a-z]*r[a-z]*f?\s+(--no-preserve-root\s+)?(/|~|\$HOME)(\s|$|\*)|"
                                    r"\bmkfs\.|\bdd\s+if=[^\n]*of=/dev/(sd|nvme|disk)"),
    (None, "high", "prompt-injection", r"(?i)ignore (all |any )?(previous|prior|above|earlier) (instructions|rules)|"
                                       r"do not (tell|inform|show|alert) the user|without (asking|telling|informing) "
                                       r"the user|disregard (the |your )?(system|safety|previous)|"
                                       r"you are no longer bound"),
    ("medium", None, "persistence", r"\bcrontab\b|\.bashrc|\.zshrc|\.bash_profile|\.profile\b|"
                                    r"systemctl\s+(--user\s+)?enable|LaunchAgents|authorized_keys"),
    ("medium", None, "privilege", r"\bsudo\b|chmod\s+[0-7]?[4-7][0-7]{3}\b|chmod\s+[ug]?\+s\b|\bsetuid\b|\bdoas\b"),
    ("low", None, "network", r"\bcurl\b|\bwget\b|requests\.(get|post|put)|urllib\.request|\bfetch\(|http\.client|"
                             r"Invoke-WebRequest|socket\.connect"),
    ("medium", "medium", "encoded-blob", r"[A-Za-z0-9+/]{600,}={0,2}"),
]
HIDDEN_RX = re.compile("[​-‏‪-‮⁠-⁤⁦-⁩﻿\U000e0000-\U000e007f]")
BIDI_RX = re.compile("[‪-‮⁦-⁩\U000e0000-\U000e007f]")
QUOTES = {'"', "'", "`", "\u201c", "\u2018", "\u00ab"}
SEV = {"": 0, "low": 1, "medium": 2, "high": 3}


def scan_tree(path: Path) -> list[dict]:
    """Static checks on a skill folder before it reaches an agent. Findings, not a verdict: read what it flags."""
    out = []
    total = 0
    for f, rel in files_of(path):
        try:
            data = f.read_bytes()
        except OSError:
            continue
        total += len(data)
        ext = f.suffix.lower()
        if data[:4] in (b"\x7fELF", b"\xcf\xfa\xed\xfe", b"\xca\xfe\xba\xbe") or data[:2] == b"MZ":
            out.append({"sev": "high", "rule": "binary", "file": str(rel), "line": 0, "text": "executable binary"})
            continue
        if b"\x00" in data[:4096]:
            if len(data) > 5_000_000:
                out.append({"sev": "low", "rule": "large-file", "file": str(rel), "line": 0,
                            "text": f"{len(data) / 1e6:.1f} MB"})
            continue
        text = data.decode("utf-8", errors="replace")
        script = ext in SCRIPT_EXT or text.startswith("#!") or os.access(f, os.X_OK) and ext not in DOC_EXT
        kind = "script" if script else ("doc" if ext in DOC_EXT else "other")
        for i, line in enumerate(text.splitlines(), 1):
            if HIDDEN_RX.search(line):
                sev = "high" if BIDI_RX.search(line) else "medium"
                out.append({"sev": sev, "rule": "hidden-unicode", "file": str(rel), "line": i,
                            "text": short(HIDDEN_RX.sub("<?>", line), 90)})
            for s_script, s_doc, rule, rx in SCAN_RULES:
                sev = s_script if kind == "script" else s_doc
                if not sev:
                    continue
                m = re.search(rx, line)
                if m and rule == "prompt-injection" and line[max(0, m.start() - 1):m.start()] in QUOTES:
                    continue  # quoted: a skill warning about the phrase, not using it
                if m:
                    out.append({"sev": sev, "rule": rule, "file": str(rel), "line": i, "text": short(line.strip(), 90)})
    if total > 20_000_000:
        out.append({"sev": "low", "rule": "large-skill", "file": ".", "line": 0, "text": f"{total / 1e6:.0f} MB"})
    return out


def scan_level(findings: list[dict]) -> str:
    return max((f["sev"] for f in findings), key=lambda s: SEV[s], default="")


def print_scan(name: str, path: Path, findings: list[dict], limit: int = 12):
    files = list(files_of(path))
    scripts = [str(r) for f, r in files if f.suffix.lower() in SCRIPT_EXT]
    lvl = scan_level(findings) or "clean"
    say(f"[scan]  {name}: {len(files)} file(s){', scripts: ' + ', '.join(scripts[:6]) if scripts else ''}  -> {lvl}")
    for f in sorted(findings, key=lambda x: -SEV[x["sev"]])[:limit]:
        say(f"        {f['sev']:<6} {f['rule']:<17} {f['file']}:{f['line']}  {f['text']}")
    if len(findings) > limit:
        say(f"        ... {len(findings) - limit} more (skills-gate scan {name})")


# ---------------------------------------------------------------------------------------------------- sources

def parse_git(src: str) -> tuple[str, str, str, list[str]]:
    """owner/repo[/sub/path][:skill][@ref] or a git URL (https://github.com/o/r/tree/<ref>/<sub> understood)."""
    ref, only = "", []
    if "@" in src and not src.startswith("git@"):
        src, ref = src.rsplit("@", 1)
    m = re.match(r"^https://github\.com/([^/]+)/([^/]+?)(?:\.git)?(?:/tree/([^/]+)(?:/(.*))?)?/?$", src)
    if m:
        return f"https://github.com/{m.group(1)}/{m.group(2)}.git", m.group(4) or "", ref or (m.group(3) or ""), []
    if re.match(r"^(https?://|git@|ssh://|file://)", src):
        return src, "", ref, []
    if ":" in src:
        src, skill = src.rsplit(":", 1)
        only = [skill]
    parts = src.strip("/").split("/")
    if len(parts) >= 2 and all(re.match(r"^[A-Za-z0-9._-]+$", p) for p in parts):
        return f"https://github.com/{parts[0]}/{parts[1]}.git", "/".join(parts[2:]), ref, only
    die(f"not a folder, git URL or owner/repo[/path][:skill]: {src}")


def parse_source(s: str):
    """The recorded source of a remote install, url#rel@commit, or None for a local one."""
    if "#" not in s or not ("://" in s or s.startswith("git@")):
        return None
    url, rest = s.rsplit("#", 1)
    rel, _, commit = rest.rpartition("@")
    return url, ("" if rel == "." else rel), commit


def git_env() -> dict:
    """Clean env for the tool's own git calls. Harnesses inject GIT_CONFIG_COUNT/KEY_n/VALUE_n (agent guards that
    force feature branches); they must not change what skills-gate does with the user's own bank sync repo."""
    env = dict(os.environ)
    for k in [k for k in env if re.fullmatch(r"GIT_CONFIG_(COUNT|KEY_\d+|VALUE_\d+)", k)]:
        del env[k]
    env["GIT_TERMINAL_PROMPT"] = "0"
    return env


def git_run(args: list[str], cwd=None, timeout=300) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, timeout=timeout, env=git_env())


def fetch_repo(url: str, ref: str, td: Path, commit: str = "") -> tuple[Path, str]:
    dst = td / f"r{len(list(td.iterdir()))}"
    r = git_run(["clone", "-q", "--depth", "1"] + (["--branch", ref] if ref else []) + [url, str(dst)])
    if r.returncode != 0:
        die(f"git clone failed for {url}: {r.stderr.strip()[:300]}")
    head = git_run(["rev-parse", "--short", "HEAD"], cwd=dst).stdout.strip()
    if commit and not head.startswith(commit[:7]):
        f = git_run(["fetch", "-q", "--depth", "1", "origin", commit], cwd=dst)
        if f.returncode == 0 and git_run(["checkout", "-q", "FETCH_HEAD"], cwd=dst).returncode == 0:
            head = git_run(["rev-parse", "--short", "HEAD"], cwd=dst).stdout.strip()
        else:
            warn(f"{url}: commit {commit} not fetchable; using {head}")
    return dst, head


def git_tree_at(d: Path) -> str:
    """The git tree id of folder d at HEAD of the clone it sits in ('' outside a clone). Same id GitHub and the
    `npx skills` lock file record, so a bank copy can be matched to the exact upstream folder it came from."""
    if not (d / ".git").exists() and git_run(["rev-parse", "--is-inside-work-tree"], cwd=d).returncode != 0:
        return ""
    r = git_run(["rev-parse", "HEAD:./"], cwd=d)
    return r.stdout.strip() if r.returncode == 0 else ""


def git_tree_of(d: Path) -> str:
    """The git tree id a folder's current content would have (a throwaway index, nothing written to d)."""
    with tempfile.TemporaryDirectory(prefix="skills-gate-tree-") as td:
        base = ["-c", "core.autocrlf=false", "-c", "core.filemode=true", f"--git-dir={td}/g/.git", f"--work-tree={d}"]
        if git_run(["init", "-q", f"{td}/g"]).returncode != 0:
            return ""
        if git_run(base + ["add", "-A", "-f", "."], cwd=d).returncode != 0:
            return ""
        r = git_run(base + ["write-tree"], cwd=d)
        return r.stdout.strip() if r.returncode == 0 else ""


def install_dirs(c, dirs: list[Path], *, remote: bool, yes: bool, allow_risky: bool, lane=None, link=False,
                 force=False, source_of=lambda d: "", ref="", only=None, allow_net=False) -> list[str]:
    """Quarantine, vet, ask, register. A skill linked from your own folder is vetted in place; everything else is
    copied to quarantine first and enters the bank only when nothing blocks it. Remote installs need the user's yes."""
    cfg = config()
    chosen = [d for d in dirs if not only or d.name in only or frontmatter(d / "SKILL.md").get("name") in only]
    if not chosen:
        die("no matching skill in the source" + (f" (wanted: {', '.join(only)})" if only else ""))
    staged = []
    for d in chosen:
        name = frontmatter(d / "SKILL.md").get("name") or d.name
        meta = {"source": source_of(d), "ref": ref, "lane": lane, "up_tree": git_tree_at(d) if remote else ""}
        here = d if link else quarantine(d, name)
        rep = vet(c, cfg, here, name, allow_risky=allow_risky, allow_net=allow_net)
        if rep["ok"] or link:  # a link to your own folder is reported, never blocked; `use` still enforces egress
            staged.append((d, here, name, rep, meta))
        elif not link:
            (here / ".skills-gate-report.json").write_text(json.dumps(dict(rep, meta=meta), indent=1, default=str))
            event(c, name, "held", "; ".join(rep["blocks"])[:200])
            say(f"[held]  {name} stays in quarantine: {here}")
    c.commit()
    if not staged:
        return []
    if remote and not confirm(f"Install {len(staged)} vetted skill(s) into the bank?", yes):
        for _, here, *_ in staged:
            rm(here)
        say("nothing installed")
        return []
    added = []
    for d, here, name, rep, meta in staged:
        n = register(c, d if link else here, lane, link=link, force=force, source=meta["source"], ref=ref,
                     name=name, up_tree=meta["up_tree"])
        if n:
            record_review(c, n, rep)
            added.append(n)
        if not link:
            rm(here)
    return added


# ---------------------------------------------------------------------------------------------------- trust
# Local first: a skill may not reach an external host unless the user approved that host for that skill. Every new
# skill is vetted in quarantine (install scan, egress, an optional reviewer) before it can enter the bank.

URL_RX = re.compile(r"\b(?:https?|wss?)://([A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::\d+)?")
LOCAL_HOST_RX = re.compile(
    r"^(localhost|0\.0\.0\.0|127\.\d+\.\d+\.\d+|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|169\.254\.\d+\.\d+|"
    r"172\.(1[6-9]|2\d|3[01])\.\d+\.\d+|100\.(6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.\d+\.\d+)$|"
    r"(\.local|\.lan|\.internal|\.home\.arpa|\.ts\.net|\.localhost|\.test|\.invalid|\.example)$|"
    r"^(example\.(com|org|net)|[\w-]+\.example\.(com|org|net))$", re.I)
NET_API_RX = re.compile(
    r"\b(curl|wget|Invoke-WebRequest|Invoke-RestMethod|requests\.(get|post|put|patch|delete|request|Session)\b|"
    r"httpx\.|urllib\.request|urlopen\(|http\.client|aiohttp|axios|node-fetch|got\(|https?\.(get|request)\(|"
    r"new WebSocket|socket\.connect|net\.connect|XMLHttpRequest)|(?<![\w.])fetch\(")
DOC_CALL_RX = re.compile(r"\b(curl|wget|Invoke-WebRequest|Invoke-RestMethod|WebFetch|webfetch)\b|\bfetch\(")
TELEMETRY_RX = re.compile(
    r"posthog|mixpanel|api\.segment\.io|cdn\.segment\.com|amplitude\.com|@amplitude/|@sentry/|sentry_sdk|"
    r"ingest\.sentry\.io|datadoghq|google-analytics\.com|googletagmanager|plausible\.io|umami\.is|"
    r"honeycomb\.io|newrelic|bugsnag|rollbar|logrocket|hotjar|statsig", re.I)
# XML/office namespace identifiers: URIs that name a schema inside a document, never call targets.
NAMESPACE_HOSTS = {"schemas.openxmlformats.org", "schemas.microsoft.com", "openoffice.org", "www.w3.org", "w3.org",
                   "purl.org", "ns.adobe.com", "docbook.org"}


def is_local_host(host: str) -> bool:
    return bool(LOCAL_HOST_RX.search(host.lower().strip(".")))


def egress(path: Path) -> dict:
    """Where a skill would call out: external hosts in scripts (and in commands its playbook tells the agent to
    run), network code with no literal host ('?'), and telemetry SDKs. Local and tailnet addresses do not count."""
    hosts: dict[str, list[str]] = {}
    unknown, telemetry = [], []
    for f, rel in files_of(path):
        ext = f.suffix.lower()
        try:
            data = f.read_bytes()
        except OSError:
            continue
        if b"\x00" in data[:4096] or len(data) > 2_000_000:
            continue
        text = data.decode("utf-8", errors="replace")
        script = ext in SCRIPT_EXT or text.startswith("#!")
        doc = not script and ext in DOC_EXT
        for i, line in enumerate(text.splitlines(), 1):
            where = f"{rel}:{i}"
            if script and line.lstrip().startswith(("#", "//", "*", "/*")) and not URL_RX.search(line):
                continue
            ext_hosts = [h for h in URL_RX.findall(line) if not is_local_host(h) and h.lower() not in NAMESPACE_HOSTS]
            if script or (doc and DOC_CALL_RX.search(line)):
                for h in ext_hosts:
                    hosts.setdefault(h.lower(), []).append(where)
                if script and not ext_hosts and not URL_RX.search(line) and NET_API_RX.search(line):
                    unknown.append(where)
            if script and TELEMETRY_RX.search(line):
                telemetry.append(where)
    return {"hosts": {h: w[:3] for h, w in sorted(hosts.items())}, "unknown": unknown[:5],
            "telemetry": telemetry[:5]}


def net_approved(c, cfg, name: str) -> set[str]:
    rows = {r[0] for r in c.execute("select host from net_allow where skill=?", (name,))}
    return rows | {"*" + h if h.startswith(".") else h for h in cfg["trust"].get("allow_hosts", [])}


def host_ok(host: str, approved: set[str]) -> bool:
    if "*" in approved or host in approved:
        return True
    return any(a.startswith("*.") and (host == a[2:] or host.endswith(a[1:])) for a in approved)


def unapproved(c, cfg, name: str, eg: dict) -> list[str]:
    ok = net_approved(c, cfg, name)
    need = [h for h in eg["hosts"] if not host_ok(h, ok)]
    if (eg["unknown"] or eg["telemetry"] and not eg["hosts"]) and not host_ok("?", ok):
        need.append("?")
    return need


def approve_net(c, name: str, hosts: list[str], why: str = "user"):
    c.executemany("insert or replace into net_allow values (?,?,?,?)", [(name, h, now(), why) for h in hosts])
    event(c, name, "net-allow", ",".join(hosts))


def run_reviewer(cfg, path: Path, name: str, diff: Path | None = None) -> dict:
    """The optional reviewer: trust.review_cmd gets the skill folder; its last stdout line is JSON with a verdict
    (pass | warn | fail | skipped) and notes. It must read the skill, never run it. For an update, SKILLS_GATE_DIFF
    names a file with the change against the installed copy, so the reviewer can judge what the change adds."""
    cmd = cfg["trust"].get("review_cmd")
    if not cmd:
        return {"verdict": "none", "notes": "no reviewer configured"}
    try:
        argv = [os.path.expanduser(x) for x in (cmd if isinstance(cmd, list) else cmd.split())] + [str(path), name]
        env = dict(os.environ, SKILLS_GATE_DIFF=str(diff)) if diff else None
        r = subprocess.run(argv, capture_output=True, text=True, timeout=int(cfg["trust"].get("review_timeout", 600)),
                           env=env)
        line = next((ln for ln in reversed(r.stdout.strip().splitlines()) if ln.strip().startswith("{")), "")
        out = json.loads(line) if line else {"verdict": "error", "notes": short(r.stderr or r.stdout, 200)}
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        out = {"verdict": "error", "notes": short(str(e), 200)}
    if out.get("verdict") not in ("pass", "warn", "fail", "skipped", "error"):
        out = {"verdict": "error", "notes": f"unreadable verdict: {short(json.dumps(out), 150)}"}
    return out


def vet(c, cfg, path: Path, name: str, *, allow_risky=False, allow_net=False, review=True, quiet=False,
        egress_gate=True, diff: Path | None = None) -> dict:
    """The gate every new or changed skill passes: install scan, egress against approvals, the reviewer.
    Returns a report with ok=True only when nothing blocks it."""
    findings = scan_tree(path)
    level = scan_level(findings)
    eg = egress(path)
    if allow_net and (eg["hosts"] or eg["unknown"] or eg["telemetry"]):
        approve_net(c, name, list(eg["hosts"]) + (["?"] if eg["unknown"] or eg["telemetry"] else []), "--allow-net")
    need = unapproved(c, cfg, name, eg)
    rev = run_reviewer(cfg, path, name, diff) if review else {"verdict": "none", "notes": ""}
    blocks = []
    if level == "high" and not allow_risky:
        blocks.append("high-risk scan findings (--allow-risky after reading them)")
    policy = cfg["trust"].get("egress", "deny") if egress_gate else "allow"
    if need and policy == "deny":
        blocks.append(f"calls out to unapproved hosts: {', '.join(need)} (--allow-net, or `skills-gate net allow`)")
    if eg["telemetry"] and policy != "allow" and not host_ok("?", net_approved(c, cfg, name)) and not allow_net:
        blocks.append(f"telemetry code at {', '.join(eg['telemetry'][:2])}")
    if rev["verdict"] == "fail" and not allow_risky:
        blocks.append(f"reviewer: {rev['notes']}")
    if rev["verdict"] in ("skipped", "error") and cfg["trust"].get("review_pending") == "block":
        blocks.append(f"review could not run ({rev['notes']}) and trust.review_pending is block")
    rep = {"name": name, "ok": not blocks, "blocks": blocks, "level": level, "findings": findings, "egress": eg,
           "unapproved": need, "review": rev}
    if not quiet:
        print_scan(name, path, findings, limit=8)
        if eg["hosts"] or eg["unknown"] or eg["telemetry"]:
            say(f"[net]   {name}: calls out to {', '.join(eg['hosts']) or 'no literal host'}"
                + (f"; network code without a host at {', '.join(eg['unknown'][:2])}" if eg["unknown"] else "")
                + (f"; TELEMETRY at {', '.join(eg['telemetry'][:2])}" if eg["telemetry"] else "")
                + (f"  (unapproved: {', '.join(need)})" if need else "  (approved)"))
        if rev["verdict"] != "none":
            say(f"[review] {name}: {rev['verdict']}" + (f" - {short(rev.get('notes', ''), 160)}" if rev.get("notes") else ""))
        for b in blocks:
            say(f"[block] {name}: {b}")
    return rep


def record_review(c, name: str, rep: dict):
    p = bank_path(name)
    c.execute("insert or replace into reviews values (?,?,?,?,?,?,?)",
              (name, tree_hash(p) if p.exists() else "", now(), rep["level"],
               json.dumps({"hosts": list(rep["egress"]["hosts"]), "unknown": bool(rep["egress"]["unknown"]),
                           "telemetry": bool(rep["egress"]["telemetry"]), "unapproved": rep["unapproved"]}),
               rep["review"]["verdict"], short(rep["review"].get("notes", ""), 500)))


def quarantine(src: Path, name: str, rep: dict | None = None, meta: dict | None = None) -> Path:
    q = HOME / "quarantine" / f"{name}-{time.strftime('%Y%m%d-%H%M%S')}"
    i = 1
    while q.exists():
        q, i = Path(f"{q}-{i}"), i + 1
    shutil.copytree(src, q, ignore=IGNORE, symlinks=False)
    if rep is not None:
        (q / ".skills-gate-report.json").write_text(json.dumps(dict(rep, meta=meta or {}), indent=1, default=str))
    return q


def cmd_net(a):
    c = db()
    cfg = config()
    if a.action in (None, "list"):
        rows = c.execute("select name from skills order by name").fetchall()
        shown = 0
        for r in rows:
            p = bank_path(r["name"])
            if not (p / "SKILL.md").is_file():
                continue
            eg = egress(p)
            if not (eg["hosts"] or eg["unknown"] or eg["telemetry"]):
                continue
            need = unapproved(c, cfg, r["name"], eg)
            if need or a.all:
                shown += 1
                tag = "UNAPPROVED" if need else "approved"
                hosts = ", ".join(list(eg["hosts"])[:5]) + (" ..." if len(eg["hosts"]) > 5 else "")
                extra = (" +code without host" if eg["unknown"] else "") + (" +TELEMETRY" if eg["telemetry"] else "")
                say(f"{r['name']:<30} {tag:<10} {hosts or '-'}{extra}")
        say(f"{shown} skill(s){' with unapproved egress' if not a.all else ' that call out'}; policy:"
            f" {cfg['trust'].get('egress', 'deny')}.  approve: skills-gate net allow <skill> [hosts]")
        return
    if a.action == "hosts":
        for r in c.execute("select skill, host, at, by from net_allow order by skill, host"):
            say(f"{r['skill']:<30} {r['host']:<40} {day(r['at'])} ({r['by']})")
        return
    if not a.skill:
        die(f"net {a.action} needs a skill")
    r = get(c, a.skill)
    if a.action == "allow":
        hosts = a.hosts
        if not hosts:
            eg = egress(bank_path(r["name"]))
            hosts = list(eg["hosts"]) + (["?"] if eg["unknown"] or eg["telemetry"] else [])
            if not hosts:
                die(f"{r['name']} does not call out; nothing to approve")
        approve_net(c, r["name"], hosts)
        say(f"[allow] {r['name']} may reach: {', '.join(hosts)}")
    elif a.action == "revoke":
        if a.hosts:
            c.executemany("delete from net_allow where skill=? and host=?", [(r["name"], h) for h in a.hosts])
        else:
            c.execute("delete from net_allow where skill=?", (r["name"],))
        event(c, r["name"], "net-revoke", ",".join(a.hosts))
        say(f"[revoke] {r['name']}: {', '.join(a.hosts) or 'every host'}")
    c.commit()


def cmd_review(a):
    """Vet bank skills again (scan, egress, reviewer) and record the result; nothing is removed."""
    c = db()
    cfg = config()
    if a.pending:
        names = [r[0] for r in c.execute("select name from reviews where verdict in ('skipped','error')")]
    elif a.changed:
        names = [r["name"] for r in changed_since_review(c)]
    elif a.all:
        names = [r[0] for r in c.execute("select name from skills order by name")]
    else:
        names = a.skills
    if not names:
        die("name skills, or --all / --pending / --changed")
    review_pass(c, cfg, names, static=a.static, quiet=a.quiet)


def review_pass(c, cfg, names: list, static: bool = False, quiet: bool = True):
    """Vet each named bank skill (scan, egress, reviewer) and record the verdict; nothing is removed. Used by
    `review` and by the nightly tidy pass for skills that changed since their last review."""
    tally = {"ok": 0, "blocked": 0}
    for n in names:
        r = get(c, n)
        p = bank_path(r["name"])
        if not (p / "SKILL.md").is_file():
            continue
        rep = vet(c, cfg, p, r["name"], review=not static, quiet=quiet, allow_risky=True)
        record_review(c, r["name"], rep)
        c.execute("update skills set risk=? where name=?", (rep["level"], r["name"]))
        tally["ok" if not rep["unapproved"] and rep["review"]["verdict"] != "fail" else "blocked"] += 1
        c.commit()
    say(f"reviewed {len(names)}: {tally['ok']} clean, {tally['blocked']} need a decision (unapproved egress or a"
        f" failed review); `skills-gate net` lists the egress")


def changed_since_review(c) -> list:
    out = []
    for r in c.execute("select s.name, s.link, v.hash from skills s left join reviews v on v.name=s.name").fetchall():
        p = bank_path(r["name"])
        if (p / "SKILL.md").is_file() and (r["hash"] is None or tree_hash(p) != r["hash"]):
            out.append(r)
    return out


def cmd_quarantine(a):
    qdir = HOME / "quarantine"
    entries = sorted(qdir.iterdir()) if qdir.is_dir() else []
    if a.action in (None, "list"):
        for e in entries:
            rep = json.loads((e / ".skills-gate-report.json").read_text()) if (e / ".skills-gate-report.json").is_file() else {}
            say(f"{e.name:<44} {'; '.join(rep.get('blocks', []))[:110] or '-'}")
        say(f"{len(entries)} held in {qdir}" + ("; release: skills-gate quarantine release <entry> [--allow-net]"
                                                 " [--allow-risky]" if entries else ""))
        return
    if a.action == "show":
        for name in a.entries:
            e = qdir / name
            rp = e / ".skills-gate-report.json"
            if not rp.is_file():
                die(f"no quarantined skill {name}")
            rep = json.loads(rp.read_text())
            meta = rep.get("meta", {})
            say(f"{name}: {'update to ' + rep.get('name', '') if meta.get('update') else 'new skill'}"
                f"  from {meta.get('source') or '-'}")
            for b in rep.get("blocks", []):
                say(f"  held: {b}")
            rv = rep.get("review") or {}
            if rv.get("verdict") not in (None, "none"):
                say(f"  reviewer: {rv['verdict']} - {rv.get('notes', '')}")
            if rep.get("diff"):
                say("")
                sys.stdout.write(rep["diff"])
            say(f"\ntake it: skills-gate quarantine release {name}   drop it: skills-gate quarantine rm {name}")
        return
    if a.action == "rm":
        c = db()
        for e in entries:
            if a.all or e.name in a.entries:
                rp = e / ".skills-gate-report.json"
                rep = json.loads(rp.read_text()) if rp.is_file() else {}
                if rep.get("meta", {}).get("update") and rep.get("name"):
                    skip_version(c, rep["name"], held_hash(e), "dropped from quarantine")
                rm(e)
                say(f"[rm]    {e.name}" + ("  (that upstream version will not be offered again)"
                                           if rep.get("meta", {}).get("update") else ""))
        c.commit()
        return
    c = db()
    cfg = config()
    for name in a.entries:
        e = qdir / name
        if not (e / "SKILL.md").is_file():
            die(f"no quarantined skill {name}")
        rep = json.loads((e / ".skills-gate-report.json").read_text()) if (e / ".skills-gate-report.json").is_file() else {}
        meta = rep.get("meta", {})
        skill = rep.get("name") or frontmatter(e / "SKILL.md").get("name") or name
        res = vet(c, cfg, e, skill, allow_risky=a.allow_risky, allow_net=a.allow_net)
        if not res["ok"]:
            c.commit()
            say(f"[held]  {name} stays in quarantine")
            continue
        (e / ".skills-gate-report.json").unlink(missing_ok=True)
        if meta.get("update") and in_bank(skill):
            keep_copy(skill, "pre-update", get(c, skill))
        register(c, e, meta.get("lane"), force=True, source=meta.get("source", str(e)), ref=meta.get("ref", ""),
                 name=skill, kind="release", up_tree=meta.get("up_tree", ""))
        record_review(c, skill, res)
        rm(e)
    write_registry(c, cfg)
    c.commit()


# ---------------------------------------------------------------------------------------------------- commands

def cmd_init(a):
    HOME.mkdir(parents=True, exist_ok=True)
    for d in (BANK, COLD, GATED, LANES_DIR):
        d.mkdir(parents=True, exist_ok=True)
    if not CONFIG.exists():
        cfg = json.loads(json.dumps(DEFAULT_CONFIG))
        for name, info in KNOWN_AGENTS.items():
            if name not in cfg["harness_dirs"] and not info.get("manual") and Path(info["global"]).expanduser().is_dir() \
                    and name not in cfg.get("ignore_agents", []):
                cfg["harness_dirs"][name] = info["global"]
        CONFIG.write_text(json.dumps(cfg, indent=2) + "\n")
        say(f"[write] {CONFIG}")
    cfg = config()
    c = db()
    write_registry(c, cfg)
    install_gate(cfg)
    c.commit()
    found = harness_dirs(cfg)
    say(f"skills-gate {VERSION} ready at {HOME}")
    say("harness folders: " + (", ".join(f"{k}={v}" for k, v in found.items()) or "none found"))
    say("next: `skills-gate gate --dry-run` to see what would move behind the gate; `skills-gate agents` for more")


def unpack_archive(archive: Path, dst: Path):
    """A .zip or .skill (a zipped skill folder, as Claude exports them) into dst. Refuses entries that would land
    outside dst, links, and archives over 200 MB unpacked; nothing in it runs."""
    import stat
    import zipfile
    try:
        z = zipfile.ZipFile(archive)
    except (zipfile.BadZipFile, OSError) as e:
        die(f"{archive}: not a readable zip archive ({e})")
    with z:
        if sum(i.file_size for i in z.infolist()) > 200_000_000:
            die(f"{archive}: over 200 MB unpacked; not a skill")
        root = dst.resolve()
        for i in z.infolist():
            target = (dst / i.filename).resolve()
            if root not in target.parents and target != root:
                die(f"{archive}: entry {i.filename!r} points outside the archive; refused")
            if stat.S_ISLNK(i.external_attr >> 16):
                die(f"{archive}: entry {i.filename!r} is a link; refused")
        z.extractall(dst)


def cmd_add(a):
    c = db()
    cfg = config()
    src = a.source
    added = []
    if Path(src).expanduser().is_file() and Path(src).suffix.lower() in (".zip", ".skill"):
        arc = Path(src).expanduser().resolve()
        with tempfile.TemporaryDirectory(prefix="skills-gate-zip-") as td:
            unpack_archive(arc, Path(td))
            dirs = find_skill_dirs(Path(td))
            if not dirs:
                die(f"no SKILL.md found in {src}")
            added = install_dirs(c, dirs, remote=False, yes=True, allow_risky=a.allow_risky, lane=a.lane,
                                 force=a.force, only=a.only, allow_net=a.allow_net, source_of=lambda d: str(arc))
    elif Path(src).expanduser().exists():
        dirs = find_skill_dirs(Path(src))
        if not dirs:
            die(f"no SKILL.md found in {src}")
        added = install_dirs(c, dirs, remote=False, yes=True, allow_risky=a.allow_risky, lane=a.lane, link=a.link,
                             force=a.force, only=a.only, allow_net=a.allow_net, source_of=lambda d: str(d.resolve()))
    else:
        catalog_tables(c)
        bad = c.execute("select * from market where status='fail' and (id=? or repo||'/'||path=? or"
                        " (path='' and repo=?))", (src, src, src)).fetchone()
        if bad and not a.allow_risky:
            die(f"{src} failed catalog validation: {'; '.join(json.loads(bad['reasons'])[:4])}."
                f" Read it (`skills-gate market show {bad['id']}`); --allow-risky installs it anyway")
        url, sub, ref, only = parse_git(src)
        with tempfile.TemporaryDirectory(prefix="skills-gate-") as td:
            repo, commit = fetch_repo(url, ref, Path(td))
            root = repo / sub if sub else repo
            if not root.exists():
                die(f"{sub} not found in {url}")
            dirs = find_skill_dirs(root)
            if not dirs:
                die(f"no SKILL.md found in {src}")
            added = install_dirs(c, dirs, remote=True, yes=a.yes, allow_risky=a.allow_risky, lane=a.lane,
                                 force=a.force, only=(a.only or []) + only, ref=ref, allow_net=a.allow_net,
                                 source_of=lambda d: f"{url}#{d.relative_to(repo) or '.'}@{commit}")
    write_registry(c, cfg)
    c.commit()
    say(f"{len(added)} skill(s) in the bank from {src}")


def cmd_adopt(a):
    """Copy every skill found under the given folders into the bank (symlinked skills stay links to their source)."""
    c = db()
    cfg = config()
    n = 0
    for root in a.paths:
        for d in find_skill_dirs(Path(root), depth=2):
            linked = d.is_symlink()
            if register(c, d.resolve() if linked else d, a.lane, link=linked and not a.copy, force=a.force):
                n += 1
    write_registry(c, cfg)
    c.commit()
    say(f"adopted {n} skill(s)")


def gated_manifest() -> Path:
    return GATED / "manifest.json"


def is_global_toggle(c, name: str) -> bool:
    return bool(c.execute("select 1 from toggles where skill=? and scope='global'", (name,)).fetchone())


def cmd_gate(a):
    """Move every skill out of the harness folders into the bank, leaving only the gate and always-on skills."""
    cfg = config()
    c = db()
    keep = always_on(cfg)
    man = json.loads(gated_manifest().read_text()) if gated_manifest().exists() else []
    moved = 0
    for harness, d in harness_dirs(cfg).items():
        for entry in sorted(d.iterdir()):
            name = entry.name
            if name.startswith(".") or not (entry / "SKILL.md").is_file():
                continue
            if name in keep:
                # always-on: stays where it is, and is shared with every other harness through the bank
                if not a.dry_run and name != GATE_NAME and not in_bank(name):
                    register(c, entry.resolve(), link=True)
                continue
            if links_to(entry, name) and is_global_toggle(c, name):
                continue  # switched on globally through the gate: legitimate
            if a.dry_run:
                say(f"[dry]   {harness}: {name}{' (link)' if entry.is_symlink() else ''}")
                moved += 1
                continue
            if not in_bank(name):
                linked = entry.is_symlink()
                register(c, entry.resolve() if linked else entry, link=linked)
            backup = GATED / harness / name
            backup.parent.mkdir(parents=True, exist_ok=True)
            rm(backup)
            if entry.is_symlink():
                backup.symlink_to(os.readlink(entry))
                entry.unlink()
            else:
                shutil.move(str(entry), str(backup))
            c.execute("delete from toggles where skill=? and scope='global'", (name,))
            man.append({"harness": harness, "dir": str(d), "name": name, "backup": str(backup), "at": now()})
            event(c, name, "gate", harness)
            moved += 1
    if not a.dry_run:
        for k in keep - {GATE_NAME}:
            if bank_path(k).exists():
                for d in harness_dirs(cfg).values():
                    link_into(d, k)
        GATED.mkdir(parents=True, exist_ok=True)
        gated_manifest().write_text(json.dumps(man, indent=1))
        write_registry(c, cfg)
        install_gate(cfg)
        c.commit()
    say(f"{'would gate' if a.dry_run else 'gated'} {moved} skill entr{'y' if moved == 1 else 'ies'}; "
        f"always on: {', '.join(sorted(keep))}")


def cmd_ungate(a):
    """Put every gated skill back where it was (the bank keeps its copies)."""
    c = db()
    man = json.loads(gated_manifest().read_text()) if gated_manifest().exists() else []
    left = []
    for m in man:
        dst, backup = Path(m["dir"]) / m["name"], Path(m["backup"])
        if dst.exists() or dst.is_symlink():
            if dst.is_symlink():
                dst.unlink()
            else:
                left.append(m)
                say(f"[keep]  {dst} exists; not restored")
                continue
        if backup.is_symlink():
            dst.symlink_to(os.readlink(backup))
            backup.unlink()
        elif backup.exists():
            shutil.move(str(backup), str(dst))
        else:
            say(f"[miss]  {backup}")
            continue
        event(c, m["name"], "ungate", m["harness"])
        say(f"[back]  {dst}")
    gated_manifest().write_text(json.dumps(left, indent=1))
    if a.remove_gate:
        for d in harness_dirs(config()).values():
            g = d / GATE_NAME
            if g.is_symlink():
                g.unlink()
    c.commit()


def cmd_lane(a):
    c = db()
    if not a.name:
        for r in c.execute("select lane, count(*) n, sum(tokens) t from skills group by lane order by lane"):
            say(f"{r['lane']:<14} {r['n']:>4} skills  ~{r['t'] or 0} tok if all loaded")
        return
    f = LANES_DIR / f"{a.name}.md"
    if not f.exists():
        write_registry(c, config())
    if not f.exists():
        die(f"no lane {a.name!r}; lanes: " + ", ".join(sorted(p.stem for p in LANES_DIR.glob('*.md'))))
    sys.stdout.write(f.read_text())


def cmd_set_lane(a):
    c = db()
    for n in a.skills:
        get(c, n)
        c.execute("update skills set lane=? where name=?", (a.lane, n))
        say(f"[lane]  {n} -> {a.lane}")
    write_registry(c, config())
    c.commit()


def cmd_search(a):
    c = db()
    cfg = config()
    if not a.market:
        hits = Index(c.execute("select * from skills").fetchall()).rank(a.query, a.limit)
        if a.json:
            say(json.dumps([{"name": r["name"], "lane": r["lane"], "score": s, "description": r["description"],
                             "tokens": r["tokens"], "uses": r["uses"], "risk": r["risk"]} for s, r in hits], indent=1))
            return
        for s, r in hits:
            say(f"{r['name']:<34} [{r['lane']}] {short(r['description'], 110)}")
        if not hits:
            say("no bank match; try `--market` to search online")
        return
    catalog_tables(c)
    use_catalog = not a.live and c.execute("select 1 from market where validated_at is not null limit 1").fetchone()
    results = catalog_search(c, a.query, a.limit, show_all=a.all) if use_catalog else []
    if use_catalog and not results:
        warn("no validated catalog match yet; asking the marketplaces live")
        use_catalog = False
    if not use_catalog:
        results = market_search(c, cfg, a.query, a.limit, offline=a.offline)
    c.commit()
    if a.json:
        say(json.dumps(results, indent=1))
        return
    for r in results:
        pop = f"{r['popularity']}{'i' if r['kind'] == 'installs' else '*'}"
        mark = "  (in bank)" if r["in_bank"] else ""
        say(f"{r['install']:<58} {pop:>8} {r['via']:<9} {short(r['about'], 60)}{mark}")
    if not results:
        say("no market results")
    else:
        say(("\n(* = GitHub stars; from the validated catalog, --live asks the sources now)" if use_catalog else
             "\n(i = installs on skills.sh, * = GitHub stars)") +
            "  install with: skills-gate add <install> --yes  (only on the user's yes)")


def cmd_suggest(a):
    """Rank the bank for a task. With --hook, read a Claude Code UserPromptSubmit payload and print context."""
    if a.hook:
        try:
            hook_suggest()
        except Exception:  # a prompt hook must never block or break the session
            pass
        return
    if not a.task.strip():
        die('suggest needs the task: skills-gate suggest "<what you are about to do>"')
    c = db()
    cfg = config()
    hits_rows = c.execute("select * from skills").fetchall()
    hits = Index(hits_rows).rank(a.task, 10)
    picks = hits[: a.limit] if a.all else confident(hits, cfg, n_docs=len(hits_rows))[: a.limit]
    if a.json:
        say(json.dumps([{"name": r["name"], "lane": r["lane"], "score": s, "description": r["description"]}
                        for s, r in picks], indent=1))
        return
    for s, r in picks:
        say(f"{r['name']:<30} {s:>6}  [{r['lane']}] {short(r['description'], 100)}")
    if not picks:
        say("no confident match" + (f" (best: {hits[0][1]['name']} {hits[0][0]}; --all shows it)" if hits else ""))


def hook_suggest():
    payload = json.loads(sys.stdin.read() or "{}")
    prompt = str(payload.get("prompt") or payload.get("user_prompt") or "").strip()
    cfg = config()
    if len(prompt) < cfg["suggest"]["min_prompt"] or prompt.startswith(("/", "!", "<")):
        return  # slash commands, shell escapes, harness-injected messages
    c = db(timeout=2)  # the hook has 10 s; a tidy holding the lock must not eat them
    exclude = set(always_on(cfg))
    scope = str(project_root(Path(payload["cwd"]))) if payload.get("cwd") else None
    for r in c.execute("select skill from toggles where scope in ('global', ?)", (scope or "",)):
        exclude.add(r[0])
    rows = c.execute("select * from skills").fetchall()
    picks = confident(Index(rows).rank(prompt[:4000], 10), cfg, exclude, n_docs=len(rows))
    if not picks:
        return
    lines = ["skills-gate: banked skills that match this request. If one fits, load it with "
             "`skills-gate use <name>` before you start; ignore them if they do not fit."]
    for s, r in picks:
        lines.append(f"- {r['name']} [{r['lane']}]: {short(r['description'], 150)}")
    say("\n".join(lines))
    event(c, None, "suggest", json.dumps({"skills": [r["name"] for _, r in picks],
                                         "session": payload.get("session_id", "")}))
    c.commit()


def cmd_hook(a):
    """Print, install or remove the Claude Code prompt hook that runs `suggest` on every prompt."""
    exe = shutil.which("skills-gate") or str(Path(sys.argv[0]).resolve())
    entry = {"hooks": [{"type": "command", "command": f"{exe} suggest --hook", "timeout": 10}]}
    path = Path(a.settings).expanduser()
    if not (a.write or a.remove):
        say(json.dumps({"hooks": {"UserPromptSubmit": [entry]}}, indent=2))
        say(f"\nmerge into {path}, or run `skills-gate hook --write`")
        return
    data = json.loads(path.read_text()) if path.is_file() else {}
    groups = data.setdefault("hooks", {}).setdefault("UserPromptSubmit", [])
    ours = [g for g in groups if any("skills-gate" in h.get("command", "") and "suggest" in h.get("command", "")
                                     for h in g.get("hooks", []))]
    if a.write and ours:
        say(f"[have]  the suggest hook is already in {path}")
        return
    if a.remove and not ours:
        say(f"[none]  no suggest hook in {path}")
        return
    if path.is_file():
        shutil.copy2(path, path.with_name(path.name + ".skills-gate.bak"))
    if a.write:
        groups.append(entry)
    else:
        data["hooks"]["UserPromptSubmit"] = [g for g in groups if g not in ours]
        if not data["hooks"]["UserPromptSubmit"]:
            del data["hooks"]["UserPromptSubmit"]
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")
    say(f"[hook]  {'added to' if a.write else 'removed from'} {path} (backup: {path.name}.skills-gate.bak)")


# ---------------------------------------------------------------------------------------------------- market

def http_json(url: str, timeout=20):
    req = urllib.request.Request(url, headers={"Accept": "application/json", "User-Agent": f"skills-gate/{VERSION}"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.load(resp)


def m_skills_sh(query: str, limit: int) -> list[dict]:
    d = http_json("https://skills.sh/api/search?q=" + urllib.parse.quote(query))
    out = []
    for s in (d.get("skills") or [])[: limit * 2]:
        if not s.get("source") or not s.get("skillId"):
            continue
        out.append({"install": f"{s['source']}:{s['skillId']}", "name": s.get("name") or s["skillId"],
                    "repo": s["source"], "popularity": int(s.get("installs") or 0), "kind": "installs",
                    "about": s.get("description") or f"skills.sh/{s.get('id', '')}"})
    return out


def m_gh_skill(query: str, limit: int) -> list[dict]:
    if not shutil.which("gh"):
        return m_github(query, limit)
    r = subprocess.run(["gh", "skill", "search", query, "--limit", str(limit * 2), "--json",
                        "description,path,repo,skillName,stars"], capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        return m_github(query, limit)
    out = []
    for s in json.loads(r.stdout or "[]"):
        sub = str(Path(s["path"]).parent)
        out.append({"install": s["repo"] + ("" if sub == "." else "/" + sub), "name": s.get("skillName", ""),
                    "repo": s["repo"], "popularity": int(s.get("stars") or 0), "kind": "stars",
                    "about": s.get("description") or s["path"]})
    return out


def m_github(query: str, limit: int) -> list[dict]:
    out, seen = [], set()
    if shutil.which("gh"):
        r = subprocess.run(["gh", "search", "code", query, "--filename", "SKILL.md", "--limit", str(limit * 3),
                            "--json", "repository,path"], capture_output=True, text=True, timeout=60)
        if r.returncode == 0:
            for hit in json.loads(r.stdout or "[]"):
                repo = hit["repository"]["nameWithOwner"]
                sub = str(Path(hit["path"]).parent)
                key = repo + ("" if sub == "." else "/" + sub)
                if key not in seen:
                    seen.add(key)
                    out.append({"install": key, "name": Path(sub).name if sub != "." else repo.split("/")[1],
                                "repo": repo, "popularity": 0, "kind": "stars", "about": hit["path"]})
            stars = repo_stars({o["repo"] for o in out})
            for o in out:
                o["popularity"] = stars.get(o["repo"], 0)
            return out
    q = urllib.parse.quote(f"{query} SKILL.md in:readme,description")
    for it in http_json(f"https://api.github.com/search/repositories?q={q}&sort=stars&per_page={limit}").get("items", []):
        out.append({"install": it["full_name"], "name": it["name"], "repo": it["full_name"],
                    "popularity": it["stargazers_count"], "kind": "stars", "about": it.get("description") or ""})
    return out


def repo_stars(repos: set[str]) -> dict[str, int]:
    """Star counts for many repos in one GraphQL call."""
    repos = sorted(r for r in repos if re.match(r"^[\w.-]+/[\w.-]+$", r))
    if not repos:
        return {}
    parts = [f'r{i}: repository(owner: "{r.split("/")[0]}", name: "{r.split("/")[1]}") {{ nameWithOwner stargazerCount }}'
             for i, r in enumerate(repos[:50])]
    r = subprocess.run(["gh", "api", "graphql", "-f", "query={ " + " ".join(parts) + " }"], capture_output=True,
                       text=True, timeout=30)
    try:
        data = json.loads(r.stdout).get("data") or {}
    except ValueError:
        return {}
    return {v["nameWithOwner"]: v["stargazerCount"] for v in data.values() if v}


MARKETS = {"skills.sh": m_skills_sh, "gh-skill": m_gh_skill, "github": m_github}


def market_search(c, cfg, query: str, limit: int, offline: bool = False) -> list[dict]:
    """Every configured marketplace, cached per query for market_ttl_hours; --offline reads only the cache."""
    ttl = int(cfg.get("market_ttl_hours", 24)) * 3600
    results = []
    for src in cfg.get("marketplace", []):
        fn = MARKETS.get(src)
        if not fn:
            warn(f"unknown marketplace {src!r}; known: {', '.join(MARKETS)}")
            continue
        key = f"{src}:{query.lower().strip()}"
        row = c.execute("select at, body from market_cache where key=?", (key,)).fetchone()
        if row and (offline or now() - row["at"] < ttl):
            items = json.loads(row["body"])
        elif offline:
            items = []
        else:
            try:
                items = fn(query, limit)
                c.execute("insert or replace into market_cache values (?,?,?)", (key, now(), json.dumps(items)))
            except (OSError, ValueError, subprocess.TimeoutExpired) as e:
                warn(f"market {src}: {e}")
                items = json.loads(row["body"]) if row else []
        for it in items:
            it["via"] = src
        results += items
    if offline:  # also match anything cached under other queries
        terms = toks(query)
        for row in c.execute("select body from market_cache"):
            for it in json.loads(row["body"]):
                hay = f"{it['install']} {it['name']} {it['about']}".lower()
                if terms and all(t in hay for t in terms):
                    results.append(dict(it, via=it.get("via", "cache")))
    merged: dict[str, dict] = {}
    for it in results:
        k = it["install"].lower()
        if re.search(r"/(e2e|fixtures?|tests?|__tests__|examples?/test)(/|$)", k):
            continue  # test fixtures that happen to hold a SKILL.md
        if k in merged:
            merged[k]["via"] = ",".join(sorted(set(merged[k]["via"].split(",")) | {it["via"]}))
            merged[k]["popularity"] = max(merged[k]["popularity"], it["popularity"])
        else:
            merged[k] = dict(it)
    names = {r[0] for r in c.execute("select name from skills")}
    terms = toks(query)
    out = []
    for it in merged.values():
        it["in_bank"] = it["name"] in names
        it["match"] = sum(t in (it["name"] + " " + it["install"]).lower() for t in terms)
        out.append(it)
    out.sort(key=lambda x: (-x["match"], -x["popularity"]))
    return out[:limit]


# ---------------------------------------------------------------------------------------------------- catalog
# The marketplace as a local catalog: gathered daily from the skills.sh sitemap and any repos you list, each skill
# validated from its real SKILL.md before it is offered. Search runs offline against it.

SITEMAPS = ["https://www.skills.sh/sitemap-skills-1.xml", "https://www.skills.sh/sitemap-skills-2.xml"]
BINARY_EXT = {".exe", ".dll", ".so", ".dylib", ".bin", ".msi", ".app", ".jar", ".pyc", ".o", ".a"}


def gh_api(path: str):
    """GitHub REST through `gh` (authenticated, 5000/h) or urllib with $GITHUB_TOKEN (60/h without one)."""
    if shutil.which("gh"):
        r = subprocess.run(["gh", "api", path], capture_output=True, text=True, timeout=60)
        if r.returncode != 0:
            raise OSError(short(r.stderr or r.stdout, 160))
        return json.loads(r.stdout)
    headers = {"Accept": "application/vnd.github+json", "User-Agent": f"skills-gate/{VERSION}"}
    if os.environ.get("GITHUB_TOKEN"):
        headers["Authorization"] = f"Bearer {os.environ['GITHUB_TOKEN']}"
    req = urllib.request.Request("https://api.github.com/" + path.lstrip("/"), headers=headers)
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.load(resp)


def http_text(url: str, timeout=30, limit=2_000_000) -> str:
    req = urllib.request.Request(url, headers={"User-Agent": f"skills-gate/{VERSION}"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read(limit).decode("utf-8", errors="replace")


def catalog_tables(c):
    c.executescript("""
    create table if not exists market (
        id text primary key, repo text not null, skill text not null, path text not null default '',
        name text not null default '', description text not null default '', origin text not null default '',
        rank integer, stars integer not null default 0, license text not null default '',
        blob text not null default '', status text not null default 'new', reasons text not null default '[]',
        first_seen integer not null, last_seen integer not null, validated_at integer, updated_at integer);
    create index if not exists market_status on market (status, rank);
    create table if not exists market_names (blob text primary key, name text not null);
    create table if not exists market_repos (
        repo text primary key, branch text, stars integer, license text, archived integer, pushed_at text,
        tree text, truncated integer, checked_at integer, error text);
    """)


def market_gather(c, cfg) -> tuple[int, int]:
    """Every skill id the sources publish. New ids get first_seen=now; ids already known get last_seen=now."""
    t, seen, new = now(), 0, 0
    ids: list[tuple[str, str, str, int | None]] = []  # (repo, skill, origin, rank)
    if "skills.sh" in cfg["market"]["sources"]:
        pos = 0
        for url in SITEMAPS:
            try:
                xml = http_text(url, limit=20_000_000)
            except OSError as e:
                warn(f"catalog: {url}: {e}")
                continue
            for loc in re.findall(r"<loc>https://(?:www\.)?skills\.sh/([^<]+)</loc>", xml):
                parts = urllib.parse.unquote(loc).strip("/").split("/")
                if len(parts) == 3 and all(re.match(r"^[A-Za-z0-9._-]+$", p) for p in parts):
                    pos += 1
                    ids.append((f"{parts[0]}/{parts[1]}", parts[2], "skills.sh", pos))
    for repo in cfg["market"].get("repos", []):
        try:
            for path in repo_tree_skills(c, repo, force=True):
                ids.append((repo, Path(path).parent.name or repo.split("/")[1], "repo", None))
        except OSError as e:
            warn(f"catalog: {repo}: {e}")
    for repo, skill, origin, rank in ids:
        sid = f"{repo}:{skill}"
        cur = c.execute("update market set last_seen=?, rank=coalesce(?, rank) where id=?", (t, rank, sid))
        if not cur.rowcount:
            c.execute("insert into market (id, repo, skill, origin, rank, first_seen, last_seen) values (?,?,?,?,?,?,?)",
                      (sid, repo, skill, origin, rank, t, t))
            new += 1
        seen += 1
    if seen:
        meta_set(c, "market_gathered_at", t)
    return seen, new


def repo_meta(c, repo: str, force=False) -> sqlite3.Row:
    r = c.execute("select * from market_repos where repo=?", (repo,)).fetchone()
    if r and not force and r["checked_at"] and now() - r["checked_at"] < 20 * 3600:
        return r
    try:
        m = gh_api(f"repos/{repo}")
        tree = gh_api(f"repos/{repo}/git/trees/{urllib.parse.quote(m['default_branch'])}?recursive=1")
        c.execute("insert or replace into market_repos values (?,?,?,?,?,?,?,?,?,?)",
                  (repo, m["default_branch"], m.get("stargazers_count", 0), (m.get("license") or {}).get("spdx_id") or "",
                   int(bool(m.get("archived"))), m.get("pushed_at") or "",
                   json.dumps([[x["path"], x.get("size", 0), x.get("sha", "")] for x in tree.get("tree", [])
                               if x.get("type") == "blob"]), int(bool(tree.get("truncated"))), now(), ""))
    except (OSError, ValueError, KeyError) as e:
        c.execute("insert or replace into market_repos (repo, checked_at, error) values (?,?,?)", (repo, now(), str(e)))
    return c.execute("select * from market_repos where repo=?", (repo,)).fetchone()


def repo_tree_skills(c, repo: str, force=False) -> list[str]:
    r = repo_meta(c, repo, force)
    if r["error"]:
        raise OSError(r["error"])
    return [p for p, _, _ in json.loads(r["tree"] or "[]") if p == "SKILL.md" or p.endswith("/SKILL.md")]


def mark_failed(c, row, reasons: list[str]) -> tuple[str, list[str]]:
    c.execute("update market set status='fail', reasons=?, validated_at=? where id=?",
              (json.dumps(reasons), now(), row["id"]))
    return "fail", reasons


def validate_entry(c, row, force: bool = False) -> tuple[str, list[str]]:
    """Find the skill in its repo, read its SKILL.md and judge it: ok, warn or fail, with the reasons."""
    meta = repo_meta(c, row["repo"], force)
    if meta["error"]:
        return mark_failed(c, row, [f"repo unreachable: {short(meta['error'], 100)}"])
    files = json.loads(meta["tree"] or "[]")
    mds = [(p, s, sha) for p, s, sha in files if p == "SKILL.md" or p.endswith("/SKILL.md")]
    pick = [m for m in mds if Path(m[0]).parent.name == row["skill"]] or \
           [m for m in mds if len(mds) == 1 or m[0] == "SKILL.md" and row["skill"] == row["repo"].split("/")[1]] or \
           [m for m in mds if front_name(c, row["repo"], meta["branch"], m) == row["skill"]]
    if not pick:
        why = "tree truncated (huge repo)" if meta["truncated"] else "listed, but not in the repo (renamed or removed upstream)"
        return mark_failed(c, row, [f"not found: {why}"])
    path, size, blob = min(pick, key=lambda m: len(m[0]))
    reasons, status = [], "ok"
    try:
        text = http_text(f"https://raw.githubusercontent.com/{row['repo']}/{meta['branch']}/{urllib.parse.quote(path)}")
    except OSError as e:
        return mark_failed(c, row, [f"SKILL.md unreadable: {e}"])
    folder0 = str(Path(path).parent)
    with tempfile.TemporaryDirectory(prefix="skills-gate-") as td:
        md = Path(td) / "SKILL.md"
        md.write_text(text)
        fetched = 0
        for p, s_, _ in files:  # its scripts too (raw reads cost no API quota), so egress and telemetry show
            if fetched >= 8 or s_ > 200_000 or Path(p).suffix.lower() not in SCRIPT_EXT:
                continue
            if folder0 != "." and not p.startswith(folder0 + "/") or folder0 == "." and "/" in p:
                continue
            rel = p[len(folder0) + 1:] if folder0 != "." else p
            try:
                body_ = http_text(f"https://raw.githubusercontent.com/{row['repo']}/{meta['branch']}/"
                                  f"{urllib.parse.quote(p)}", limit=200_000)
            except OSError:
                continue
            (Path(td) / rel).parent.mkdir(parents=True, exist_ok=True)
            (Path(td) / rel).write_text(body_)
            fetched += 1
        fm = frontmatter(md)
        findings = scan_tree(Path(td))
        eg = egress(Path(td))
    name, desc = fm.get("name", ""), re.sub(r"\s+", " ", fm.get("description", "")).strip()
    body = re.sub(r"^﻿?---\s*\n.*?\n---\s*\n", "", text, count=1, flags=re.S)

    def flag(level, why):  # low findings are notes; medium makes it warn, high makes it fail
        nonlocal status
        reasons.append(why)
        if level == "high":
            status = "fail"
        elif level == "medium" and status == "ok":
            status = "warn"

    if not name or not desc:
        flag("high", "front matter lacks name or description")
    elif not NAME_RX.match(name):
        flag("high", f"unusable name {name!r}")
    if name and name != row["skill"]:
        flag("low", f"name {name!r} differs from listing {row['skill']!r}")
    if desc and len(desc) < 20:
        flag("medium", "description under 20 characters")
    if len(desc) > 1024:
        flag("low", "description over 1024 characters")
    if len(body.strip()) < 200:
        flag("medium", "playbook under 200 characters")
    if size > 200_000:
        flag("medium", f"SKILL.md is {size // 1000} kB")
    for f in findings:
        flag(f["sev"], f"{f['rule']}: line {f['line']}")
    folder = str(Path(path).parent)
    sibs = [(p, s) for p, s, _ in files if folder == "." or p.startswith(folder + "/")]
    if folder == ".":
        sibs = [(p, s) for p, s in sibs if "/" not in p]
    scripts = [p for p, _ in sibs if Path(p).suffix.lower() in SCRIPT_EXT]
    bins = [p for p, _ in sibs if Path(p).suffix.lower() in BINARY_EXT]
    if bins:
        flag("medium", f"ships binaries: {', '.join(Path(b).name for b in bins[:3])}")
    if scripts:
        reasons.append(f"{len(scripts)} script(s); the install scan reads them")
    if sum(s for _, s in sibs) > 20_000_000:
        flag("medium", "folder over 20 MB")
    if eg["telemetry"]:
        flag("medium", f"telemetry code: {', '.join(eg['telemetry'][:2])}")
    if eg["hosts"] or eg["unknown"]:
        flag("medium", "calls out to " + (", ".join(list(eg["hosts"])[:4]) or "hosts built at run time")
             + " (needs your approval: local first)")
    if meta["archived"]:
        flag("medium", "repo archived")
    if not meta["license"]:
        flag("low", "repo has no licence")
    changed = row["blob"] and row["blob"] != blob
    c.execute("update market set path=?, name=?, description=?, stars=?, license=?, blob=?, status=?, reasons=?,"
              " validated_at=?, updated_at=case when ? then ? else updated_at end where id=?",
              (folder if folder != "." else "", name or row["skill"], desc, meta["stars"] or 0, meta["license"] or "",
               blob, status, json.dumps(reasons), now(), int(bool(changed)), now(), row["id"]))
    return status, reasons


def front_name(c, repo: str, branch: str, md) -> str:
    """The front-matter name of one SKILL.md in a repo tree, cached by blob (raw fetches cost no API quota)."""
    path, _, blob = md
    hit = c.execute("select name from market_names where blob=?", (blob,)).fetchone()
    if hit:
        return hit[0]
    try:
        text = http_text(f"https://raw.githubusercontent.com/{repo}/{branch}/{urllib.parse.quote(path)}", limit=20000)
    except OSError:
        return ""
    m = re.search(r"^name:\s*['\"]?([^'\"\n]+)", text.split("\n---", 1)[0], re.M)
    name = m.group(1).strip() if m else ""
    c.execute("insert or replace into market_names values (?,?)", (blob, name))
    return name


def market_install_id(row) -> str:
    if row["path"] or row["validated_at"]:
        return row["repo"] + (f"/{row['path']}" if row["path"] else "")
    return f"{row['repo']}:{row['skill']}"


def cmd_market(a):
    c = db()
    cfg = config()
    catalog_tables(c)
    if a.action == "refresh":
        seen, new = (0, 0) if a.no_gather else market_gather(c, cfg)
        c.commit()
        budget = a.budget if a.budget is not None else int(cfg["market"]["budget"])
        stale = now() - int(cfg["market"]["revalidate_days"]) * DAY
        todo = c.execute("select * from market where validated_at is null order by rank is null, rank, first_seen"
                         " limit ?", (budget,)).fetchall()
        if len(todo) < budget:
            todo += c.execute("select * from market where validated_at < ? order by validated_at limit ?",
                              (stale, budget - len(todo))).fetchall()
        tally = {"ok": 0, "warn": 0, "fail": 0}
        for i, row in enumerate(todo, 1):
            try:
                st, _ = validate_entry(c, row)
            except (OSError, ValueError) as e:
                st = "fail"
                c.execute("update market set status='fail', reasons=?, validated_at=? where id=?",
                          (json.dumps([f"error: {short(str(e), 120)}"]), now(), row["id"]))
            tally[st] += 1
            if i % 25 == 0:
                c.commit()
        meta_set(c, "market_refreshed_at", now())
        c.commit()
        total = c.execute("select count(*) from market").fetchone()[0]
        done = c.execute("select count(*) from market where validated_at is not null").fetchone()[0]
        say(f"catalog: {seen} listed, {new} new; validated {len(todo)} ({tally['ok']} ok, {tally['warn']} warn,"
            f" {tally['fail']} fail); {done} of {total} validated so far")
        return
    if a.action == "validate":
        for sid in a.ids:
            row = c.execute("select * from market where id=? or ?=repo||'/'||path", (sid, sid)).fetchone()
            if not row:
                repo, _, skill = sid.partition(":")
                if not skill:
                    die(f"{sid}: give owner/repo:skill")
                c.execute("insert or ignore into market (id, repo, skill, origin, first_seen, last_seen)"
                          " values (?,?,?,?,?,?)", (sid, repo, skill, "manual", now(), now()))
                row = c.execute("select * from market where id=?", (sid,)).fetchone()
            st, why = validate_entry(c, row, force=True)
            say(f"{sid}: {st}" + "".join(f"\n  - {w}" for w in why))
        c.commit()
        return
    if a.action == "show":
        row = c.execute("select * from market where id=? or ?=repo||'/'||path", (a.ids[0], a.ids[0])).fetchone() \
            if a.ids else None
        if not row:
            die("no such catalog entry (ids look like owner/repo:skill)")
        for k in ("id", "name", "description", "origin", "rank", "stars", "license", "status"):
            say(f"{k:<12} {row[k]}")
        say(f"{'install':<12} skills-gate add {market_install_id(row)} --yes")
        say(f"{'first seen':<12} {day(row['first_seen'])}   validated {day(row['validated_at'])}"
            f"   updated {day(row['updated_at'])}")
        for w in json.loads(row["reasons"]):
            say(f"  - {w}")
        return
    if a.action == "new":
        since = now() - a.days * DAY
        rows = c.execute("select * from market where (first_seen>=? or updated_at>=?) and status in (?,?,?)"
                         " order by status='ok' desc, rank is null, rank limit ?",
                         (since, since, "ok", "warn", "fail" if a.all else "ok", a.limit)).fetchall()
        for r in rows:
            tag = "updated" if r["updated_at"] and r["updated_at"] >= since and r["first_seen"] < since else "new"
            say(f"{r['id']:<56} {r['status']:<5} {tag:<8} {short(r['description'], 60)}")
        pending = c.execute("select count(*) from market where first_seen>=? and validated_at is null",
                            (since,)).fetchone()[0]
        say(f"{len(rows)} shown; {pending} new not validated yet (`market refresh` works through them)")
        return
    # stats
    total = c.execute("select count(*) from market").fetchone()[0]
    say(f"catalog: {total} skills, gathered {day(meta_get(c, 'market_gathered_at'))},"
        f" refreshed {day(meta_get(c, 'market_refreshed_at'))}")
    for r in c.execute("select status, count(*) n from market group by status order by n desc"):
        say(f"  {r['status']:<6} {r['n']}")
    say(f"  repos checked: {c.execute('select count(*) from market_repos').fetchone()[0]}")
    week = c.execute("select count(*) from market where first_seen>=?", (now() - 7 * DAY,)).fetchone()[0]
    say(f"  new this week: {week}")


def catalog_search(c, query: str, limit: int, show_all: bool = False) -> list[dict]:
    catalog_tables(c)
    statuses = ("ok", "warn", "fail") if show_all else ("ok", "warn")
    rows = c.execute(f"select * from market where status in ({','.join('?' * len(statuses))})", statuses).fetchall()
    docs = [{"name": r["name"] or r["skill"], "description": r["description"], "lane": r["repo"], "keywords": "",
             "uses": 0, "_row": r} for r in rows]
    names = {x[0] for x in c.execute("select name from skills")}
    out = []
    for s, d in Index(docs).rank(query, limit * 4):
        r = d["_row"]
        pop = 0.6 * math.log1p(r["stars"]) + (1.5 if r["rank"] and r["rank"] <= 1000 else 0)
        out.append({"install": market_install_id(r), "name": d["name"], "repo": r["repo"], "popularity": r["stars"],
                    "kind": "stars", "about": r["description"], "via": f"catalog:{r['status']}",
                    "in_bank": d["name"] in names, "score": round(s + pop, 2)})
    out.sort(key=lambda x: -x["score"])
    return out[:limit]


# ---------------------------------------------------------------------------------------------------- use / show / toggles

def cmd_use(a):
    c = db()
    r = get(c, a.skill)
    p = bank_path(r["name"])
    md = p / "SKILL.md"
    if not md.is_file():
        die(f"{md} is missing; `skills-gate doctor` will say why")
    touch(c, r["name"], "use")
    c.commit()
    say(f"<!-- skills-gate use {r['name']} | folder: {p} | lane: {r['lane']} -->")
    cfg = config()
    eg = egress(p)
    need = unapproved(c, cfg, r["name"], eg) if cfg["trust"].get("egress", "deny") != "allow" else []
    if need:
        say(f"<!-- skills-gate: NETWORK NOT APPROVED for {r['name']}. Its files call: {', '.join(need)}"
            f"{' (and telemetry)' if eg['telemetry'] else ''}. Do not run any command or script of this skill that"
            f" reaches those hosts. Ask the user first; they approve with `skills-gate net allow {r['name']}"
            f" <host>`. Local and tailnet addresses are fine. -->")
        event(c, r["name"], "net-block", ",".join(need))
        c.commit()
    sys.stdout.write(md.read_text(encoding="utf-8", errors="replace"))
    extra = sorted(str(rel) for f, rel in files_of(p) if f.name != "SKILL.md")
    if extra:
        say(f"\n<!-- files in {p}: {', '.join(extra[:40])}{' ...' if len(extra) > 40 else ''} -->")


def cmd_show(a):
    c = db()
    r = get(c, a.skill)
    toggles = c.execute("select scope, on_at from toggles where skill=?", (r["name"],)).fetchall()
    refs = [x[0] for x in c.execute("select path from refs where skill=? order by path", (r["name"],))]
    presets = [x[0] for x in c.execute("select name from presets where skill=?", (r["name"],))]
    info = dict(r) | {"path": str(bank_path(r["name"])), "on": [t["scope"] for t in toggles], "referenced_by": refs,
                      "presets": presets}
    info.pop("keywords", None)
    if a.json:
        say(json.dumps(info, indent=1))
        return
    for k in ("name", "lane", "description", "source", "path", "tokens", "uses", "pinned", "risk", "on",
              "presets", "referenced_by"):
        v = info[k]
        if k == "pinned":
            v = "yes" if v else "no"
        if isinstance(v, list):
            v = ", ".join(v) or "-"
        say(f"{k:<14} {v or '-'}")
    say(f"{'last used':<14} {day(r['last_used'])}")
    say(f"{'local edits':<14} {'yes' if r['orig_hash'] and tree_hash(bank_path(r['name'])) != r['orig_hash'] else 'no'}")


def expand(c, a) -> list[str]:
    names = list(a.skills or [])
    for lane in a.lane or []:
        rows = [r[0] for r in c.execute("select name from skills where lane=? order by name", (lane,))]
        if not rows:
            die(f"no lane {lane!r}")
        names += rows
    for p in a.preset or []:
        names += preset_members(c, p)
    if not names:
        die("name one or more skills, or --lane / --preset")
    return list(dict.fromkeys(names))


def cmd_on(a):
    cfg = config()
    c = db()
    scope = "global" if a.glob else str(project_root(Path(a.project) if a.project else None))
    names = expand(c, a)
    tok = 0
    for n in names:
        r = get(c, n)
        changed = [d for d in scope_dirs(cfg, scope) if link_into(d, r["name"])]
        c.execute("insert or replace into toggles values (?,?,?,?)",
                  (r["name"], scope, ";".join(map(str, scope_dirs(cfg, scope))), now()))
        touch(c, r["name"], "on", detail=scope)
        tok += len(r["description"]) // 4 + 8
        say(f"[on]    {r['name']} -> {'every harness' if scope == 'global' else scope}"
            f"{'' if changed else ' (already linked)'}")
    if scope != "global":
        root = Path(scope)
        git_exclude(root, [f"{d}/{n}" for d in cfg["project_dirs"] for n in names])
        remember_project(c, root)
        if a.save:
            m = read_manifest(root)
            m["skills"] = list(set(m["skills"]) | set(names))
            for n in names:
                src = remote_source(get(c, n))
                if src:
                    m["sources"][n] = src
            write_manifest(root, m)
            say(f"[save]  {root / MANIFEST}")
    if len(names) > 3:
        say(f"{len(names)} skills on: about {tok} tokens of listing in every session there")
    c.commit()


def cmd_off(a):
    cfg = config()
    c = db()
    scope = "global" if a.glob else str(project_root(Path(a.project) if a.project else None))
    names = expand(c, a)
    for n in names:
        removed = [d for d in scope_dirs(cfg, scope) if unlink_from(d, n)]
        c.execute("delete from toggles where skill=? and scope=?", (n, scope))
        event(c, n, "off", scope)
        say(f"[off]   {n} ({len(removed)} link(s) removed)")
    if a.save and scope != "global":
        root = Path(scope)
        m = read_manifest(root)
        m["skills"] = [s for s in m["skills"] if s not in names]
        write_manifest(root, m)
        say(f"[save]  {root / MANIFEST}")
    c.commit()


def cmd_pin(a, value=1):
    c = db()
    for n in a.skills:
        get(c, n)
        c.execute("update skills set pinned=? where name=?", (value, n))
        say(f"[{'pin' if value else 'unpin'}]  {n}")
    c.commit()


def cmd_remove(a):
    c = db()
    cfg = config()
    for n in a.skills:
        get(c, n)
        refs = [x[0] for x in c.execute("select path from refs where skill=?", (n,))]
        if refs and not a.force:
            say(f"[held]  {n} is referenced by {', '.join(refs[:3])}; --force removes it anyway")
            continue
        remove_skill(c, cfg, n)
    write_registry(c, cfg)
    c.commit()


def remove_skill(c, cfg, n):
    for t in c.execute("select scope from toggles where skill=?", (n,)).fetchall():
        for d in scope_dirs(cfg, t["scope"]):
            unlink_from(d, n)
    p = bank_path(n)
    COLD.mkdir(parents=True, exist_ok=True)
    dst = COLD / n
    rm(dst)
    if p.is_symlink() or p.exists():
        shutil.move(str(p), str(dst))
    c.execute("delete from toggles where skill=?", (n,))
    c.execute("delete from skills where name=?", (n,))
    c.execute("delete from presets where skill=?", (n,))
    event(c, n, "remove", "moved to cold")
    say(f"[cold]  {n} -> {dst}  (restore: skills-gate add {dst})")


# ---------------------------------------------------------------------------------------------------- presets

def cmd_preset(a):
    c = db()
    if a.action == "list" or not a.action:
        for r in c.execute("select name, count(*) n, group_concat(skill, ', ') s from presets group by name order by name"):
            say(f"{r['name']:<20} {r['n']:>3}  {short(r['s'], 90)}")
        return
    if not a.name:
        die(f"preset {a.action} needs a name")
    if a.action == "show":
        for s in preset_members(c, a.name):
            say(s)
        return
    if a.action in ("save", "add"):
        if not a.skills:
            die("name the skills")
        for s in a.skills:
            get(c, s)
        if a.action == "save":
            c.execute("delete from presets where name=?", (a.name,))
        c.executemany("insert or ignore into presets values (?,?)", [(a.name, s) for s in a.skills])
        say(f"[preset] {a.name}: {', '.join(preset_members(c, a.name))}")
    elif a.action == "rm":
        if a.skills:
            c.executemany("delete from presets where name=? and skill=?", [(a.name, s) for s in a.skills])
        else:
            c.execute("delete from presets where name=?", (a.name,))
        say(f"[preset] {a.name} updated")
    c.commit()


# ---------------------------------------------------------------------------------------------------- projects

def cmd_project(a):
    cfg = config()
    c = db()
    root = project_root(Path(a.project) if a.project else None)
    m = read_manifest(root)
    if a.action == "show":
        say(f"project {root}  ({MANIFEST} {'present' if (root / MANIFEST).exists() else 'absent'})")
        on = {r[0] for r in c.execute("select skill from toggles where scope=?", (str(root),))}
        for n in sorted(manifest_skills(c, root) | on):
            state = ("on" if n in on else "off") + (", in manifest" if n in manifest_skills(c, root) else "") + \
                    ("" if in_bank(n) else ", NOT IN BANK")
            say(f"  {n:<30} {state}")
        return
    if a.action == "save":
        on = sorted(r[0] for r in c.execute("select skill from toggles where scope=?", (str(root),)))
        m["skills"] = on
        m["sources"] = {n: remote_source(get(c, n)) for n in on if remote_source(get(c, n))}
        write_manifest(root, m)
        say(f"[save]  {root / MANIFEST}: {', '.join(on) or 'no skills on here'}")
        return
    # sync: install what is missing (from recorded sources), then switch everything in the manifest on
    names = set(m.get("skills", []))
    for p in m.get("presets", []):
        got = preset_members(c, p, strict=False)
        if not got:
            say(f"[miss]  preset {p} is not defined on this machine")
        names |= set(got)
    missing = sorted(n for n in names if not in_bank(n))
    with tempfile.TemporaryDirectory(prefix="skills-gate-") as td:
        for n in missing:
            src = parse_source(m.get("sources", {}).get(n, ""))
            if not src:
                say(f"[miss]  {n}: not in the bank and no source recorded in {MANIFEST}")
                continue
            url, rel, commit = src
            repo, head = fetch_repo(url, "", Path(td), commit)
            d = repo / rel if rel else repo
            if not (d / "SKILL.md").is_file():
                say(f"[miss]  {n}: {rel} not found in {url}")
                continue
            install_dirs(c, [d], remote=True, yes=a.yes, allow_risky=a.allow_risky,
                         source_of=lambda d, url=url, rel=rel, head=head: f"{url}#{rel or '.'}@{head}")
    present = sorted(n for n in names if in_bank(n))
    write_registry(c, cfg)
    c.commit()  # cmd_on opens its own connection
    if present:
        cmd_on(argparse.Namespace(skills=present, lane=None, preset=None, glob=False, project=str(root), save=False))
    write_registry(c, cfg)
    c.commit()
    say(f"project {root}: {len(present)} of {len(names)} manifest skill(s) on")


# ---------------------------------------------------------------------------------------------------- usage

TS_KEYS = ("timestamp", "ts", "time", "created_at", "createdAt")
# a skill folder inside a bank or a skills directory: .../skills-gate/bank/<x>/SKILL.md, .../skills/<x>/SKILL.md
SKILL_PATH = re.compile(r"(?:skills-gate[/\\]+bank|skills)[/\\]+([A-Za-z0-9][A-Za-z0-9._-]{0,80})[/\\]+SKILL\.md")
MAX_SKILLS_PER_CALL = 3  # a call naming more is a listing or a sweep, not a load


def parse_ts(v):
    if isinstance(v, (int, float)) and v > 0:
        return int(v / 1000 if v > 1e12 else v)
    if isinstance(v, str) and v:
        try:
            d = datetime.datetime.fromisoformat(v.strip().replace("Z", "+00:00"))
        except ValueError:
            return None
        if d.tzinfo is None:
            d = d.replace(tzinfo=datetime.timezone.utc)
        return int(d.timestamp())
    return None


def tool_calls(obj):
    """(call id, tool name, arguments) for every tool call in a log record, whatever the harness's layout."""
    stack = [obj]
    while stack:
        o = stack.pop()
        if isinstance(o, dict):
            name = o.get("name") or o.get("toolName")
            if isinstance(name, str) and o.get("type") not in ("tool_result", "toolResult"):
                for k in ("input", "arguments", "args", "params"):
                    if k in o:
                        yield str(o.get("id") or o.get("call_id") or o.get("toolCallId") or ""), name, o[k]
                        break
            stack.extend(v for v in o.values() if isinstance(v, (dict, list)))
        elif isinstance(o, list):
            stack.extend(v for v in o if isinstance(v, (dict, list)))


def harvest_usage(c, cfg) -> dict[str, int]:
    """Skill loads in every configured harness's session logs since the last harvest: the Skill tool, and any tool
    call whose arguments open a <skill>/SKILL.md. Reads tool names and arguments only. Each call counts once."""
    names = {r[0] for r in c.execute("select name from skills")}
    totals = {}
    for src, root in cfg.get("usage_sources", {}).items():
        root = Path(root).expanduser() if root else None
        if not root or not root.is_dir():
            continue
        key = f"harvest_at:{src}"
        since = int(meta_get(c, key, meta_get(c, "harvest_at", "0") if src == "claude" else "0"))
        start, hits = now(), 0
        for f in root.rglob("*.jsonl"):
            try:
                mtime = f.stat().st_mtime
                if mtime < since:
                    continue
                with f.open(encoding="utf-8", errors="replace") as fh:
                    for line in fh:
                        if "SKILL.md" not in line and '"Skill"' not in line:
                            continue
                        try:
                            d = json.loads(line)
                        except ValueError:
                            continue
                        ts = None
                        if isinstance(d, dict):
                            for k in TS_KEYS:
                                ts = parse_ts(d.get(k))
                                if ts:
                                    break
                        ts = ts or int(mtime)
                        for cid, tool, args in tool_calls(d):
                            text = args if isinstance(args, str) else json.dumps(args)
                            found = {m.group(1) for m in SKILL_PATH.finditer(text)}
                            if len(found) > MAX_SKILLS_PER_CALL:
                                continue
                            if tool == "Skill" and isinstance(args, dict):
                                found.add(str(args.get("skill", "")).split(":")[-1])
                            for s in found & names:
                                ref = f"{src}:{cid or hashlib.sha1(line.encode()).hexdigest()[:20]}:{s}"
                                if c.execute("insert or ignore into harvested values (?,?)", (ref, ts)).rowcount:
                                    touch(c, s, "seen", ts, detail=src)
                                    hits += 1
            except OSError:
                continue
        meta_set(c, key, start)
        totals[src] = hits
    return totals


def cmd_harvest(a):
    c = db()
    cfg = config()
    if a.reset:
        c.execute("delete from events where kind='seen'")
        c.execute("delete from harvested")
        c.execute("delete from meta where key like 'harvest_at%'")
        c.execute("update skills set uses=(select count(*) from events e where e.skill=skills.name and"
                  " e.kind in ('use','on')), last_used=(select max(at) from events e where e.skill=skills.name and"
                  " e.kind in ('use','on'))")
        say("[reset] harvested usage cleared; counting again from every log")
    t = harvest_usage(c, cfg)
    write_registry(c, cfg)
    c.commit()
    say("usage: " + (", ".join(f"{k} {v}" for k, v in t.items()) or "no sources found") + " new skill load(s)")


REF_RX = re.compile(r"skills-gate/bank/([A-Za-z0-9][A-Za-z0-9._-]*)|skills-gate\s+(?:use|on)\s+([A-Za-z0-9][A-Za-z0-9._-]*)")
TEXT_EXT = {".md", ".yaml", ".yml", ".json", ".toml", ".txt", ".py", ".sh", ".ts", ".js", ".ini", ".cfg", ""}


def scan_refs(c, cfg) -> tuple[int, set[str]]:
    """Which bank skills something else depends on: links into the bank, `skills-gate/bank/<x>` paths and
    `skills-gate use <x>` lines under ref_roots, links in harness folders, and project manifests. Held skills
    never go cold."""
    names = {r[0] for r in c.execute("select name from skills")}
    found, unknown = set(), set()

    def note(skill, where):
        if skill in names:
            found.add((skill, str(where)))
        elif skill and not skill.startswith("<"):
            unknown.add(skill)

    bank_name = bank_target

    roots = [Path(p).expanduser() for p in cfg.get("ref_roots", [])]
    for root in roots:
        if root.is_file():
            walk = [(str(root.parent), [], [root.name])]
        elif root.is_dir():
            walk = os.walk(root)
        else:
            continue
        for dirpath, dirnames, filenames in walk:
            keep = []
            for d in dirnames:
                p = Path(dirpath) / d
                if p.is_symlink():
                    note_link(p, note, bank_name)  # a linked skill folder: a reference, never walked into
                elif d not in SKIP_PARTS:
                    keep.append(d)
            dirnames[:] = keep
            for fn in filenames:
                p = Path(dirpath) / fn
                if p.is_symlink():
                    note_link(p, note, bank_name)
                    continue
                if p.suffix.lower() not in TEXT_EXT:
                    continue
                try:
                    if p.stat().st_size > 1_000_000:
                        continue
                    text = p.read_text(encoding="utf-8", errors="replace")
                except OSError:
                    continue
                for m in REF_RX.finditer(text):
                    note(m.group(1) or m.group(2), p)
    for d in harness_dirs(cfg).values():
        for e in d.iterdir():
            if e.is_symlink():
                note_link(e, note, bank_name)
    for scope in set(json.loads(meta_get(c, "projects", "[]"))) | {r[0] for r in c.execute(
            "select distinct scope from toggles where scope != 'global'")}:
        root = Path(scope)
        if (root / MANIFEST).is_file():
            for s in manifest_skills(c, root):
                note(s, root / MANIFEST)
    c.execute("delete from refs")
    c.executemany("insert or ignore into refs values (?,?)", sorted(found))
    return len({s for s, _ in found}), unknown


def note_link(p: Path, note, bank_name) -> bool:
    n = bank_name(p) if p.is_symlink() else None
    if n:
        note(n, p)
    return bool(n)


def visible_cost(cfg) -> dict[str, int]:
    """Tokens of the skill front matter each harness folder puts in every session (what is always paid)."""
    out = {}
    for name, d in harness_dirs(cfg).items():
        t = 0
        for e in d.iterdir():
            md = e / "SKILL.md"
            if md.is_file():
                fm = frontmatter(md)
                t += (len(fm.get("name", "")) + len(fm.get("description", ""))) // 4 + 8
        out[name] = t
    return out


def cmd_tidy(a):
    cfg = config()
    c = db()
    dry = a.dry_run
    seen = harvest_usage(c, cfg)
    say("usage: " + (", ".join(f"{k} {v}" for k, v in seen.items()) or "no sources") + " new skill load(s)")
    held_n, unknown = scan_refs(c, cfg)
    held = {r[0] for r in c.execute("select distinct skill from refs")}
    say(f"held: {held_n} skill(s) referenced by prompts, links or project manifests")
    if unknown:
        say(f"[ref?]  referenced but not in the bank: {', '.join(sorted(unknown)[:12])}")
    cutoff = now() - cfg["prune_days"] * DAY
    for t in c.execute("select t.skill, t.scope, t.on_at, s.last_used, s.pinned from toggles t join skills s"
                       " on s.name=t.skill").fetchall():
        last = max(t["on_at"], t["last_used"] or 0)
        if t["pinned"] or last >= cutoff:
            continue
        if t["scope"] != "global" and t["skill"] in manifest_skills(c, Path(t["scope"])):
            continue  # the project's manifest asks for it
        say(f"[stale] {t['skill']} in {t['scope']} (idle {int((now() - last) / DAY)} d) -> off")
        if not dry:
            for d in scope_dirs(cfg, t["scope"]):
                unlink_from(d, t["skill"])
            c.execute("delete from toggles where skill=? and scope=?", (t["skill"], t["scope"]))
            event(c, t["skill"], "prune", t["scope"])
    cold_cut = now() - cfg["cold_days"] * DAY
    # with peers, a skill is cold only when no machine used it, holds it or pinned it, so every peer agrees
    peer_last, peer_held, peer_pinned = fleet(c)
    for r in c.execute("select name, added_at, last_used from skills where pinned=0").fetchall():
        if r["name"] in always_on(cfg) or r["name"] in held or r["name"] in peer_held | peer_pinned:
            continue
        last = max(r["added_at"], r["last_used"] or 0, peer_last.get(r["name"], 0))
        if last < cold_cut:
            say(f"[cold]  {r['name']} unused {int((now() - last) / DAY)} d")
            if not dry:
                remove_skill(c, cfg, r["name"])
    for r in c.execute("select name from skills").fetchall():
        p = bank_path(r["name"])
        if not (p / "SKILL.md").is_file():
            say(f"[broken] {r['name']}: {p} has no SKILL.md (a linked source moved?)")
    qroot = HOME / "quarantine"
    for q in sorted(qroot.iterdir()) if qroot.is_dir() else ():
        m = re.fullmatch(r"(.+)-\d{8}-\d{6}(-\d+)?", q.name)
        if m and q.is_dir() and in_bank(m.group(1)) and held_hash(q) == sync_hash(bank_path(m.group(1))):
            say(f"[quarantine] {q.name}: the bank already has this exact version; hold cleared")
            if not dry:
                rm(q)
    if not dry:
        reindex(c)
    upd = {"applied": [], "held": [], "gone": []}
    if not dry and getattr(a, "updates", True):
        upd = update_pass(c, cfg)
        if upd.get("recovered"):
            say(f"[update] {upd['recovered']} skill(s) got their upstream from an installer's lock file")
        say(f"[update] {upd['checked']} skill(s) with an upstream checked: {len(upd['applied'])} updated,"
            f" {len(upd['held'])} held for you" + (f", {upd['waiting']} still waiting in quarantine"
                                                   if upd.get("waiting") else "")
            + (f", {upd['deferred']} left for tomorrow" if upd["deferred"] else "")
            + (f"; gone upstream: {', '.join(upd['gone'][:6])}" if upd["gone"] else ""))
    changed = changed_since_review(c)
    if changed and not dry and cfg["trust"].get("review_cmd"):
        cap = int(cfg["trust"].get("nightly_review", 20))
        names = [r["name"] for r in changed][:cap]
        say(f"[review] vetting {len(names)} of {len(changed)} changed or never-reviewed skill(s)")
        review_pass(c, cfg, names)
    elif changed:
        say("[review] " + ", ".join(r["name"] for r in changed[:10]) + (", ..." if len(changed) > 10 else "")
            + " never reviewed or changed since; run `skills-gate review --changed`")
    made = []
    every = int(cfg["distill"].get("every_days", 7))
    if every > 0 and not dry and now() - int(meta_get(c, "distill_at", "0")) >= every * DAY:
        _, made = distill_run(c, cfg, quiet=True)
        if made:
            say(f"[distill] {len(made)} new skill draft(s) from your recurring work: "
                f"{', '.join(m['name'] for m in made)}; `skills-gate distill list`")
    waiting = c.execute("select count(*) from distill where status='draft'").fetchone()[0]
    if waiting:
        say(f"[distill] {waiting} draft(s) wait for you: skills-gate distill show NAME, then accept or reject")
    news = []
    if upd["held"]:
        news.append(f"{len(upd['held'])} skill update(s) held ({', '.join(upd['held'][:3])}):"
                    " skills-gate quarantine list")
    if made:
        news.append(f"{len(made)} new skill draft(s): skills-gate distill list")
    if news and not dry:
        notify(cfg, "skills-gate: " + "; ".join(news))
    keep = always_on(cfg)
    leaks = [(h, e.name) for h, d in harness_dirs(cfg).items() for e in d.iterdir()
             if not e.name.startswith(".") and e.name not in keep and (e / "SKILL.md").is_file()
             and not (links_to(e, e.name) and is_global_toggle(c, e.name))]
    if leaks:
        say(f"[leak]  {len(leaks)} skill(s) bypass the gate: " + ", ".join(f"{h}/{n}" for h, n in leaks[:12]))
        if a.fix and not dry:
            c.commit()
            cmd_gate(argparse.Namespace(dry_run=False))
    if not dry:
        write_registry(c, cfg)
        install_gate(cfg)
        meta_set(c, "tidy_at", now())
    c.commit()
    cost = visible_cost(cfg)
    gate_tok = est_tokens(GATE_DIR / "SKILL.md")
    bank_bytes = sum(f.stat().st_size for f in BANK.rglob("*") if f.is_file()) if BANK.exists() else 0
    say("always-loaded skill listing per harness (tokens): " + ", ".join(f"{k} {v}" for k, v in cost.items()))
    say(f"gate skill body ~{gate_tok} tok; bank {c.execute('select count(*) from skills').fetchone()[0]} skills, "
        f"{bank_bytes / 1e6:.1f} MB; db {DB.stat().st_size / 1e3:.0f} kB")


def notify(cfg, msg: str):
    """notify_cmd gets one summary line when a tidy leaves something for the user. Never fails the tidy."""
    cmd = cfg.get("notify_cmd")
    if not cmd:
        return
    try:
        argv = [os.path.expanduser(x) for x in (cmd if isinstance(cmd, list) else shlex.split(cmd))] + [msg]
        subprocess.run(argv, capture_output=True, timeout=60)
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        warn(f"notify_cmd failed: {e}")


def reindex(c, relane: bool = False) -> int:
    """Re-read every bank skill's front matter, size, keywords and hash (and re-guess lanes still on 'general')."""
    n = 0
    for r in c.execute("select name, lane from skills").fetchall():
        p = bank_path(r["name"])
        if not (p / "SKILL.md").is_file():
            continue
        desc = frontmatter(p / "SKILL.md").get("description", "")
        lane = guess_lane(r["name"], desc) if relane and r["lane"] == "general" else r["lane"]
        c.execute("update skills set description=?, tokens=?, hash=?, lane=?, keywords=? where name=?",
                  (desc, est_tokens(p / "SKILL.md"), tree_hash(p), lane, body_keywords(p / "SKILL.md"), r["name"]))
        n += 1
    return n


def cmd_reindex(a):
    c = db()
    n = reindex(c, a.relane)
    write_registry(c, config())
    c.commit()
    say(f"reindexed {n} skill(s)")


def cmd_stats(a):
    c = db()
    cfg = config()
    since = now() - a.days * DAY
    say(f"last {a.days} days")
    for r in c.execute("select coalesce(nullif(detail,''),'gate') src, count(*) n from events where kind in"
                       " ('use','seen') and at>=? group by src order by n desc", (since,)):
        src = "skills-gate use" if r["src"] == "gate" else r["src"]
        say(f"  loads via {src:<16} {r['n']}")
    say("most used:")
    for r in c.execute("select skill, count(*) n from events where kind in ('use','seen','on') and at>=?"
                       " group by skill order by n desc limit ?", (since, a.limit)):
        say(f"  {r['skill']:<30} {r['n']}")
    total = c.execute("select count(*) from skills").fetchone()[0]
    never = c.execute("select count(*) from skills where uses=0").fetchone()[0]
    soon = c.execute("select count(*) from skills where pinned=0 and max(added_at, coalesce(last_used,0)) < ? and"
                     " name not in (select skill from refs)", (now() - (cfg["cold_days"] - 30) * DAY,)).fetchone()[0]
    say(f"bank: {total} skills, {never} never used, {soon} going cold within 30 days")
    tr = {k: n for k, n in c.execute("select kind, count(*) from events where kind in"
                                      " ('net-block','net-allow','net-revoke','held') and at>=? group by kind", (since,))}
    say("trust: " + (", ".join(f"{k} {v}" for k, v in sorted(tr.items())) or "nothing blocked, nothing approved"))
    up = {k: n for k, n in c.execute("select kind, count(*) from events where kind in ('auto-update', 'update',"
                                      " 'update-held', 'update-skip', 'rollback') and at>=? group by kind", (since,))}
    if up:
        say("updates: " + ", ".join(f"{k} {v}" for k, v in sorted(up.items())))
    revs = c.execute("select verdict, count(*) n from reviews where verdict<>'none' and at>=? group by verdict"
                     " order by n desc", (since,)).fetchall()
    if revs:
        say("reviews: " + ", ".join(f"{r['verdict']} {r['n']}" for r in revs))
    sug = c.execute("select at, detail from events where kind='suggest' and at>=?", (since,)).fetchall()
    if sug:
        hit = 0
        for s in sug:
            names = json.loads(s["detail"] or "{}").get("skills", [])
            q = ",".join("?" * len(names))
            if names and c.execute(f"select 1 from events where kind in ('use','seen','on') and skill in ({q}) and"
                                   f" at between ? and ?", (*names, s["at"], s["at"] + 1800)).fetchone():
                hit += 1
        say(f"suggestions: {len(sug)} prompts got one, {hit} ({100 * hit // len(sug)}%) followed by a load"
            f" of a suggested skill within 30 min")
    else:
        say("suggestions: none recorded (is the prompt hook installed? `skills-gate hook`)")


def cmd_bench(a):
    """recall@1, recall@k and MRR of the ranker on a JSONL file of {"prompt": ..., "expect": name | [names]}."""
    c = db()
    cfg = config()
    rows = c.execute("select * from skills").fetchall()
    idx = Index(rows)
    cases = [json.loads(ln) for ln in Path(a.file).read_text().splitlines() if ln.strip()]
    r1 = rk = mrr = fired = right = 0
    misses = []
    for case in cases:
        exp = {case["expect"]} if isinstance(case["expect"], str) else set(case["expect"])
        hits = idx.rank(case["prompt"], 10)
        names = [r["name"] for _, r in hits]
        rank = next((i for i, n in enumerate(names) if n in exp), None)
        picks = [r["name"] for _, r in confident(hits, cfg, n_docs=len(rows))]
        if picks:
            fired += 1
            right += bool(exp & set(picks))
        if rank == 0:
            r1 += 1
        if rank is not None and rank < a.k:
            rk += 1
        mrr += 1 / (rank + 1) if rank is not None else 0
        if rank is None or rank >= a.k:
            misses.append((case["prompt"], sorted(exp), names[:3]))
    n = max(1, len(cases))
    say(f"{len(cases)} cases: recall@1 {r1 / n:.2f}, recall@{a.k} {rk / n:.2f}, MRR {mrr / n:.2f}")
    say(f"suggest fired on {fired}/{len(cases)}, right on {right}/{fired or 1} "
        f"(score bar {min_score(cfg, len(rows))}, ratio {cfg['suggest']['ratio']})")
    for p, e, got in misses[: a.show]:
        say(f"  miss: {short(p, 60)!r} wanted {', '.join(e)}, got {', '.join(got) or '-'}")


def cmd_status(a):
    cfg = config()
    c = db()
    n = c.execute("select count(*) from skills").fetchone()[0]
    used = c.execute("select count(*) from skills where uses>0").fetchone()[0]
    held = c.execute("select count(distinct skill) from refs").fetchone()[0]
    say(f"skills-gate {VERSION}  home {HOME}")
    say(f"bank: {n} skills ({used} ever used, {held} held by references), cold: "
        f"{len(list(COLD.glob('*'))) if COLD.exists() else 0}")
    say(f"always on: {', '.join(sorted(always_on(cfg)))}")
    for t in c.execute("select skill, scope, on_at from toggles order by scope, skill"):
        say(f"on: {t['skill']:<30} {t['scope']}")
    tidy = meta_get(c, "tidy_at")
    say(f"last tidy: {time.strftime('%Y-%m-%d %H:%M', time.localtime(int(tidy))) if tidy else 'never'}")
    peers = json.loads(meta_get(c, "peers") or "{}")
    say(f"remote: {meta_get(c, 'remote') or 'none'}" + (f"  (peer {peer_name(cfg)}; also on the bank: "
        f"{', '.join(sorted(peers))})" if peers else ""))
    drafts = c.execute("select count(*) from distill where status='draft'").fetchone()[0]
    if drafts:
        say(f"skill drafts from your recurring work: {drafts} (skills-gate distill list)")
    say("always-loaded listing (tokens): " + ", ".join(f"{k} {v}" for k, v in visible_cost(cfg).items()))


def cmd_doctor(a):
    cfg = config()
    c = db()
    bad = 0
    for name, d in harness_dirs(cfg).items():
        g = d / GATE_NAME
        ok = g.is_symlink() and Path(os.readlink(g)) == GATE_DIR
        bad += not ok
        say(f"{'ok ' if ok else 'BAD'} gate in {name} ({d})")
    for r in c.execute("select name from skills"):
        if not (bank_path(r[0]) / "SKILL.md").is_file():
            bad += 1
            say(f"BAD {r[0]}: no SKILL.md in the bank")
    for r in c.execute("select name, risk from skills where risk='high' order by name"):
        say(f"warn {r[0]}: high-risk scan findings (skills-gate scan {r[0]})")
    pend = [r["name"] for r in changed_since_review(c)]
    if pend:
        say(f"warn {len(pend)} skill(s) unreviewed or changed since review: {', '.join(pend[:8])}")
    if (HOME / "quarantine").is_dir() and any((HOME / "quarantine").iterdir()):
        say(f"note {len(list((HOME / 'quarantine').iterdir()))} skill(s) in quarantine (skills-gate quarantine)")
    say("doctor: " + ("all good" if not bad else f"{bad} problem(s)"))
    raise SystemExit(1 if bad else 0)


def cmd_migrate(a):
    c = db()
    tables = {r[0] for r in c.execute(
        "select name from sqlite_master where type='table'").fetchall()}
    say("migrated: " + ", ".join(sorted(t for t in tables if t in
        {"tags", "skill_tags", "workspaces", "deployments", "custom_agents", "activity_log", "context_usage"})))


def cmd_timer(a):
    """Install the daily tidy as a systemd user timer (Linux), or print a cron line elsewhere."""
    exe = Path(sys.argv[0]).resolve()
    unit_dir = Path.home() / ".config" / "systemd" / "user"
    if not shutil.which("systemctl"):
        say(f"no systemd: add this to `crontab -e`:\n17 4 * * * {exe} tidy --fix >> {HOME}/tidy.log 2>&1; "
            f"{exe} market refresh >> {HOME}/tidy.log 2>&1")
        return
    unit_dir.mkdir(parents=True, exist_ok=True)
    c = db()
    synced = bool(meta_get(c, "remote"))
    # with a remote: pull first so the tidy decides with the whole fleet's usage and holds, push after
    pull = f"ExecStart=-{sys.executable} {exe} pull\n" if synced else ""
    push = f"ExecStart=-{sys.executable} {exe} push\n" if synced else ""
    (unit_dir / "skills-gate-tidy.service").write_text(
        f"[Unit]\nDescription=skills-gate daily tidy\n\n[Service]\nType=oneshot\n{pull}"
        f"ExecStart={sys.executable} {exe} tidy --fix\n"
        f"ExecStart=-{sys.executable} {exe} market refresh\n{push}Nice=10\n")
    (unit_dir / "skills-gate-tidy.timer").write_text(
        "[Unit]\nDescription=skills-gate daily tidy\n\n[Timer]\nOnCalendar=*-*-* 04:17\nPersistent=true\n"
        "RandomizedDelaySec=10min\n\n[Install]\nWantedBy=timers.target\n")
    units = ["skills-gate-tidy.timer"]
    if synced:  # peers stay in step through the day; a push with nothing new makes no commit
        (unit_dir / "skills-gate-sync.service").write_text(
            f"[Unit]\nDescription=skills-gate peer sync\nAfter=network-online.target\n\n[Service]\nType=oneshot\n"
            f"ExecStart={sys.executable} {exe} push\nNice=10\n")
        (unit_dir / "skills-gate-sync.timer").write_text(
            "[Unit]\nDescription=skills-gate peer sync\n\n[Timer]\nOnCalendar=hourly\nPersistent=true\n"
            "RandomizedDelaySec=5min\n\n[Install]\nWantedBy=timers.target\n")
        units.append("skills-gate-sync.timer")
    subprocess.run(["systemctl", "--user", "daemon-reload"])
    for u in units:
        subprocess.run(["systemctl", "--user", "enable", "--now", u])
    say("[timer] skills-gate-tidy.timer enabled (daily 04:17: "
        + ("pull, tidy, the market catalog refresh, push); skills-gate-sync.timer enabled (hourly push)" if synced
           else "tidy, the market catalog refresh); set a remote and rerun to sync with your other machines"))


# ---------------------------------------------------------------------------------------------------- scan / audit

def cmd_scan(a):
    c = db()
    target = Path(a.target).expanduser()
    if target.exists():
        dirs = find_skill_dirs(target) or [target]
        for d in dirs:
            f = scan_tree(d)
            if a.json:
                say(json.dumps({"path": str(d), "level": scan_level(f), "findings": f}, indent=1))
            else:
                print_scan(d.name, d, f, limit=a.limit)
        return
    r = get(c, a.target)
    f = scan_tree(bank_path(r["name"]))
    c.execute("update skills set risk=? where name=?", (scan_level(f), r["name"]))
    c.commit()
    if a.json:
        say(json.dumps({"name": r["name"], "level": scan_level(f), "findings": f}, indent=1))
    else:
        print_scan(r["name"], bank_path(r["name"]), f, limit=a.limit)


def cmd_audit(a):
    c = db()
    counts = {"high": [], "medium": [], "low": [], "": []}
    for r in c.execute("select name from skills order by name").fetchall():
        p = bank_path(r["name"])
        if not (p / "SKILL.md").is_file():
            continue
        lvl = scan_level(scan_tree(p))
        c.execute("update skills set risk=? where name=?", (lvl, r["name"]))
        counts[lvl].append(r["name"])
    write_registry(c, config())
    c.commit()
    say(f"audit: {len(counts['high'])} high, {len(counts['medium'])} medium, {len(counts['low'])} low, "
        f"{len(counts[''])} clean")
    for lvl in ("high", "medium"):
        if counts[lvl]:
            say(f"{lvl}: {', '.join(counts[lvl])}")
    say("read a skill's findings with: skills-gate scan <name>")


# ---------------------------------------------------------------------------------------------------- updates

def recover_sources(c, cfg) -> int:
    """Bank skills with no recorded upstream take one from another installer's lock file (`npx skills` keeps
    ~/.agents/.skill-lock.json: repo URL, folder path, git tree id). Nothing is fetched; returns how many."""
    n = 0
    for lf in cfg.get("lockfiles") or []:
        try:
            lock = json.loads(Path(lf).expanduser().read_text()).get("skills", {})
        except (OSError, ValueError, AttributeError):
            continue
        for name, ent in lock.items() if isinstance(lock, dict) else ():
            url, path = (ent or {}).get("sourceUrl", ""), (ent or {}).get("skillPath", "")
            if not ("://" in url or url.startswith("git@")) or not path.endswith("SKILL.md"):
                continue
            row = c.execute("select source, link from skills where name=?", (name,)).fetchone()
            if not row or row["link"] or parse_source(row["source"]):
                continue
            rel = str(Path(path).parent)
            c.execute("update skills set source=?, ref='', up_tree=? where name=?",
                      (f"{url}#{'.' if rel in ('', '.') else rel}@", ent.get("skillFolderHash", ""), name))
            event(c, name, "provenance", f"{url} {rel} (from {Path(lf).name})")
            n += 1
    return n


def relocate(repo: Path, name: str):
    """A skill whose folder moved upstream: the one folder (hidden ones included) named for it, or whose SKILL.md
    names it. None when there is no such folder or more than one with different content."""
    hits = []
    for dirpath, dirnames, filenames in os.walk(repo):
        dirnames[:] = [d for d in dirnames if d != ".git" and d not in SKIP_PARTS]
        if "SKILL.md" in filenames:
            d = Path(dirpath)
            if d.name == name or frontmatter(d / "SKILL.md").get("name") == name:
                hits.append(d)
    trees = {git_tree_at(d) or tree_hash(d) for d in hits}
    return hits[0] if hits and len(trees) == 1 else None


def upstream_of(row, td: Path, cache: dict):
    """Fetch the latest upstream copy of a skill: (state, dir or None, new source string)."""
    if row["link"]:
        return "linked", None, ""
    src = parse_source(row["source"])
    if src is None:
        local = Path(row["source"]).expanduser()
        if local.is_dir() and (local / "SKILL.md").is_file():
            return "local", local, row["source"]
        return "no-source", None, ""
    url, rel, commit = src
    key = (url, row["ref"])
    if key not in cache:
        r = git_run(["ls-remote", url, row["ref"] or "HEAD"], timeout=60)
        cache[key] = {"head": r.stdout.split()[0] if r.returncode == 0 and r.stdout.strip() else "", "repo": None}
    ent = cache[key]
    if not ent["head"]:
        return "unreachable", None, ""
    if commit and ent["head"].startswith(commit):
        return "same", None, ""
    if ent["repo"] is None:
        try:
            ent["repo"], ent["short"] = fetch_repo(url, row["ref"], td)
        except SystemExit:
            ent["head"] = ""
            return "unreachable", None, ""
    repo, head = ent["repo"], ent["short"]
    d = repo / rel if rel else repo
    if not (d / "SKILL.md").is_file():
        d = relocate(repo, row["name"])
        if d is None:
            return "gone", None, ""
        rel = str(d.relative_to(repo))
    return "remote", d, f"{url}#{rel or '.'}@{head}"


def check_updates(c, names: list[str], td: Path, rows=None) -> list[dict]:
    """Every named skill (all by default) against its upstream. A skill with a known upstream tree id is judged
    exactly: upstream changed when its tree differs from the recorded one, edited here when the bank copy's tree
    does. Others fall back to the content hash taken when the skill entered the bank."""
    rows = rows if rows is not None else [get(c, n) for n in names] if names else \
        c.execute("select * from skills order by name").fetchall()
    cache, out = {}, []
    for r in rows:
        bank = bank_path(r["name"])
        kind, new_dir, new_src = upstream_of(r, td, cache)
        cur = git_tree_at(new_dir) if kind == "remote" else ""
        if r["up_tree"] and (bank / "SKILL.md").is_file() and not r["link"]:
            edited = git_tree_of(bank) != r["up_tree"]
        else:
            edited = bool(r["orig_hash"]) and (bank / "SKILL.md").is_file() and tree_hash(bank) != r["orig_hash"]
        state = {"linked": "linked", "no-source": "no source", "unreachable": "unreachable", "same": "current",
                 "gone": "gone upstream"}.get(kind)
        if state is None:
            same = cur == r["up_tree"] if cur and r["up_tree"] else tree_hash(new_dir) == r["orig_hash"]
            state = "current" if same else "update"
            if same and kind == "remote" and new_src != r["source"]:
                # nothing new in the folder: remember the commit (or its new place) so tomorrow is one ls-remote
                c.execute("update skills set source=?, up_tree=? where name=?",
                          (new_src, cur or r["up_tree"], r["name"]))
        out.append({"name": r["name"], "state": state, "edited": edited, "dir": new_dir, "source": new_src,
                    "ref": r["ref"], "row": r, "up_tree": cur,
                    "moved": kind == "remote" and parse_source(new_src)[1] != parse_source(r["source"])[1]
                    if parse_source(r["source"]) else False})
    return out


def cmd_outdated(a):
    c = db()
    if recover_sources(c, config()):
        c.commit()
    with tempfile.TemporaryDirectory(prefix="skills-gate-") as td:
        res = check_updates(c, a.skills, Path(td))
    c.commit()
    shown = [e for e in res if a.all or e["state"] not in ("current", "linked", "no source") or e["edited"]]
    if a.json:
        say(json.dumps([{k: e[k] for k in ("name", "state", "edited", "source")} for e in shown], indent=1))
        return
    for e in shown:
        say(f"{e['name']:<32} {e['state']:<14}{'  edited here' if e['edited'] else ''}"
            f"{'  moved upstream' if e['moved'] else ''}")
    ups = sum(e["state"] == "update" for e in res)
    say(f"{ups} update(s) available, {sum(e['edited'] for e in res)} edited here, "
        f"{sum(e['state'] == 'unreachable' for e in res)} unreachable; `skills-gate diff <name>`, "
        f"`skills-gate update <name>`")


def tree_diff(old: Path, new: Path, label_old: str, label_new: str) -> list[str]:
    a = {str(r): f for f, r in files_of(old)} if old.exists() else {}
    b = {str(r): f for f, r in files_of(new)}
    out = []
    for rel in sorted(set(a) | set(b)):
        da = a[rel].read_bytes() if rel in a else b""
        db_ = b[rel].read_bytes() if rel in b else b""
        if da == db_:
            continue
        if b"\x00" in da[:4096] or b"\x00" in db_[:4096]:
            out.append(f"Binary file {rel} differs\n")
            continue
        out += difflib.unified_diff(da.decode("utf-8", "replace").splitlines(True),
                                    db_.decode("utf-8", "replace").splitlines(True),
                                    f"{label_old}/{rel}" if rel in a else "/dev/null",
                                    f"{label_new}/{rel}" if rel in b else "/dev/null")
    return out


def cmd_diff(a):
    c = db()
    with tempfile.TemporaryDirectory(prefix="skills-gate-") as td:
        r = get(c, a.skill)
        kind, d, _ = upstream_of(r, Path(td), {})
        if kind == "same":  # nothing new upstream: show local edits against the recorded commit
            url, rel, commit = parse_source(r["source"])
            repo, _ = fetch_repo(url, r["ref"], Path(td), commit)
            d = repo / rel if rel else repo
        if d is None:
            die(f"{a.skill}: {kind}; nothing to compare with")
        lines = tree_diff(bank_path(r["name"]), d, "bank", "upstream")
    sys.stdout.writelines(lines)
    if not lines:
        say(f"{a.skill}: bank copy matches upstream")


RISK_ORDER = {"": 0, "low": 1, "medium": 2, "high": 3}


def skipped_versions(c, name: str) -> set:
    return {r[0] for r in c.execute("select hash from update_skip where skill=?", (name,))}


def skip_version(c, name: str, h: str, why: str):
    """Never offer this upstream version of the skill again (synced to peers)."""
    c.execute("insert or ignore into update_skip values (?,?,?)", (name, h, now()))
    event(c, name, "update-skip", why)


def judge_update(c, cfg, e: dict, td: Path) -> dict:
    """Vet one upstream change the way the nightly pass does: the full install vetting on the new version, with the
    diff handed to the reviewer, plus what the change itself does (new hosts, higher risk). Returns the vet report
    with `hold`, the reasons an unattended update must wait for the user."""
    name, bank = e["name"], bank_path(e["name"])
    lines = tree_diff(bank, e["dir"], "installed", "upstream")
    diff = Path(td) / f"{name}.diff"
    diff.write_text("".join(lines), encoding="utf-8")
    rep = vet(c, cfg, e["dir"], name, quiet=True, diff=diff)
    old_eg = egress(bank) if (bank / "SKILL.md").is_file() else {"hosts": {}}
    approved = net_approved(c, cfg, name)
    new_hosts = sorted(h for h in rep["egress"]["hosts"] if h not in old_eg["hosts"] and not host_ok(h, approved))
    old_risk = (e["row"]["risk"] or "") if e.get("row") is not None else ""
    hold = list(rep["blocks"])
    if e["edited"]:
        hold.append("the bank copy has local edits; an update would overwrite them")
    if new_hosts:
        hold.append(f"the change adds calls to {', '.join(new_hosts[:4])}")
    if RISK_ORDER.get(rep["level"], 0) > RISK_ORDER.get(old_risk, 0):
        hold.append(f"scan risk rises from {old_risk or 'clean'} to {rep['level']}")
    v = rep["review"]["verdict"]
    if v == "none":
        hold.append("no local reviewer configured (trust.review_cmd); unattended updates need its pass")
    elif v != "pass" and not any(x.startswith("reviewer:") for x in hold):
        hold.append(f"reviewer {v}: {short(rep['review'].get('notes', ''), 160)}")
    rep.update(hold=hold, diff="".join(lines)[:200_000], files=sum(1 for ln in lines if ln.startswith("+++")))
    return rep


def apply_update(c, e: dict, rep: dict, kind: str = "update"):
    row = get(c, e["name"])
    keep_copy(e["name"], "pre-update", row)
    register(c, e["dir"], force=True, source=e["source"], ref=e["ref"], kind=kind, name=e["name"], up_tree=e["up_tree"])
    record_review(c, e["name"], rep)


def already_held(name: str, h: str) -> bool:
    qroot = HOME / "quarantine"
    return any(q.is_dir() and re.fullmatch(re.escape(name) + r"-\d{8}-\d{6}(-\d+)?", q.name) and held_hash(q) == h
               for q in (qroot.glob(f"{name}-*") if qroot.is_dir() else ()))


def hold_update(c, e: dict, rep: dict) -> Path | None:
    """Park an upstream change in quarantine with its report and diff, once per upstream version."""
    if already_held(e["name"], held_hash(e["dir"])):
        return None  # already waiting for you
    rep = dict(rep, blocks=rep["hold"])
    meta = {"source": e["source"], "ref": e["ref"], "lane": e["row"]["lane"], "up_tree": e["up_tree"], "update": True}
    q = quarantine(e["dir"], e["name"], rep, meta)
    event(c, e["name"], "update-held", "; ".join(rep["hold"])[:200])
    return q


def update_pass(c, cfg, quiet: bool = False) -> dict:
    """The nightly update: check every skill with a known upstream; apply what passes `judge_update` cleanly, hold
    the rest in quarantine (update.nightly = auto), hold everything (hold), or only report (check)."""
    mode = (cfg.get("update") or {}).get("nightly", "auto")
    out = {"checked": 0, "available": 0, "applied": [], "held": [], "gone": [], "deferred": 0}
    if mode == "off":
        return out
    out["recovered"] = recover_sources(c, cfg)
    rows = [r for r in c.execute("select * from skills order by name").fetchall()
            if not r["link"] and parse_source(r["source"])]
    cap = int((cfg.get("update") or {}).get("max_reviews", 10))
    with tempfile.TemporaryDirectory(prefix="skills-gate-up-") as td:
        res = check_updates(c, [], Path(td), rows=rows)
        out["checked"] = len(res)
        for e in res:
            if e["state"] == "gone upstream":
                out["gone"].append(e["name"])
            if e["state"] != "update":
                continue
            h = held_hash(e["dir"])
            if h in skipped_versions(c, e["name"]):
                continue
            out["available"] += 1
            if mode != "check" and already_held(e["name"], h):
                out["waiting"] = out.get("waiting", 0) + 1
                continue  # held on an earlier night; no second review
            if mode == "check":
                say(f"[update] {e['name']}: upstream changed; `skills-gate diff {e['name']}`")
                continue
            if cap <= 0:
                out["deferred"] += 1
                continue
            cap -= 1
            rep = judge_update(c, cfg, e, Path(td))
            if mode == "auto" and not rep["hold"]:
                apply_update(c, e, rep, kind="auto-update")
                out["applied"].append(e["name"])
                say(f"[update] {e['name']}: {rep['files']} file(s) changed upstream; reviewer passed it; applied"
                    f" (undo: skills-gate rollback {e['name']})")
            else:
                reasons = rep["hold"] or ["update.nightly is hold"]
                rep["hold"] = reasons
                q = hold_update(c, e, rep)
                if q:
                    out["held"].append(e["name"])
                    say(f"[update] {e['name']}: held, {reasons[0]}; `skills-gate quarantine show {q.name}`")
            c.commit()
    return out


def cmd_update(a):
    c = db()
    cfg = config()
    if not a.skills and not a.all:
        die("name skills to update, or --all")
    if recover_sources(c, cfg):
        c.commit()
    with tempfile.TemporaryDirectory(prefix="skills-gate-") as td:
        res = [e for e in check_updates(c, a.skills, Path(td)) if e["state"] == "update"]
        plan = []
        for e in res:
            if e["edited"] and not a.force:
                say(f"[skip]  {e['name']}: edited here (see `skills-gate diff {e['name']}`); --force overwrites,"
                    f" keeping the old copy in cold/")
                continue
            lines = tree_diff(bank_path(e["name"]), e["dir"], "installed", "upstream")
            diff = Path(td) / f"{e['name']}.diff"
            diff.write_text("".join(lines), encoding="utf-8")
            say(f"[new]   {e['name']}: {sum(1 for ln in lines if ln.startswith('+++'))} file(s) change"
                + ("  (moved upstream)" if e["moved"] else ""))
            e["rep"] = vet(c, cfg, e["dir"], e["name"], allow_risky=a.allow_risky, allow_net=a.allow_net, diff=diff)
            if not e["rep"]["ok"]:
                continue
            plan.append(e)
        if not plan:
            c.commit()
            say("nothing to update")
            return
        if any("://" in e["source"] or e["source"].startswith("git@") for e in plan) and \
                not confirm(f"Update {len(plan)} skill(s)?", a.yes):
            say("nothing updated")
            return
        for e in plan:
            apply_update(c, e, e["rep"])
    write_registry(c, cfg)
    c.commit()
    say(f"updated {len(plan)} skill(s); old copies in {COLD} (undo one: skills-gate rollback <name>)")


def cmd_rollback(a):
    """Put back the copy a skill had before its last update, and never offer the version rolled back from again."""
    c = db()
    cfg = config()
    r = get(c, a.skill)
    copies = sorted(d for d in COLD.glob(f"{r['name']}.pre-update-*") if d.is_dir()) if COLD.is_dir() else []
    if not copies:
        die(f"{r['name']}: no earlier copy in {COLD}; nothing to roll back to")
    old = copies[-1]
    origin = Path(f"{old}.origin.json")
    meta = json.loads(origin.read_text()) if origin.is_file() else {}
    bad, when = held_hash(bank_path(r["name"])), old.name.split(".pre-update-", 1)[1]
    keep_copy(r["name"], "pre-rollback", r)
    register(c, old, force=True, source=meta.get("source", r["source"]), ref=meta.get("ref", r["ref"]),
             name=r["name"], kind="rollback", up_tree=meta.get("up_tree", ""))
    if meta.get("orig_hash"):
        c.execute("update skills set orig_hash=? where name=?", (meta["orig_hash"], r["name"]))
    skip_version(c, r["name"], bad, "rolled back")
    rm(old)
    origin.unlink(missing_ok=True)
    write_registry(c, cfg)
    c.commit()
    say(f"[rollback] {r['name']}: back to the copy kept on {when}; the version rolled back from will not be offered"
        f" again (`skills-gate rollback` once more to step further back)")


# ---------------------------------------------------------------------------------------------------- distill

# Programs too generic to be a workflow on their own (shell, coreutils, interpreters running ad-hoc code).
DISTILL_GENERIC = set("""cd ls cat head tail grep rg sed awk cut sort uniq wc tr echo printf for do done if then fi else
elif while until case esac true false sleep find xargs mkdir rm cp mv ln touch chmod chown test [ [[ ]] python python3
node bash sh zsh env export set unset source . date which type tee less more diff stat file readlink realpath basename
dirname jq exit return break continue local read eval import from def try except with print command builtin wait
kill pkill pgrep ps free du df tar unzip zip wget scp sudo cmp column fold paste nl od xxd base64 sha256sum md5sum
python3.14 pip pip3 git""".split())
# Programs whose subcommand is the workflow (git commit, gh pr, systemctl restart): kept only with one.
DISTILL_SUBCMD = {"git", "gh", "ssh", "systemctl", "journalctl", "docker", "podman", "npm", "npx", "pnpm", "uv",
                  "cargo", "go", "make", "curl", "pct", "qm", "kubectl", "tailscale", "pip", "pip3"}
# git plumbing every session runs; it only counts inside a longer sequence (add, commit, push).
DISTILL_PLUMBING = re.compile(r"^git (status|log|diff|show|fetch|rev-parse|branch|worktree|remote|stash|ls-files)\b")
REDACT = [
    (re.compile(r"(?i)\b([A-Z0-9_]*(?:TOKEN|SECRET|PASSWORD|PASSWD|API_?KEY|AUTH|CREDENTIALS?)[A-Z0-9_]*)=\S+"), r"\1=<redacted>"),
    (re.compile(r"(?i)(authorization:\s*(?:bearer|basic|token)?\s*)[^'\"\s]+"), r"\1<redacted>"),
    (re.compile(r"(?i)(--?(?:token|password|passwd|secret|api-?key|auth)[= ])\S+"), r"\1<redacted>"),
    (re.compile(r"://[^/@\s:]+:[^/@\s]+@"), "://<redacted>@"),
    (re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9_-]{20,}|xox[abpr]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16})\b"),
     "<redacted>"),
    (re.compile(r"\b[A-Za-z0-9+/_-]{40,}={0,2}"), "<redacted>"),
]
HEREDOC = re.compile(r"<<-?\s*['\"]?(\w+)['\"]?[^\n]*\n.*?\n\1\b", re.S)


def redact(text: str) -> str:
    for rx, sub in REDACT:
        text = rx.sub(sub, text)
    return text


def split_commands(cmd: str) -> list[str]:
    """One shell command line into its simple commands, on && || ; | & and newlines outside quotes, so a
    multi-line `python3 -c "..."` or a `grep "a|b"` stays one command."""
    out, cur, quote, i = [], [], "", 0
    while i < len(cmd):
        ch = cmd[i]
        if quote:
            cur.append(ch)
            if ch == "\\" and quote == '"' and i + 1 < len(cmd):
                cur.append(cmd[i + 1])
                i += 1
            elif ch == quote:
                quote = ""
        elif ch in "'\"":
            quote = ch
            cur.append(ch)
        elif ch == "\\" and i + 1 < len(cmd):
            cur.append(cmd[i:i + 2] if cmd[i + 1] != "\n" else " ")
            i += 1
        elif ch == "&" and ((cur and cur[-1] in "<>") or cmd[i + 1:i + 2] == ">"):
            cur.append(ch)  # a redirect (2>&1, &>), not a separator
        elif ch in ";|&\n()":
            out.append("".join(cur))
            cur = []
        elif ch == "#" and (not cur or cur[-1].isspace()):
            while i < len(cmd) and cmd[i] != "\n":
                i += 1
            continue
        else:
            cur.append(ch)
        i += 1
    out.append("".join(cur))
    return [x.strip() for x in out if x.strip()]


def runnable(word: str) -> bool:
    """A program this machine can run, or a script path: not a word from inside a quoted script."""
    return "/" in word or word.endswith((".sh", ".py")) or bool(shutil.which(word))


def command_shape(seg: str) -> str | None:
    """The stable part of one shell command: program, subcommands and flags; paths and values become nothing.
    `nvidia-smi --query-compute-apps=pid --format=csv` -> `nvidia-smi --query-compute-apps --format`."""
    try:
        t = shlex.split(seg, comments=True)
    except ValueError:
        t = seg.split()
    while t and (re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", t[0]) or t[0] in ("sudo", "timeout", "nohup", "time",
                                                                               "exec", "env", "command", "nice", "ionice", "stdbuf", "-n")
                 or re.fullmatch(r"-?\d+[smh]?", t[0])):
        t = t[1:]
    if not t:
        return None
    prog = Path(t[0]).name
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9._+-]{0,40}", prog) or not runnable(t[0]):
        return None
    out = [prog]
    for x in t[1:]:
        if len(out) >= 5 or x in (">", ">>", "2>&1", "<", "2>/dev/null", "&>/dev/null"):
            break
        if re.fullmatch(r"--?[A-Za-z][A-Za-z0-9-]*(=.*)?", x):
            out.append(x.split("=")[0])
        elif re.fullmatch(r"[a-z][a-z0-9_:-]{1,30}", x):
            out.append(x)
        else:
            break  # a path, a value, a quoted script: what follows is arguments, not the command
    sub = [x for x in out[1:] if not x.startswith("-")]
    longf = [x for x in out[1:] if x.startswith("--")]
    if prog in DISTILL_SUBCMD:
        return " ".join(out) if sub else None
    if prog in DISTILL_GENERIC:
        return None
    return " ".join(out) if sub or longf or len(prog) > 3 else None


def session_commands(f: Path):
    """(cwd, [(shape, redacted example)]) for one session log: shell tool calls only, heredoc bodies dropped."""
    cwd, seq = "", []
    with f.open(encoding="utf-8", errors="replace") as fh:
        for line in fh:
            if '"command"' not in line and '"cmd"' not in line and '"cwd"' not in line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if isinstance(d, dict):
                for o in (d, d.get("payload") if isinstance(d.get("payload"), dict) else {}):
                    if isinstance(o.get("cwd"), str) and o["cwd"]:
                        cwd = o["cwd"]
            for _, tool, args in tool_calls(d):
                if isinstance(args, str):
                    try:
                        args = json.loads(args)
                    except ValueError:
                        args = {"command": args}
                if not isinstance(args, dict):
                    continue
                cmd = args.get("command") or args.get("cmd")
                if isinstance(cmd, list):
                    cmd = " ".join(map(str, cmd))
                if not isinstance(cmd, str) or not cmd.strip():
                    continue
                if isinstance(args.get("workdir") or args.get("cwd"), str):
                    cwd = args.get("workdir") or args.get("cwd")
                for seg in split_commands(HEREDOC.sub("", cmd)):
                    s = command_shape(seg)
                    if s and (not seq or seq[-1][0] != s):
                        seq.append((s, redact(seg.strip())[:200]))
    return cwd, seq


def project_of(cwd: str) -> str:
    if not cwd:
        return "?"
    p = Path(cwd)
    for q in (p, *p.parents):
        if (q / ".git").exists():
            return q.name
    return p.name or str(p)


def mine_work(cfg: dict, days: int) -> dict:
    """Every recurring command shape and 3-step sequence in the window's session logs, with the sessions and
    projects it came from. Reads tool-call arguments only, never message text."""
    since = now() - days * DAY
    shapes, seqs, examples, last = {}, {}, {}, {}
    for src, root in cfg.get("usage_sources", {}).items():
        root = Path(root).expanduser() if root else None
        if not root or not root.is_dir():
            continue
        for f in root.rglob("*.jsonl"):
            try:
                mtime = int(f.stat().st_mtime)
                if mtime < since:
                    continue
                cwd, seq = session_commands(f)
            except OSError:
                continue
            sid, proj = f"{src}:{f.stem}", project_of(cwd)
            for s, ex in seq:
                shapes.setdefault(s, [set(), set()])
                shapes[s][0].add(sid)
                shapes[s][1].add(proj)
                examples.setdefault(s, ex)
                last[s] = max(last.get(s, 0), mtime)
            names = [s for s, _ in seq]
            for i in range(len(names) - 2):
                k = tuple(names[i:i + 3])
                if len(set(k)) == 3:
                    seqs.setdefault(k, [set(), set()])
                    seqs[k][0].add(sid)
                    seqs[k][1].add(proj)
    return {"shapes": shapes, "seqs": seqs, "examples": examples, "last": last}


def bank_corpus() -> dict[str, str]:
    """Each bank skill's playbook and scripts, lower-cased, for the 'already covered' check."""
    out = {}
    for p in sorted(BANK.iterdir()) if BANK.is_dir() else ():
        if not (p / "SKILL.md").is_file():
            continue
        parts = []
        for f, rel in files_of(p):
            if f.suffix.lower() in (".md", ".sh", ".bash", ".py", ".txt") and len(parts) < 40:
                with contextlib.suppress(OSError):
                    parts.append(f.read_text(encoding="utf-8", errors="replace")[:60_000].lower())
        out[p.name] = "\n".join(parts)
    return out


def shape_key(shape: str) -> str:
    """The words a playbook must contain to count as covering a shape: the program and its first subcommand/flag."""
    return " ".join(shape.split()[:2]).lower()


def distill_candidates(c, cfg, mined: dict) -> list[dict]:
    d = cfg["distill"]
    min_s, min_p = int(d["min_sessions"]), int(d["min_projects"])
    ignore = [re.compile(x) for x in d.get("ignore", [])]
    raw = []
    for k, (ss, pp) in mined["seqs"].items():
        if len(ss) >= min_s and len(pp) >= min_p and not all(DISTILL_PLUMBING.match(s) for s in k):
            raw.append({"shapes": list(k), "sessions": ss, "projects": pp})
    for s, (ss, pp) in mined["shapes"].items():
        if len(ss) >= min_s and len(pp) >= min_p and not DISTILL_PLUMBING.match(s) and not s.startswith("git "):
            raw.append({"shapes": [s], "sessions": ss, "projects": pp})
    raw = [r for r in raw if not any(rx.search(" ".join(r["shapes"])) for rx in ignore)]
    raw.sort(key=lambda r: (-len(r["sessions"]), -len(r["shapes"])))
    # cluster: candidates seen in mostly the same sessions are one workflow
    groups, used = [], set()
    for r in raw:
        r["shapes"] = [x for x in r["shapes"] if x not in used]  # a command belongs to one workflow
        if not r["shapes"] or (len(r["shapes"]) == 1 and DISTILL_PLUMBING.match(r["shapes"][0])):
            continue
        used.update(r["shapes"])
        for g in groups:
            inter = len(g["sessions"] & r["sessions"])
            if (inter / max(1, len(g["sessions"] | r["sessions"])) >= 0.5 or set(r["shapes"]) <= set(g["shapes"])
                    or len(set(r["shapes"]) & set(g["shapes"])) >= 2):
                g["shapes"] += [s for s in r["shapes"] if s not in g["shapes"]]
                g["sessions"] |= r["sessions"]
                g["projects"] |= r["projects"]
                break
        else:
            groups.append({"shapes": list(r["shapes"]), "sessions": set(r["sessions"]), "projects": set(r["projects"])})
    corpus = bank_corpus()
    status = {r[0]: (r[1], r[2]) for r in c.execute("select fp, status, name from distill")}
    out = []
    for g in groups:
        if any(not x.startswith("git ") for x in g["shapes"]):  # plumbing that tags along is not the workflow
            g["shapes"] = [x for x in g["shapes"] if not DISTILL_PLUMBING.match(x)]
        g["shapes"] = g["shapes"][:8]
        fp = hashlib.sha1("\n".join(sorted(g["shapes"])).encode()).hexdigest()[:16]
        covered = next((n for n, text in corpus.items()
                        if text and all(shape_key(s) in text for s in g["shapes"])), "")
        st, nm = status.get(fp, ("", ""))
        out.append({"fp": fp, "shapes": g["shapes"], "sessions": len(g["sessions"]), "projects": sorted(g["projects"]),
                    "examples": [mined["examples"].get(s, s) for s in g["shapes"]],
                    "last": max(mined["last"].get(s, 0) for s in g["shapes"]),
                    "covered_by": covered, "status": st, "name": nm or distill_name(g["shapes"])})
    return out


def distill_name(shapes: list[str]) -> str:
    """A slug from the most specific shape: the one that is not git plumbing, with the most words."""
    pick = max(shapes, key=lambda s: (not s.startswith("git "), len(s.split())))
    words = [w.lstrip("-") for w in pick.split()][:2]
    base = re.sub(r"[^a-z0-9]+", "-", "-".join(words).lower()).strip("-")[:48] or "workflow"
    return base if base.endswith("-flow") or len(shapes) == 1 else base + "-flow"


def draft_skill(cfg, cand: dict) -> str:
    """SKILL.md for a candidate: from distill.draft_cmd (the bundled skills-gate-draft asks a local model) when it
    answers with front matter, else a plain template. Either way it is a draft until `distill accept`."""
    cmd = cfg["distill"].get("draft_cmd")
    if cmd:
        try:
            argv = [os.path.expanduser(x) for x in (cmd if isinstance(cmd, list) else cmd.split())]
            r = subprocess.run(argv, input=json.dumps(cand), capture_output=True, text=True,
                               timeout=int(cfg["distill"].get("draft_timeout", 600)))
            text = r.stdout.strip()
            m = re.search(r"^---\n.*?\n---\n", text, re.S | re.M)
            if m and "description:" in m.group(0):
                text = text[m.start():]
                text = re.sub(r"(?m)^name:.*$", f"name: {cand['name']}", text, count=1)
                return redact(text) + "\n"
        except (OSError, subprocess.TimeoutExpired):
            pass
    projects = ", ".join(cand["projects"][:6]) + (" and others" if len(cand["projects"]) > 6 else "")
    desc = (f"Recurring workflow from your own sessions: {'; '.join(cand['shapes'][:3])}. Use when doing this again "
            f"in {projects}.")
    steps = "\n".join(f"{i}. `{s}`\n   Example: `{ex}`" for i, (s, ex) in
                      enumerate(zip(cand["shapes"], cand["examples"]), 1))
    return (f"---\nname: {cand['name']}\ndescription: {json.dumps(desc)}\n---\n\n# {cand['name']}\n\n"
            f"Drafted by `skills-gate distill` on {day(now())} from {cand['sessions']} sessions across "
            f"{len(cand['projects'])} projects ({projects}). Edit it into a real playbook before you accept it: say "
            f"why each step runs and what a good result looks like.\n\n## Steps\n\n{steps}\n")


def distill_run(c, cfg, days: int | None = None, limit: int | None = None, dry: bool = False,
                quiet: bool = False) -> tuple[list, list]:
    d = cfg["distill"]
    cands = distill_candidates(c, cfg, mine_work(cfg, int(days or d["days"])))
    fresh = [x for x in cands if not x["status"] and not x["covered_by"]]
    made = []
    for cand in fresh[: int(d["max_drafts"] if limit is None else limit)]:
        name = cand["name"]
        while in_bank(name) or (DRAFTS / name).exists():
            name = re.sub(r"-(\d+)$", lambda m: f"-{int(m.group(1)) + 1}", name) if re.search(r"-\d+$", name) \
                else name + "-2"
        cand["name"] = name
        if dry:
            made.append(cand)
            continue
        dst = DRAFTS / name
        dst.mkdir(parents=True)
        (dst / "SKILL.md").write_text(draft_skill(cfg, cand))
        (dst / ".distill.json").write_text(json.dumps(cand, indent=1))
        c.execute("insert or replace into distill values (?,?,?,?,?)", (cand["fp"], name, "draft", now(),
                                                                       json.dumps(cand["shapes"])))
        event(c, name, "distill", f"{cand['sessions']} sessions, {len(cand['projects'])} projects")
        made.append(cand)
        if not quiet:
            say(f"[draft] {name}: {cand['sessions']} sessions, {len(cand['projects'])} projects -> {dst}")
    if not dry:
        meta_set(c, "distill_at", now())
    return cands, made


def cmd_distill(a):
    cfg = config()
    c = db()
    act = a.action or "run"
    if act == "run":
        cands, made = distill_run(c, cfg, a.days, a.limit, a.dry_run)
        c.commit()
        say(f"{'sessions':>8} {'projects':>8}  {'state':<16} workflow")
        for x in cands[: a.show]:
            state = x["status"] or (f"in {x['covered_by']}" if x["covered_by"] else
                                    "would draft" if a.dry_run and x in made else "new")
            say(f"{x['sessions']:>8} {len(x['projects']):>8}  {short(state, 16):<16} {' -> '.join(x['shapes'])[:110]}")
        if not cands:
            say(f"no workflow recurs in {cfg['distill']['min_sessions']}+ sessions and "
                f"{cfg['distill']['min_projects']}+ projects in the last {a.days or cfg['distill']['days']} days")
        say(f"{len(made)} draft(s) {'would be ' if a.dry_run else ''}written to {DRAFTS}"
            + ("; read one: skills-gate distill show NAME, then accept or reject it" if made else ""))
        return
    if act == "list":
        rows = c.execute("select name, status, at, shapes from distill order by at desc").fetchall()
        for r in rows:
            say(f"{r['name']:<36} {r['status']:<9} {day(r['at'])}  {' -> '.join(json.loads(r['shapes']))[:80]}")
        if not rows:
            say("no drafts yet; `skills-gate distill` mines your sessions for one")
        return
    if not a.name:
        die(f"distill {act} needs a draft name (skills-gate distill list)")
    row = c.execute("select * from distill where name=? and status='draft'", (a.name,)).fetchone()
    src = DRAFTS / a.name
    if not row or not (src / "SKILL.md").is_file():
        die(f"no open draft {a.name!r}; `skills-gate distill list`")
    if act == "show":
        say((src / "SKILL.md").read_text())
        say(f"<!-- {src}; edit it there, then: skills-gate distill accept {a.name} [--lane L] | reject {a.name} -->")
        return
    if act == "reject":
        c.execute("update distill set status='rejected', at=? where fp=?", (now(), row["fp"]))
        rm(src)
        c.commit()
        say(f"[reject] {a.name}: this workflow will not be proposed again")
        return
    rep = vet(c, cfg, src, a.name)
    if not rep["ok"]:
        c.commit()
        die(f"{a.name} did not pass vetting; fix the draft in {src} and accept again")
    staged = Path(tempfile.mkdtemp(prefix="sg-draft-")) / a.name
    shutil.copytree(src, staged, ignore=shutil.ignore_patterns(".distill.json", *SKIP_PARTS))
    name = register(c, staged, lane=a.lane, source=f"distill:{row['fp']}", kind="distill")
    rm(staged.parent)
    if not name:
        die(f"{a.name}: the draft's front matter has no usable name")
    if rep["review"]["verdict"] != "none":
        record_review(c, name, rep)
    c.execute("update distill set status='accepted', at=? where fp=?", (now(), row["fp"]))
    rm(src)
    write_registry(c, cfg)
    install_gate(cfg)
    c.commit()
    say(f"[accept] {name} is in the bank; `skills-gate push` (or the hourly sync) gives it to your other machines")


# ---------------------------------------------------------------------------------------------------- push / pull

SECRET_RX = re.compile(r"(^\.env(\..*)?$|\.pem$|\.key$|\.p12$|^id_(rsa|ed25519|ecdsa)|credentials|\.token$|"
                       r"^secrets?\.(json|ya?ml|toml)$)", re.I)


def sync_skip(f: Path, rel: Path) -> bool:
    try:
        return bool(SECRET_RX.search(f.name)) or f.stat().st_size > 10_000_000
    except OSError:
        return True


def sync_hash(p: Path) -> str:
    return tree_hash(p, skip=sync_skip)


def sync_git(args, check=True):
    r = git_run(args, cwd=SYNC)
    if check and r.returncode != 0:
        die(f"git {' '.join(args)} failed: {r.stderr.strip()[:300]}")
    return r


def cmd_remote(a):
    c = db()
    if not a.url:
        say(f"remote: {meta_get(c, 'remote') or 'none'}  (sync folder {SYNC})")
        return
    meta_set(c, "remote", a.url)
    c.commit()
    if not (SYNC / ".git").is_dir():
        SYNC.mkdir(parents=True, exist_ok=True)
        sync_git(["init", "-q", "-b", "main"])
        sync_git(["remote", "add", "origin", a.url])
    else:
        sync_git(["remote", "set-url", "origin", a.url])
    say(f"[remote] {a.url}; `skills-gate pull` then `skills-gate push`; rerun `skills-gate timer` to sync nightly")


def sync_fetch(c) -> dict:
    """Bring the sync folder to the remote's state and return its registry."""
    if not meta_get(c, "remote"):
        die("no remote set; run `skills-gate remote <git-url>` (a private repo you own)")
    if not (SYNC / ".git").is_dir():
        cmd_remote(argparse.Namespace(url=meta_get(c, "remote")))
    sync_git(["fetch", "-q", "origin"], check=False)
    if sync_git(["rev-parse", "-q", "--verify", "origin/main"], check=False).returncode == 0:
        sync_git(["checkout", "-q", "-f", "-B", "main", "origin/main"])  # the folder is only an export
        sync_git(["clean", "-q", "-fd"])
    reg = SYNC / "registry.json"
    return json.loads(reg.read_text()) if reg.is_file() else {"skills": {}, "presets": {}}


# Settings every peer shares. Paths (harness_dirs, usage_sources, ref_roots, project_dirs) stay per machine.
SHARED_CONFIG = ("always_on", "prune_days", "cold_days", "marketplace", "market_ttl_hours", "market", "trust",
                 "suggest", "ignore_agents", "distill", "update")


def peer_name(cfg: dict | None = None) -> str:
    return (cfg or config()).get("peer_name") or socket.gethostname().split(".")[0] or "peer"


def shared_get(c, ns: str) -> dict:
    """This machine's current value of one shared namespace, in the registry's shape."""
    if ns == "config":
        cfg = config()
        return {k: cfg[k] for k in SHARED_CONFIG if k in cfg}
    if ns == "net_allow":
        out = {}
        for r in c.execute("select skill, host from net_allow where by != 'global' order by skill, host"):
            out.setdefault(r[0], []).append(r[1])
        return out
    if ns == "presets":
        return {r[0]: sorted(r[1].split("\n")) for r in
                c.execute("select name, group_concat(skill, '\n') from presets group by name")}
    if ns == "attrs":
        return {r[0]: {"lane": r[1], "pinned": r[2]} for r in c.execute("select name, lane, pinned from skills")}
    if ns == "skips":  # upstream versions someone rolled back or dropped, so no peer applies them again
        out = {}
        for r in c.execute("select skill, hash from update_skip order by skill, hash"):
            out.setdefault(r[0], []).append(r[1])
        return out
    if ns == "distill":  # decisions on mined workflows, so no peer proposes what you already turned down
        return {r[0]: [r[1], r[2]] for r in
                c.execute("select fp, name, status from distill where status in ('accepted', 'rejected')")}
    raise KeyError(ns)


def shared_set(c, ns: str, key: str, value):
    if ns == "config":
        def put(u):
            if value is None:
                u.pop(key, None)
            else:
                u[key] = value
        edit_config(put)
    elif ns == "net_allow":
        want = set(value or [])
        have = {r[0] for r in c.execute("select host from net_allow where skill=? and by != 'global'", (key,))}
        for h in have - want:
            c.execute("delete from net_allow where skill=? and host=?", (key, h))
            event(c, key, "net-revoke", f"{h} (sync)")
        c.executemany("insert or ignore into net_allow values (?,?,?,?)",
                      [(key, h, now(), "sync") for h in sorted(want - have)])
    elif ns == "presets":
        c.execute("delete from presets where name=?", (key,))
        c.executemany("insert or ignore into presets values (?,?)",
                      [(key, s) for s in value or [] if in_bank(s)])
    elif ns == "distill" and value is not None:
        row = c.execute("select name, status from distill where fp=?", (key,)).fetchone()
        if row and row["status"] == "draft":
            rm(DRAFTS / row["name"])  # decided on a peer; this machine's draft of it is moot
        c.execute("insert into distill values (?,?,?,?,'[]') on conflict(fp) do update set status=excluded.status",
                  (key, value[0], value[1], now()))
    elif ns == "skips":
        c.executemany("insert or ignore into update_skip values (?,?,?)", [(key, h, now()) for h in value or []])
    elif ns == "attrs" and value is not None:
        c.execute("update skills set lane=?, pinned=? where name=?", (value["lane"], value["pinned"], key))


def sync_shared(c, reg: dict, spaces=("config", "net_allow", "presets", "attrs", "distill", "skips")) -> dict:
    """Three-way merge of the shared settings, approvals, presets and per-skill lane/pin, key by key: the side
    that changed since the last sync wins; when both changed, this machine keeps its own and says so. Before a
    first sync (no base) two lists merge as a union, and a value still at its default takes the peer's."""
    out = {}
    for ns in spaces:
        local, remote = shared_get(c, ns), reg.get(ns)
        if remote is None:  # a peer on an older version, or a fresh remote: nothing to take
            continue
        base = json.loads(meta_get(c, f"sync:{ns}") or "null")
        base_none = base is None
        base, newbase, clash = base or {}, dict(base or {}), []
        for k in sorted(set(local) | set(remote)):
            if ns == "attrs" and k not in local:
                continue  # a skill not here (yet): its lane and pin arrive with it
            l, r, b = local.get(k), remote.get(k), base.get(k)
            first = base_none or k not in base  # never synced, or a key that became shared since
            if l == r:
                v = l
            elif l == b:
                v = r
            elif r == b and not first:
                v = l
            elif first and (l is None or (ns == "config" and l == DEFAULT_CONFIG.get(k))):
                v = r
            elif first and isinstance(l, list) and isinstance(r, list):
                v = l + [x for x in r if x not in l]  # keep this side's order (marketplace order matters)
            elif first:
                v = l
            else:
                v = l
                clash.append(k)
            if v != l:
                shared_set(c, ns, k, v)
            if r is None:
                newbase.pop(k, None)
            else:
                newbase[k] = r  # what the remote holds; a value kept here reads as a local change next time
        meta_set(c, f"sync:{ns}", json.dumps(newbase, sort_keys=True))
        if clash:
            say(f"[keep]  {ns}: {', '.join(clash[:8])} changed here and on a peer; kept this machine's")
        out[ns] = clash
    peers = {k: v for k, v in reg.get("peers", {}).items() if k != peer_name()}
    meta_set(c, "peers", json.dumps(peers, sort_keys=True))
    return out


def fleet(c) -> tuple[dict, set, set]:
    """What the other peers last reported: last use per skill, and the skills they hold (referenced or pinned)."""
    peers = json.loads(meta_get(c, "peers") or "{}")
    last, held, pinned = {}, set(), set()
    for p in peers.values():
        for name, (_, ts) in p.get("usage", {}).items():
            last[name] = max(last.get(name, 0), ts or 0)
        held.update(p.get("held", []))
        pinned.update(p.get("pinned", []))
    return last, held, pinned


def peer_report(c, cfg) -> dict:
    return {"at": now(), "version": VERSION, "skills": c.execute("select count(*) from skills").fetchone()[0],
            "usage": {r[0]: [r[1], r[2] or 0] for r in
                      c.execute("select name, uses, last_used from skills where uses > 0 or last_used")},
            "held": sorted({r[0] for r in c.execute("select distinct skill from refs")}),
            "pinned": sorted({r[0] for r in c.execute("select name from skills where pinned=1")})}


def held_hash(q: Path) -> str:
    """A quarantine entry's content hash, without the vetting report it carries."""
    return tree_hash(q, skip=lambda f, rel: sync_skip(f, rel) or str(rel) == ".skills-gate-report.json")


def unquarantine_synced(name: str, h: str):
    """A skill admitted from the remote no longer needs the copies an older pull held back."""
    qroot = HOME / "quarantine"
    for q in qroot.glob(f"{name}-*") if qroot.is_dir() else ():
        if q.is_dir() and re.fullmatch(re.escape(name) + r"-\d{8}-\d{6}(-\d+)?", q.name) and held_hash(q) == h:
            rm(q)


def sync_merge(c, reg: dict, policy: str) -> dict:
    """Three-way merge per skill: base = the hash both sides had at the last sync."""
    sync_shared(c, reg, ("config", "net_allow"))  # settings and approvals first: vetting reads them
    base = {r[0]: r[1] for r in c.execute("select name, hash from sync_state")}
    local = {r["name"]: r for r in c.execute("select * from skills")}
    stats = {"new": 0, "took": 0, "kept": 0, "conflict": 0, "removed": 0, "held": 0}
    cfg = config()

    def admit(rdir: Path, name: str, meta: dict) -> bool:
        # A peer's bank is yours: the content scan still runs, but egress is not an admission gate here.
        # Approvals travel with the sync and `use` enforces them, so the skill behaves as it does on the peer.
        rep = vet(c, cfg, rdir, name, review=False, quiet=True, egress_gate=False)
        if rep["ok"]:
            unquarantine_synced(name, sync_hash(rdir))
            return True
        h = sync_hash(rdir)
        qroot = HOME / "quarantine"
        if any(held_hash(q) == h for q in (qroot.glob(f"{name}-*") if qroot.is_dir() else ())):
            stats["held"] += 1  # already held at this version; one copy is enough
            return False
        q = quarantine(rdir, name, rep, dict(meta, source=meta.get("source", "")))
        say(f"[held]  {name} from the remote failed vetting ({'; '.join(rep['blocks'])}); in {q}")
        stats["held"] += 1
        return False
    for name, info in reg.get("skills", {}).items():
        if not NAME_RX.match(name):
            continue
        rdir, hr, hb, row = SYNC / "skills" / name, info["hash"], base.get(name), local.get(name)
        meta = {"lane": info.get("lane"), "pinned": info.get("pinned", 0), "up_tree": info.get("up_tree", "")}
        have_copy = (rdir / "SKILL.md").is_file()
        if row is None:
            if hb is not None and hb == hr:
                continue  # removed here since the last sync; the push records the removal there too
            if hb is not None and policy != "theirs":
                if policy == "mine":
                    stats["kept"] += 1
                    continue
                if have_copy:  # removed here, changed there
                    dst = CONFLICTS / name
                    rm(dst)
                    CONFLICTS.mkdir(parents=True, exist_ok=True)
                    shutil.copytree(rdir, dst)
                say(f"[conflict] {name}: removed here, changed there; theirs saved in {CONFLICTS / name}"
                    f" (pull --theirs brings it back, --mine keeps it removed)")
                stats["conflict"] += 1
                continue
            ls = info.get("link_source")
            if ls and (Path(ls) / "SKILL.md").is_file():
                register(c, Path(ls), link=True, source=info.get("source", ""), kind="pull", meta=meta)
            elif have_copy:
                if not admit(rdir, name, dict(meta, source=info.get("source", ""))):
                    continue
                register(c, rdir, source=info.get("source", ""), kind="pull", meta=meta)
            else:
                warn(f"{name}: listed by the remote but its files are missing there; skipped")
                continue
            c.execute("insert or replace into sync_state values (?,?)", (name, hr))
            stats["new"] += 1
            continue
        hl = sync_hash(bank_path(name))
        if hl == hr:
            c.execute("insert or replace into sync_state values (?,?)", (name, hr))
            continue
        if row["link"]:
            say(f"[keep]  {name}: linked here, edits go through its source")
            stats["kept"] += 1
            continue
        if hb == hr or (policy == "mine" and hb != hl):
            stats["kept"] += 1  # only this side changed, or the user keeps theirs
            continue
        if not have_copy:
            warn(f"{name}: the remote's copy is missing; kept this one")
            stats["kept"] += 1
            continue
        if hb == hl or policy == "theirs":
            if not admit(rdir, name, dict(meta, source=info.get("source", row["source"]))):
                continue
            keep_copy(name, "pre-pull")
            register(c, rdir, force=True, source=info.get("source", row["source"]), kind="pull", meta=meta,
                     name=name)
            c.execute("insert or replace into sync_state values (?,?)", (name, hr))
            stats["took"] += 1
        else:
            dst = CONFLICTS / name
            rm(dst)
            CONFLICTS.mkdir(parents=True, exist_ok=True)
            shutil.copytree(rdir, dst)
            say(f"[conflict] {name}: changed here and there; theirs saved in {dst} (pull --theirs or --mine)")
            stats["conflict"] += 1
    # Only an explicit removal record removes a skill here: a skill merely missing from the remote (an empty
    # remote, a broken link on the machine that pushed) is left alone.
    for name in reg.get("removed", {}):
        if name in reg.get("skills", {}) or name not in local or local[name]["link"] or name not in base:
            continue
        if sync_hash(bank_path(name)) == base[name]:
            remove_skill(c, config(), name)
            c.execute("delete from sync_state where name=?", (name,))
            stats["removed"] += 1
        else:
            say(f"[keep]  {name}: removed on another machine, but edited here; kept (remove it to agree)")
    sync_shared(c, reg, ("presets", "attrs", "distill", "skips"))  # after the skills, so presets and lanes find their members
    return stats


def sync_export(c, remote: dict):
    """Write this bank into the sync folder on top of the remote's state: changed skills replaced, removals
    recorded as tombstones, and skills that are broken here (a moved link source) left as the remote had them."""
    skills_dir = SYNC / "skills"
    skills_dir.mkdir(parents=True, exist_ok=True)
    base = {r[0] for r in c.execute("select name from sync_state")}
    rows = {r["name"]: r for r in c.execute("select * from skills order by name").fetchall()}
    reg = {"version": 2, "skills": {}, "presets": {}, "removed": dict(remote.get("removed", {}))}
    for name, info in remote.get("skills", {}).items():
        if name in rows:
            continue
        if name in base:  # we had it and removed it: record that, drop the files
            reg["removed"][name] = now()
            rm(skills_dir / name)
            c.execute("delete from sync_state where name=?", (name,))
        else:  # never reached this bank (skipped, conflicted): keep the remote's entry
            reg["skills"][name] = info
    for name, r in rows.items():
        p = bank_path(name)
        if not (p / "SKILL.md").is_file():
            if name in remote.get("skills", {}):
                reg["skills"][name] = remote["skills"][name]
            warn(f"{name}: broken here ({p}); the remote keeps its copy")
            continue
        reg["removed"].pop(name, None)
        dst = skills_dir / name
        rm(dst)
        for f, rel in files_of(p):
            if sync_skip(f, rel):
                continue
            (dst / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(f, dst / rel)
        h = sync_hash(p)
        # a peer holding a copy keeps the linking peer's path, or the two would rewrite it on every push
        ls = str(p.resolve()) if r["link"] else remote.get("skills", {}).get(name, {}).get("link_source", "")
        reg["skills"][name] = {"lane": r["lane"], "description": r["description"], "source": r["source"],
                               "link_source": ls, "pinned": r["pinned"], "hash": h, "up_tree": r["up_tree"]}
        c.execute("insert or replace into sync_state values (?,?)", (name, h))
    reg["version"] = 3
    for ns in ("config", "net_allow", "presets", "attrs", "distill", "skips"):
        reg[ns] = shared_get(c, ns)
        meta_set(c, f"sync:{ns}", json.dumps(reg[ns], sort_keys=True))  # both sides now agree on this
    cfg = config()
    reg["peers"] = dict(remote.get("peers", {}))
    me, rep = peer_name(cfg), peer_report(c, cfg)
    prev = reg["peers"].get(me, {})
    if {k: v for k, v in prev.items() if k != "at"} == {k: v for k, v in rep.items() if k != "at"}:
        rep["at"] = prev.get("at", rep["at"])  # nothing new from this peer: no commit just to say so
    reg["peers"][me] = rep
    (SYNC / "registry.json").write_text(json.dumps(reg, indent=1, sort_keys=True) + "\n")


def cmd_pull(a):
    c = db()
    reg = sync_fetch(c)
    st = sync_merge(c, reg, "theirs" if a.theirs else "mine" if a.mine else "ask")
    write_registry(c, config())
    install_gate(config())
    c.commit()
    say("pull: " + ", ".join(f"{v} {k}" for k, v in st.items()))
    return st


def cmd_push(a):
    c = db()
    for attempt in range(3):  # another peer may push between our fetch and push: merge again on top of it
        reg = sync_fetch(c)
        st = sync_merge(c, reg, "theirs" if a.theirs else "mine" if a.mine else "ask")
        if st["conflict"]:
            c.commit()
            die(f"{st['conflict']} conflict(s); resolve with `skills-gate push --mine` or `pull --theirs`")
        sync_export(c, reg)
        write_registry(c, config())
        install_gate(config())
        c.commit()
        # --force: a skill's own .gitignore (fixtures, outputs) must not hide files the bank's hash counts,
        # or the peer never gets them and the two machines overwrite each other on every push
        sync_git(["add", "-A", "--force"])
        if sync_git(["diff", "--cached", "--quiet"], check=False).returncode == 0:
            say("push: nothing changed")
            return
        sync_git(["commit", "-q", "-m", f"skills-gate sync {peer_name()} {time.strftime('%Y-%m-%d %H:%M')}"])
        r = sync_git(["push", "-q", "origin", "HEAD:main"], check=False)
        if r.returncode == 0:
            break
        if attempt == 2:
            die(f"git push failed: {r.stderr.strip()[:300]}")
        say("push: the remote moved meanwhile; merging again")
    say(f"push: bank of {len(list((SYNC / 'skills').iterdir()))} skills sent to {meta_get(c, 'remote')}"
        f" (merged: {', '.join(f'{v} {k}' for k, v in st.items())})")


def cmd_join(a):
    """Make this machine a peer of a bank: init if needed, set the remote, take the fleet's bank and settings,
    report in. --all also gates the harness folders, writes the prompt hook and installs the nightly sync."""
    if not CONFIG.is_file():
        cmd_init(argparse.Namespace())
    cmd_remote(argparse.Namespace(url=a.url))
    cmd_pull(argparse.Namespace(theirs=False, mine=False))
    cmd_push(argparse.Namespace(theirs=False, mine=False))
    if a.all:
        cmd_gate(argparse.Namespace(dry_run=False))
        cmd_hook(argparse.Namespace(write=True, remove=False))
        cmd_timer(argparse.Namespace())
    else:
        say("next: `skills-gate gate`, `skills-gate hook --write`, `skills-gate timer` (or join again with --all)")
    cmd_peers(argparse.Namespace())


def cmd_peers(a):
    """Every machine on the bank, from the last sync (no network): when it synced, its version, its bank."""
    c = db()
    cfg = config()
    reg_p = SYNC / "registry.json"
    reg = json.loads(reg_p.read_text()) if reg_p.is_file() else {}
    me = peer_name(cfg)
    fleet_names = set(reg.get("skills", {}))
    here = {r[0] for r in c.execute("select name from skills")}
    say(f"{'peer':<16} {'last sync':<17} {'version':<8} {'skills':>6}  used")
    for name, p in sorted(reg.get("peers", {}).items()):
        say(f"{name + (' *' if name == me else ''):<16} "
            f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(p.get('at', 0))):<17} "
            f"{p.get('version', '?'):<8} {p.get('skills', 0):>6}  {len(p.get('usage', {}))}")
    if not reg.get("peers"):
        say("(no peers reported yet; `skills-gate push` reports this one)")
    missing, extra = sorted(fleet_names - here), sorted(here - fleet_names)
    qroot = HOME / "quarantine"
    held = sorted({q.name.rsplit("-", 2)[0] for q in qroot.iterdir()} if qroot.is_dir() else set())
    if missing:
        say(f"on the bank but not here ({len(missing)}): {', '.join(missing[:12])}"
            + (f"; held in quarantine: {', '.join(held[:8])}" if held else ""))
    if extra:
        say(f"here but not on the bank yet ({len(extra)}): {', '.join(extra[:12])} (push sends them)")
    if not missing and not extra and fleet_names:
        say(f"in step: this bank matches the remote ({len(here)} skills)")


# ---------------------------------------------------------------------------------------------------- agents

def cmd_agents(a):
    cfg = config()
    if a.action in (None, "list"):
        say(f"{'agent':<10} {'state':<10} {'skills':>6}  folder")
        ignored = set(cfg.get("ignore_agents", []))
        absent = []
        for name, info in KNOWN_AGENTS.items():
            if name in ignored:
                continue
            path = Path(cfg["harness_dirs"].get(name) or info["global"]).expanduser()
            gated = bool(cfg["harness_dirs"].get(name)) and path.is_dir()
            state = "gated" if gated else "detected" if Path(info["home"]).expanduser().is_dir() else "-"
            if state == "-" and not getattr(a, "all", False):
                absent.append(name)
                continue
            count = sum(1 for e in path.iterdir() if (e / "SKILL.md").is_file()) if path.is_dir() else 0
            note = f"  ({info['note']})" if info.get("note") else ""
            say(f"{name:<10} {state:<10} {count:>6}  {path}{note}")
        if absent:
            say(f"not on this machine ({len(absent)}, --all lists them): {', '.join(absent)}")
        for name, p in cfg["harness_dirs"].items():
            if name not in KNOWN_AGENTS and p:
                say(f"{name:<10} {'gated':<10} {'':>6}  {Path(p).expanduser()}  (custom)")
        say("\nadd one: skills-gate agents add <name> [--dir PATH], then `skills-gate gate`"
            + (f"; hidden: {', '.join(sorted(ignored))}" if ignored else ""))
        return
    if not a.name:
        die(f"agents {a.action} needs a name")
    if a.action == "add":
        info = KNOWN_AGENTS.get(a.name, {})
        path = a.dir or info.get("global")
        if not path:
            die(f"unknown agent {a.name!r}; pass --dir with its global skills folder")
        Path(path).expanduser().mkdir(parents=True, exist_ok=True)

        def add(u):
            u.setdefault("harness_dirs", {})[a.name] = path
            pd = u.setdefault("project_dirs", list(DEFAULT_CONFIG["project_dirs"]))
            if info.get("project") and info["project"] not in pd and not a.no_project:
                pd.append(info["project"])
            if info.get("sessions"):
                u.setdefault("usage_sources", {})[a.name] = info["sessions"]
        edit_config(add)
        say(f"[agent] {a.name} -> {path}; run `skills-gate gate` to move its skills behind the gate")
    elif a.action == "ignore":
        def ign(u):
            names = set(u.get("ignore_agents", [])) | {a.name}
            u["ignore_agents"] = sorted(names)
            if u.get("harness_dirs", {}).get(a.name):
                u["harness_dirs"][a.name] = ""
        edit_config(ign)
        say(f"[agent] {a.name} hidden from `agents` and never gated")
    elif a.action == "remove":
        edit_config(lambda u: u.setdefault("harness_dirs", {}).__setitem__(a.name, ""))
        say(f"[agent] {a.name} is no longer gated; its folder keeps what is there (`ungate` restores moved skills)")


# ---------------------------------------------------------------------------------------------------- mcp

MCP_TOOLS = [
    {"name": "skills_suggest", "description": "Rank the banked skills for a task. Start here when a task may need a "
     "skill you do not have loaded.", "inputSchema": {"type": "object", "properties": {
         "task": {"type": "string", "description": "the task in a sentence"}}, "required": ["task"]}},
    {"name": "skills_use", "description": "Return a banked skill's full playbook (SKILL.md) to follow now.",
     "inputSchema": {"type": "object", "properties": {"name": {"type": "string"}}, "required": ["name"]}},
    {"name": "skills_search", "description": "Search the bank by words; market=true searches online marketplaces "
     "(show results to the user; never install without their yes).", "inputSchema": {"type": "object", "properties": {
         "query": {"type": "string"}, "market": {"type": "boolean"}, "limit": {"type": "integer"}},
         "required": ["query"]}},
    {"name": "skills_lane", "description": "List the lanes, or the skills in one lane.",
     "inputSchema": {"type": "object", "properties": {"lane": {"type": "string"}}}},
    {"name": "skills_show", "description": "Registry entry for one skill: lane, source, size, uses, risk.",
     "inputSchema": {"type": "object", "properties": {"name": {"type": "string"}}, "required": ["name"]}},
    {"name": "skills_on", "description": "Keep skills loaded for a project folder (links them in).",
     "inputSchema": {"type": "object", "properties": {"names": {"type": "array", "items": {"type": "string"}},
                                                      "project": {"type": "string"}}, "required": ["names"]}},
    {"name": "skills_off", "description": "Unload skills from a project folder.",
     "inputSchema": {"type": "object", "properties": {"names": {"type": "array", "items": {"type": "string"}},
                                                      "project": {"type": "string"}}, "required": ["names"]}},
]


def run_captured(argv: list[str]) -> tuple[str, bool]:
    out, err = io.StringIO(), io.StringIO()
    ok = True
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        try:
            main(argv)
        except SystemExit as e:
            ok = e.code in (0, None)
    return (out.getvalue() + err.getvalue()).strip() or "(no output)", ok


def mcp_call(name: str, args: dict) -> tuple[str, bool]:
    proj = ["--project", args["project"]] if args.get("project") else []
    argv = {
        "skills_suggest": lambda: ["suggest", args["task"], "--all", "--limit", "5"],
        "skills_use": lambda: ["use", args["name"]],
        "skills_search": lambda: ["search", args["query"], "--limit", str(args.get("limit", 8))]
        + (["--market"] if args.get("market") else []),
        "skills_lane": lambda: ["lane"] + ([args["lane"]] if args.get("lane") else []),
        "skills_show": lambda: ["show", args["name"]],
        "skills_on": lambda: ["on", *args["names"], *proj],
        "skills_off": lambda: ["off", *args["names"], *proj],
    }.get(name)
    if argv is None:
        return f"unknown tool {name}", False
    try:
        return run_captured(argv())
    except KeyError as e:
        return f"missing argument {e}", False


def cmd_mcp(a):
    """A stdio MCP server (newline-delimited JSON-RPC) for harnesses without a shell. No model, no GPU."""
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        mid, method, params = msg.get("id"), msg.get("method", ""), msg.get("params") or {}
        if mid is None:
            continue  # notification
        if method == "initialize":
            res = {"protocolVersion": params.get("protocolVersion", "2025-06-18"), "capabilities": {"tools": {}},
                   "serverInfo": {"name": "skills-gate", "version": VERSION},
                   "instructions": "Every skill on this machine waits in a bank. Call skills_suggest with the task, "
                                   "then skills_use to read the playbook you need."}
        elif method == "tools/list":
            res = {"tools": MCP_TOOLS}
        elif method == "tools/call":
            text, ok = mcp_call(params.get("name", ""), params.get("arguments") or {})
            res = {"content": [{"type": "text", "text": text}], "isError": not ok}
        elif method == "ping":
            res = {}
        else:
            sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": mid, "error": {"code": -32601,
                                         "message": f"method not found: {method}"}}) + "\n")
            sys.stdout.flush()
            continue
        sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": mid, "result": res}) + "\n")
        sys.stdout.flush()


# ---------------------------------------------------------------------------------------------------- cli

def main(argv=None):
    ap = argparse.ArgumentParser(prog="skills-gate", description=__doc__.split("\n")[0])
    ap.add_argument("--version", action="version", version=VERSION)
    sp = ap.add_subparsers(dest="cmd", required=True)

    sp.add_parser("init", help="create ~/.skills-gate and put the gate skill in every harness").set_defaults(f=cmd_init)
    p = sp.add_parser("add", help="install skills from a folder, a .zip or .skill archive, a git URL or"
                                  " owner/repo[/path][:skill][@ref]")
    p.add_argument("source")
    p.add_argument("--lane")
    p.add_argument("--only", nargs="*", help="only these skill names from a multi-skill source")
    p.add_argument("--link", action="store_true", help="link a local folder instead of copying it")
    p.add_argument("--force", action="store_true", help="replace a skill already in the bank")
    p.add_argument("--yes", action="store_true", help="the user agreed to this remote install")
    p.add_argument("--allow-risky", action="store_true", help="install even with high-risk scan findings")
    p.add_argument("--allow-net", action="store_true", help="approve the external hosts this skill calls")
    p.set_defaults(f=cmd_add)
    p = sp.add_parser("adopt", help="import every skill found in existing skill folders")
    p.add_argument("paths", nargs="+")
    p.add_argument("--lane")
    p.add_argument("--copy", action="store_true", help="copy symlinked skills instead of keeping the link")
    p.add_argument("--force", action="store_true")
    p.set_defaults(f=cmd_adopt)
    p = sp.add_parser("gate", help="move all skills out of the harness folders behind the gate")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(f=cmd_gate)
    p = sp.add_parser("ungate", help="restore everything `gate` moved")
    p.add_argument("--remove-gate", action="store_true")
    p.set_defaults(f=cmd_ungate)
    p = sp.add_parser("lane", help="list lanes, or the skills in one lane")
    p.add_argument("name", nargs="?")
    p.set_defaults(f=cmd_lane)
    p = sp.add_parser("set-lane", help="move skills to a lane")
    p.add_argument("lane")
    p.add_argument("skills", nargs="+")
    p.set_defaults(f=cmd_set_lane)
    p = sp.add_parser("suggest", help="the banked skills that fit a task, ranked (--hook: Claude Code prompt hook)")
    p.add_argument("task", nargs="?", default="")
    p.add_argument("--limit", type=int, default=3)
    p.add_argument("--all", action="store_true", help="show the top matches even below the confidence bar")
    p.add_argument("--json", action="store_true")
    p.add_argument("--hook", action="store_true", help="read a UserPromptSubmit payload on stdin; never fails")
    p.set_defaults(f=cmd_suggest)
    p = sp.add_parser("hook", help="print, --write or --remove the Claude Code prompt hook that runs suggest")
    p.add_argument("--settings", default="~/.claude/settings.json")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--write", action="store_true")
    g.add_argument("--remove", action="store_true")
    p.set_defaults(f=cmd_hook)
    p = sp.add_parser("search", help="search the bank, or the marketplaces with --market")
    p.add_argument("query")
    p.add_argument("--market", action="store_true")
    p.add_argument("--offline", action="store_true", help="live market results from the query cache only")
    p.add_argument("--live", action="store_true", help="ask the marketplaces now instead of the local catalog")
    p.add_argument("--all", action="store_true", help="include catalog entries that failed validation")
    p.add_argument("--limit", type=int, default=8)
    p.add_argument("--json", action="store_true")
    p.set_defaults(f=cmd_search)
    p = sp.add_parser("market", help="the local catalog: refresh | new | show ID | validate IDS | stats")
    p.add_argument("action", nargs="?", default="stats", choices=["refresh", "new", "show", "validate", "stats"])
    p.add_argument("ids", nargs="*")
    p.add_argument("--budget", type=int, help="skills to validate this run (default: market.budget)")
    p.add_argument("--no-gather", action="store_true", help="validate only; skip reading the sources")
    p.add_argument("--days", type=int, default=1)
    p.add_argument("--limit", type=int, default=30)
    p.add_argument("--all", action="store_true", help="include entries that failed validation")
    p.set_defaults(f=cmd_market)
    p = sp.add_parser("net", help="egress: list skills that call out | allow SKILL [HOSTS] | revoke SKILL [HOSTS] | hosts")
    p.add_argument("action", nargs="?", choices=["list", "allow", "revoke", "hosts"])
    p.add_argument("skill", nargs="?")
    p.add_argument("hosts", nargs="*")
    p.add_argument("--all", action="store_true", help="also list skills whose egress is approved")
    p.set_defaults(f=cmd_net)
    p = sp.add_parser("review", help="vet bank skills again: scan, egress, reviewer; records the result")
    p.add_argument("skills", nargs="*")
    p.add_argument("--all", action="store_true")
    p.add_argument("--pending", action="store_true", help="skills whose reviewer could not run last time")
    p.add_argument("--changed", action="store_true", help="skills changed since their last review")
    p.add_argument("--static", action="store_true", help="scan and egress only, skip the reviewer")
    p.add_argument("--quiet", action="store_true")
    p.set_defaults(f=cmd_review)
    p = sp.add_parser("quarantine", help="skills and updates held back by vetting: list | show ENTRY |"
                                         " release ENTRY [--allow-net] | rm ENTRY")
    p.add_argument("action", nargs="?", choices=["list", "show", "release", "rm"])
    p.add_argument("entries", nargs="*")
    p.add_argument("--all", action="store_true")
    p.add_argument("--allow-net", action="store_true")
    p.add_argument("--allow-risky", action="store_true")
    p.set_defaults(f=cmd_quarantine)
    p = sp.add_parser("use", help="print a skill's playbook into the session (on demand)")
    p.add_argument("skill")
    p.set_defaults(f=cmd_use)
    p = sp.add_parser("show", help="registry entry for a skill")
    p.add_argument("skill")
    p.add_argument("--json", action="store_true")
    p.set_defaults(f=cmd_show)
    for name, fn, hlp in (("on", cmd_on, "load skills for this project (or --global)"),
                          ("off", cmd_off, "unload skills from this project (or --global)")):
        p = sp.add_parser(name, help=hlp)
        p.add_argument("skills", nargs="*")
        p.add_argument("--lane", action="append", help="every skill in a lane")
        p.add_argument("--preset", action="append", help="every skill in a preset")
        p.add_argument("--global", dest="glob", action="store_true")
        p.add_argument("--project", help="project folder (default: the git root of the current folder)")
        p.add_argument("--save", action="store_true", help=f"also record it in the project's {MANIFEST}")
        p.set_defaults(f=fn)
    p = sp.add_parser("preset", help="named skill sets: list | show NAME | save NAME SKILLS | add NAME SKILLS | rm NAME")
    p.add_argument("action", nargs="?", choices=["list", "show", "save", "add", "rm"])
    p.add_argument("name", nargs="?")
    p.add_argument("skills", nargs="*")
    p.set_defaults(f=cmd_preset)
    p = sp.add_parser("project", help=f"the project's {MANIFEST}: show | save (from what is on) | sync (install + on)")
    p.add_argument("action", choices=["show", "save", "sync"])
    p.add_argument("--project")
    p.add_argument("--yes", action="store_true", help="the user agreed to installing missing skills")
    p.add_argument("--allow-risky", action="store_true")
    p.set_defaults(f=cmd_project)
    p = sp.add_parser("pin", help="never prune these skills")
    p.add_argument("skills", nargs="+")
    p.set_defaults(f=lambda a: cmd_pin(a, 1))
    p = sp.add_parser("unpin", help="let these skills be pruned again")
    p.add_argument("skills", nargs="+")
    p.set_defaults(f=lambda a: cmd_pin(a, 0))
    p = sp.add_parser("remove", help="move skills from the bank to cold storage")
    p.add_argument("skills", nargs="+")
    p.add_argument("--force", action="store_true", help="even when something references it")
    p.set_defaults(f=cmd_remove)
    p = sp.add_parser("tidy", help="daily pass: usage, references, stale toggles off, cold storage, registry, leaks")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--fix", action="store_true", help="re-gate skills that bypassed the gate")
    p.add_argument("--no-updates", dest="updates", action="store_false", help="skip the upstream update pass")
    p.set_defaults(f=cmd_tidy)
    p = sp.add_parser("harvest", help="count skill loads in every harness's session logs now")
    p.add_argument("--reset", action="store_true", help="forget harvested counts and count every log again")
    p.set_defaults(f=cmd_harvest)
    p = sp.add_parser("reindex", help="re-read every bank skill (description, size, keywords, hash)")
    p.add_argument("--relane", action="store_true", help="re-guess lanes for skills still in 'general'")
    p.set_defaults(f=cmd_reindex)
    p = sp.add_parser("scan", help="static install checks on a bank skill or a folder")
    p.add_argument("target")
    p.add_argument("--limit", type=int, default=40)
    p.add_argument("--json", action="store_true")
    p.set_defaults(f=cmd_scan)
    sp.add_parser("audit", help="scan the whole bank and record each skill's risk").set_defaults(f=cmd_audit)
    p = sp.add_parser("outdated", help="which skills have upstream changes or local edits")
    p.add_argument("skills", nargs="*")
    p.add_argument("--all", action="store_true", help="list current skills too")
    p.add_argument("--json", action="store_true")
    p.set_defaults(f=cmd_outdated)
    p = sp.add_parser("diff", help="bank copy against upstream")
    p.add_argument("skill")
    p.set_defaults(f=cmd_diff)
    p = sp.add_parser("update", help="take upstream changes (scanned, old copy kept in cold/)")
    p.add_argument("skills", nargs="*")
    p.add_argument("--all", action="store_true")
    p.add_argument("--yes", action="store_true")
    p.add_argument("--force", action="store_true", help="overwrite local edits")
    p.add_argument("--allow-risky", action="store_true")
    p.add_argument("--allow-net", action="store_true", help="approve the external hosts the new version calls")
    p.set_defaults(f=cmd_update)
    p = sp.add_parser("rollback", help="put back a skill's copy from before its last update; skip that version")
    p.add_argument("skill")
    p.set_defaults(f=cmd_rollback)
    p = sp.add_parser("remote", help="show or set the git remote the bank syncs through")
    p.add_argument("url", nargs="?")
    p.set_defaults(f=cmd_remote)
    for name, fn, hlp in (("pull", cmd_pull, "merge the remote bank into this one"),
                          ("push", cmd_push, "merge, then send this bank to the remote")):
        p = sp.add_parser(name, help=hlp)
        g = p.add_mutually_exclusive_group()
        g.add_argument("--theirs", action="store_true", help="on a conflict, take the remote copy")
        g.add_argument("--mine", action="store_true", help="on a conflict, keep this machine's copy")
        p.set_defaults(f=fn)
    p = sp.add_parser("distill", help="turn workflows you repeat across projects into skill drafts: "
                                      "run | list | show NAME | accept NAME | reject NAME")
    p.add_argument("action", nargs="?", choices=["run", "list", "show", "accept", "reject"])
    p.add_argument("name", nargs="?")
    p.add_argument("--days", type=int, help="window of session logs to mine (default distill.days)")
    p.add_argument("--limit", type=int, help="drafts to write this run (default distill.max_drafts)")
    p.add_argument("--show", type=int, default=15, help="candidates to list")
    p.add_argument("--lane", help="lane for an accepted draft (default: guessed)")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(f=cmd_distill)
    p = sp.add_parser("join", help="make this machine a peer of a bank: init, remote, pull, report in")
    p.add_argument("url")
    p.add_argument("--all", action="store_true", help="also gate, write the prompt hook and install the timers")
    p.set_defaults(f=cmd_join)
    sp.add_parser("peers", help="every machine on the bank and whether this one is in step").set_defaults(f=cmd_peers)
    p = sp.add_parser("agents", help="known harnesses: list | add NAME [--dir] | remove NAME | ignore NAME")
    p.add_argument("action", nargs="?", choices=["list", "add", "remove", "ignore"])
    p.add_argument("name", nargs="?")
    p.add_argument("--dir")
    p.add_argument("--no-project", action="store_true", help="do not add its project folder to project_dirs")
    p.add_argument("--all", action="store_true", help="list known harnesses that are not on this machine too")
    p.set_defaults(f=cmd_agents)
    p = sp.add_parser("stats", help="usage by harness, top skills, cold candidates, suggestion hit rate")
    p.add_argument("--days", type=int, default=30)
    p.add_argument("--limit", type=int, default=10)
    p.set_defaults(f=cmd_stats)
    p = sp.add_parser("bench", help="measure the ranker on a JSONL file of {prompt, expect}")
    p.add_argument("file")
    p.add_argument("-k", type=int, default=3)
    p.add_argument("--show", type=int, default=10)
    p.set_defaults(f=cmd_bench)
    sp.add_parser("mcp", help="serve search/suggest/use over MCP (stdio)").set_defaults(f=cmd_mcp)
    sp.add_parser("status", help="what is on, where, and what it costs").set_defaults(f=cmd_status)
    sp.add_parser("doctor", help="check the gate links and the bank").set_defaults(f=cmd_doctor)
    sp.add_parser("migrate", help="run the idempotent schema migration").set_defaults(f=cmd_migrate)
    sp.add_parser("timer", help="install the daily tidy (systemd user timer or a cron line)").set_defaults(f=cmd_timer)
    a = ap.parse_args(argv)
    a.f(a)


if __name__ == "__main__":
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # `skills-gate lane | head` ends quietly
    main()
